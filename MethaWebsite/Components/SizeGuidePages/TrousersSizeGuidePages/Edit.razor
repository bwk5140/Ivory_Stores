@page "/trouserssizeguides/edit"
@using MethaWebsite.Data.Contexts
@using MethaWebsite.Data.SizeGuides
@using Microsoft.EntityFrameworkCore

@inject IStringLocalizer<SharedResource> Loc
@inject IDbContextFactory<MethaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

@rendermode InteractiveServer

<PageTitle>Edit</PageTitle>

<div class="container-sm mt-5">
    @if (TrousersSizeGuide is null)
    {
        <div class="spinner-border" role="status">   <span class="visually-hidden">Loading...</span> </div>
    }
    else
    {
        <div class="toast-container p-3" data-bs-autohide="true" data-bs-delay="5000">
            <div class="toast show" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="toast-header">
                    <strong class="me-auto">@Loc["EditTrouserSizeChart"]</strong>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="Close"></button>
                </div>
                <div class="toast-body">
                    <EditForm method="post" Model="TrousersSizeGuide" OnValidSubmit="UpdateTrousersSizeGuide" FormName="edit" Enhance>
                        <DataAnnotationsValidator />
                        <ValidationSummary role="alert" />
                        <input type="hidden" name="TrousersSizeGuide.Id" value="@TrousersSizeGuide.Id" />
                        <div class="form form-floating mb-3">
                            <InputNumber id="seatsize" @bind-Value="TrousersSizeGuide.SeatSize" class="form-control" />
                            <label for="seatsize" class="form-label">@Loc["Seat"] (cm):</label>
                            <ValidationMessage For="() => TrousersSizeGuide.SeatSize" class="text-danger" />
                        </div>
                        <div class="form form-floating mb-3">
                            <InputNumber id="inseamlength" @bind-Value="TrousersSizeGuide.InSeamLength" class="form-control" />
                            <label for="inseamlength" class="form-label">@Loc["Inseam"] (cm):</label>
                            <ValidationMessage For="() => TrousersSizeGuide.InSeamLength" class="text-danger" />
                        </div>
                        <div class="form form-floating mb-3">
                            <InputText id="brandsize" @bind-Value="TrousersSizeGuide.BrandSize" class="form-control" placeholder="" />
                            <label for="brandsize" class="form-label">@Loc["BrandSize"]:</label>
                            <ValidationMessage For="() => TrousersSizeGuide.BrandSize" class="text-danger" />
                        </div>
                        <div class="form form-floating mb-3">
                            <InputNumber id="waistsize" @bind-Value="TrousersSizeGuide.WaistSize" class="form-control" />
                            <label for="waistsize" class="form-label">@Loc["Waist"] (cm):</label>
                            <ValidationMessage For="() => TrousersSizeGuide.WaistSize" class="text-danger" />
                        </div>
                        <div class="form form-floating mb-3">
                            <InputNumber id="hipsize" @bind-Value="TrousersSizeGuide.HipSize" class="form-control" />
                            <label for="hipsize" class="form-label">@Loc["Hip"] (cm):</label>
                            <ValidationMessage For="() => TrousersSizeGuide.HipSize" class="text-danger" />
                        </div>
                        <div class="form form-floating mb-3">
                            <InputNumber id="length" @bind-Value="TrousersSizeGuide.Length" class="form-control" />
                            <label for="length" class="form-label">@Loc["Length"] (cm):</label>
                            <ValidationMessage For="() => TrousersSizeGuide.Length" class="text-danger" />
                        </div>
                        <div style="text-align: right;">
                            <button type="submit" class="btn btn-primary" style="background-color: #2f4f4f;
                                    border-color:transparent; border-radius: 5px;">
                                Save
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery]
    private string? Id { get; set; }

    [SupplyParameterFromForm]
    private TrousersSizeGuide? TrousersSizeGuide { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        TrousersSizeGuide ??= await context.TrousersSizeGuide.FirstOrDefaultAsync(m => m.Id == Id);

        if (TrousersSizeGuide is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateTrousersSizeGuide()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        context.Attach(TrousersSizeGuide!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!TrousersSizeGuideExists(TrousersSizeGuide!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/trouserssizeguides");
    }
    private void Close()
    {
        NavigationManager.NavigateTo("/trouserssizeguides");
    }
    private bool TrousersSizeGuideExists(string id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.TrousersSizeGuide.Any(e => e.Id == id);
    }
}
