@using System.Globalization
@using MethaWebsite.Data
@using MethaWebsite.Data.Contexts
@using MethaWebsite.Data.SizeGuides
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore

@inject IStringLocalizer<SharedResource> Loc
@inject IDbContextFactory<MethaWebsite.Data.Contexts.ApplicationDbContext> DbFactory

@implements IAsyncDisposable


<div class="container-sm">
    @{
        var showClass = IsVisible ? "d-block" : "d-none";
    }
    <div class="toast-container p-3 @showClass" data-bs-autohide="true" data-bs-delay="5000">
        <div class="toast show" role="alert" aria-live="assertive" aria-atomic="true"
             style="min-width:fit-content; word-wrap:normal; background-color: white;">
            <div class="toast-header">
                <strong class="me-auto">@Loc["TrousersSizeGuide"]</strong>
                <button type="button" class="btn-close" data-bs-toggle="tooltip" title=@Loc["Cancel"]
                        aria-label="Close" @onclick="Close"></button>
            </div>
            <div class="toast-body m-3" style="background-color: white;">
                <table class="table border">
                    <thead>
                        <tr>
                            <th scope="col">@Loc["BrandSize"]</th>
                            @if (!emptySeatColumn)
                            {
                                <th scope="col">@Loc["Seat"] (cm)</th>
                            }
                            @if (!emptyWaistColumn)
                            {
                                <th scope="col">@Loc["Waist"] (cm)</th>
                            }
                            @if (!emptyHipColumn)
                            {
                                <th scope="col">@Loc["Hip"] (cm)</th>
                            }
                            @if (!emptyInseamColumn)
                            {
                                <th scope="col">@Loc["Inseam"] (cm)</th>
                            }
                            @if (!emptyLengthColumn)
                            {
                                <th scope="col">@Loc["Length"] (cm)</th>
                            }
                        </tr>
                    </thead>
                    <tbody class="card-body">
                        @if (trousersSizeGuides is not null)
                        {
                            @foreach (var trouserSizeGuide in trousersSizeGuides)
                            {
                                <tr>
                                    <td><strong>@trouserSizeGuide.BrandSize</strong></td>
                                    @if (!emptySeatColumn)
                                    {
                                        <td>@trouserSizeGuide.SeatSize</td>
                                    }
                                    @if (!emptyInseamColumn)
                                    {
                                        <td>@trouserSizeGuide.InSeamLength</td>
                                    }
                                    @if (!emptyWaistColumn)
                                    {
                                        <td>@trouserSizeGuide.WaistSize</td>
                                    }
                                    @if (!emptyHipColumn)
                                    {
                                        <td>@trouserSizeGuide.HipSize</td>
                                    }
                                    @if (!emptyLengthColumn)
                                    {
                                        <td>@trouserSizeGuide.Length</td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="@showClass darker-background"></div>
</div>

@code {
    private ApplicationDbContext context = default!;

    [CascadingParameter]
    private ProductGroup? ProductGroup { get; set; }

    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public List<TrousersSizeGuide>? trousersSizeGuides { get; set; } = new List<TrousersSizeGuide>();

    [Parameter]
    public bool emptySeatColumn { get; set; } = false;

    [Parameter]
    public bool emptyInseamColumn { get; set; } = false;

    [Parameter]
    public bool emptyWaistColumn { get; set; } = false;

    [Parameter]
    public bool emptyHipColumn { get; set; } = false;

    [Parameter]
    public bool emptyLengthColumn { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {
        context = await DbFactory.CreateDbContextAsync();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();

    public void Show()
    {
        IsVisible = true;
        Update();
        StateHasChanged();
    }
    public async Task Update()
    {
        if (ProductGroup is not null && ProductGroup.ProductColorGroups is not null)
        {
            foreach (var productColorGroup in ProductGroup.ProductColorGroups)
            {
                foreach (var product in productColorGroup.Products)
                {
                    var trouserSizeGuides = context.TrousersSizeGuide.Where(m => m.ProductId == product!.Id);
                    if (trouserSizeGuides is not null)
                    {
                        foreach (var trouserSizeGuide in trouserSizeGuides)
                        {
                            if (!trousersSizeGuides.Contains(trouserSizeGuide))
                            {
                                trousersSizeGuides.Add(trouserSizeGuide);
                            }
                        }
                    }
                }
            }
        }
        var SeatColumnGuides = trousersSizeGuides.Where(s => s.SeatSize != null).ToList();
        var InseamColumnGuides = trousersSizeGuides.Where(s => s.InSeamLength != null).ToList();
        var WaistColumnGuides = trousersSizeGuides.Where(s => s.WaistSize != null).ToList();
        var HipColumnGuides = trousersSizeGuides.Where(s => s.HipSize != null).ToList();
        var LengthColumnGuides = trousersSizeGuides.Where(s => s.Length != null).ToList();
        emptySeatColumn = SeatColumnGuides.Any() ? false : true;
        emptyInseamColumn = InseamColumnGuides.Any() ? false : true;
        emptyWaistColumn = WaistColumnGuides.Any() ? false : true;
        emptyHipColumn = HipColumnGuides.Any() ? false : true;
        emptyLengthColumn = LengthColumnGuides.Any() ? false : true;
        trousersSizeGuides = trousersSizeGuides.OrderBy(s => s.Created).ToList();
    }
    public void Close()
    {
        IsVisible = false;
        trousersSizeGuides.Clear();
        StateHasChanged();
    }
}
