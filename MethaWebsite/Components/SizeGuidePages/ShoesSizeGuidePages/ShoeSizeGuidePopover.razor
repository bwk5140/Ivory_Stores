@using System.Globalization
@using MethaWebsite.Data
@using MethaWebsite.Data.Contexts
@using MethaWebsite.Data.SizeGuides
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore

@inject IStringLocalizer<SharedResource> Loc
@inject IDbContextFactory<MethaWebsite.Data.Contexts.ApplicationDbContext> DbFactory

@implements IAsyncDisposable


<div class="container-sm">
    @{
        var showClass = IsVisible ? "d-block" : "d-none";
    }
    <div class="toast-container p-3 @showClass" data-bs-autohide="true" data-bs-delay="5000">
        <div class="toast show" role="alert" aria-live="assertive" aria-atomic="true"
             style="min-width:fit-content; max-height: 600px; word-wrap:normal; 
                background-color: white; overflow-y: auto;">
            <div class="toast-header">
                <strong class="me-auto">@Loc["ShoesSizeGuide"]</strong>
                <button type="button" class="btn-close" data-bs-toggle="tooltip" title=@Loc["Cancel"]
                        aria-label="Close" @onclick="Close"></button>
            </div>
            <div class="toast-body m-3" style="background-color: white;">
                <table class="table border">
                    <thead>
                        <tr>
                            <th scope="col">@Loc["BrandSize"]</th>
                            @if (!emptyUKSizeColumn)
                            {
                                <th scope="col">@Loc["UKSize"]</th>
                            }
                            @if (!emptyUSSizeColumn)
                            {
                                <th scope="col">@Loc["USSize"]</th>
                            }
                            @if (!emptyEUSizeColumn)
                            {
                                <th scope="col">@Loc["EUSize"]</th>
                            }
                        </tr>
                    </thead>
                    <tbody class="card-body">
                        @if (shoesSizeGuides is not null)
                        {
                            @foreach (var shoesSizeGuide in shoesSizeGuides)
                            {
                                <tr>
                                    <td><strong>@shoesSizeGuide.BrandSize</strong></td>
                                    @if (!emptyUKSizeColumn)
                                    {
                                        <td>@shoesSizeGuide.UK_Size</td>
                                    }
                                    @if (!emptyUSSizeColumn)
                                    {
                                        <td>@shoesSizeGuide.US_Size</td>
                                    }
                                    @if (!emptyEUSizeColumn)
                                    {
                                        <td>@shoesSizeGuide.EU_Size</td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="@showClass darker-background"></div>
</div>

@code {
    private ApplicationDbContext context = default!;

    [CascadingParameter]
    private ProductGroup? ProductGroup { get; set; }

    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public List<ShoesSizeGuide>? shoesSizeGuides { get; set; } = new List<ShoesSizeGuide>();

    [Parameter]
    public bool emptyEUSizeColumn { get; set; } = false;

    [Parameter]
    public bool emptyUSSizeColumn { get; set; } = false;

    [Parameter]
    public bool emptyUKSizeColumn { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {
        context = await DbFactory.CreateDbContextAsync();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();

    public void Show()
    {
        IsVisible = true;
        Update();
        StateHasChanged();
    }
    public async Task Update()
    {
        if (ProductGroup is not null && ProductGroup.ProductColorGroups is not null)
        {
            foreach (var productColorGroup in ProductGroup.ProductColorGroups)
            {
                foreach (var product in productColorGroup.Products)
                {
                    var shoeSizeGuides = context.ShoesSizeGuide.Where(m => m.ProductId == product!.Id);
                    if (shoeSizeGuides is not null)
                    {
                        foreach (var shoeSizeGuide in shoeSizeGuides)
                        {
                            if (!shoesSizeGuides.Contains(shoeSizeGuide))
                            {
                                shoesSizeGuides.Add(shoeSizeGuide);
                            }
                        }
                    }
                }
            }
        }
        var EUsizeGuides = shoesSizeGuides.Where(s => s.EU_Size != null).ToList();
        var UKsizeGuides = shoesSizeGuides.Where(s => s.UK_Size != null).ToList();
        var USsizeGuides = shoesSizeGuides.Where(s => s.US_Size != null).ToList();
        emptyEUSizeColumn = EUsizeGuides.Any() ? false : true;
        emptyUSSizeColumn = USsizeGuides.Any() ? false : true;
        emptyUKSizeColumn = UKsizeGuides.Any() ? false : true;
        shoesSizeGuides = shoesSizeGuides.OrderBy(s => s.Created).ToList();
    }
    public void Close()
    {
        IsVisible = false;
        StateHasChanged();
    }
}
