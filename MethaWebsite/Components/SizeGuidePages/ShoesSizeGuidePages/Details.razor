@page "/shoessizeguides/details"
@using MethaWebsite.Data.Contexts
@using MethaWebsite.Data.SizeGuides
@using Microsoft.EntityFrameworkCore

@inject IStringLocalizer<SharedResource> Loc
@inject IDbContextFactory<MethaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

@rendermode InteractiveServer

<PageTitle>Details</PageTitle>

<div class="container-sm mt-5">
    @if (shoessizeguide is null)
    {
        <div class="card" style="z-index: 1400;  max-width: 70px;"><div class="card-body"><div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span> </div></div></div>
    }
    else
    {
        <div class="toast-container p-3" data-bs-autohide="true" data-bs-delay="5000">
            <div class="toast show" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="toast-header">
                    <strong class="me-auto">@Loc["ShoesSizeChartDetails"]</strong>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="Close"></button>
                </div>
                <div class="toast-body">
                    <dl class="row">
                        <dt class="col-sm-4">@Loc["BrandSize"]:</dt>
                        <dd class="col-sm-6">@shoessizeguide.BrandSize</dd>
                    </dl>
                    <dl class="row">
                        <dt class="col-sm-4">@Loc["UKSize"]:</dt>
                        <dd class="col-sm-6">@shoessizeguide.UK_Size</dd>
                    </dl>
                    <dl class="row">
                        <dt class="col-sm-4">@Loc["USSize"]:</dt>
                        <dd class="col-sm-6">@shoessizeguide.US_Size</dd>
                    </dl>
                    <dl class="row">
                        <dt class="col-sm-4">@Loc["EUSize"]:</dt>
                        <dd class="col-sm-6">@shoessizeguide.EU_Size</dd>
                    </dl>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private ShoesSizeGuide? shoessizeguide;

    [SupplyParameterFromQuery]
    private string? Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        shoessizeguide = await context.ShoesSizeGuide.FirstOrDefaultAsync(m => m.Id == Id);

        if (shoessizeguide is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
    private void Close()
    {
        NavigationManager.NavigateTo("/shoessizeguides");
    }
}
