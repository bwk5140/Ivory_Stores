@page "/Account/OrderAbandoned"
@using Microsoft.AspNetCore.Authorization

@inject IStringLocalizer<SharedResource> Loc
@inject NavigationManager NavigationManager

@attribute [Authorize]

@rendermode InteractiveServer

<PageTitle>@Loc["OrderAbandoned"]</PageTitle>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark top-row">
    <a class="navbar-brand ms-2" href="/"><img src="CompanyLogo.png" width="80" height="50" /></a>
    <div class="container-fluid" style="display: flex; justify-content:center;">
        <h4>@Loc["Checkout"]</h4>
    </div>
</nav>
<div class="container-sm mt-5" style="text-align: center; color: #2f4f4f;">
    <a href="/" style="text-decoration: none;"><img class="mb-2" src="CompanyLogoEmail.png" width="80" height="60" /></a>
    <div class="center-container">
        <div class="card" style="max-width: 350px;">
            <div class="card-header">
                <strong>@Loc["OrderAbandoned"]</strong>
            </div>
            <div class="card-body">
                <div class="card mt-2 mb-2" style="border-color: red; max-width: 1200px; color: red; border-left: 3px solid red;">
                    <div class="card-body">
                        <img src="info-circle.svg" /> @Loc["UnsuccessfulOrder"]
                    </div>
                </div>
                <p>@error</p>
                <div class="card mt-2 mb-2" style="color: blue;">
                    <div class="card-body">
                        @Loc["NotCharged"]
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@code {
    [SupplyParameterFromQuery]
    public string? error { get; set; }
    public void ManageAccount()
    {
        NavigationManager.NavigateTo("Account/Manage");
    }
    public void ManageAddresses()
    {
        NavigationManager.NavigateTo("Addresses");
    }
}
