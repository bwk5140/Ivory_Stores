@page "/product/details"
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using System.Globalization
@using System.Text.Json

@inject ProtectedSessionStorage sessionStorage
@inject SearchEngineService SearchEngineService
@inject ApplicationUserService ApplicationUserService
@inject ShoppingCartService ShoppingCartService
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject IStringLocalizer<SharedResource> Loc
@inject IDbContextFactory<MethaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject ProductRatingService ProductRatingService
@inject IJSRuntime JSRuntime

@rendermode InteractiveServer

<PageTitle>Details</PageTitle>

<div class="container-xxl mt-5">
    @if (product is null)
    {
        <div class="card" style="z-index: 1400;  max-width: 70px;"><div class="card-body"><div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span> </div></div></div>
    }
    else
    {
        <nav style="--bs-breadcrumb-divider: '>';" aria-label="breadcrumb">
            <ol class="breadcrumb">
                @if (Categories is not null)
                {
                    for (int i = Categories.Count - 1; i >= 0; i--)
                    {
                        @if (Categories[i] != category)
                        {
                            <li class="breadcrumb-item">
                                <a href="@($"searchresults?filter=All&search={Categories[i].Name}")" style="text-decoration: none;
                                                        font-size: small;">
                                    @Categories[i].Name
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="breadcrumb-item active" aria-current="page" style="font-size: small; padding: 3px;">@category.Name</li>
                        }
                    }
                }
            </ol>
        </nav>
        <div class="row">
            <div class="image-container col-sm-1" style="max-width: 80px;">
                <div id="scrollImage">
                    @if (Images is not null)
                    {
                        @foreach (var Image in Images)
                        {
                            <div class="row">
                                <button class="btn" @onclick="@(() => OnCurrentImageClicked(Image))">
                                    <div class="card" style="padding: 0px;">
                                        <div class="card-body" style="padding: 0px;">
                                            <img class="card-img-top" src="@(string.Format("data:image/jpg;base64,{0}", Convert.ToBase64String(Image.Image!)))"
                                                 alt=@Loc["ProductImage"] style="width:30px; height:50px;object-fit:fill;" />
                                        </div>
                                    </div>

                                </button>
                            </div>
                        }
                    }
                </div>
                
            </div>
            <div class="image-container col-lg">
                @if (CurrentImage is not null)
                {
                    <CascadingValue Value="Images">
                        <CascadingValue Value="CurrentImage">
                            <CascadingValue Value="product">
                                <ProductImagesPopOver @ref="ProductImagesPopOver" />
                            </CascadingValue>
                        </CascadingValue>
                    </CascadingValue>
                    <button id="scrollImage" class="btn" @onclick="@(() => OnDetailsClicked(CurrentImage))" @onblur="Close">
                        <img class="card-img-top" src="@(string.Format("data:image/jpg;base64,{0}", Convert.ToBase64String(CurrentImage.Image!)))"
                             alt=@Loc["ProductImage"] style="width:100%; height:600px; object-fit:contain;" />
                    </button>
                }
            </div>
            
            <div class="col-md">
                <div>
                    <a href="@($"searchresults?search={product.Brand}")" class="btn btn-link" style="text-decoration: none; padding: 0px;">
                        @Loc["Shop"] @product.Brand
                    </a>
                </div>
                <h3 class="header mt-3">@product.Name</h3>
                <div style="display: inline-block;">
                    @{
                        var stars = ProductRatingService.GetStarImages(product.Rating);
                    }
                    @foreach (var star in stars)
                    {
                        <img src="@star" />
                    }
                    @if (product.ProductReviewIds is not null)
                    {
                        <button class="btn btn-sm" style="border: unset; outline:none; background-color: transparent; color: dodgerblue;">
                            (@product.ProductReviewIds.Count())
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-sm" style="border: unset; outline:none; background-color: transparent; color: dodgerblue;">
                            (0)
                        </button>
                    }
                </div>
                <hr/>
                <div style="display: inline-block;">
                    @{
                        string price = product.Price.ToString();
                        string price_w_curr = product.Price.ToString("C2");
                        char leading_char = price[0];
                        int index = price_w_curr.IndexOf(leading_char);
                    }
                    <label tyle="font-size: smaller; vertical-align: text-top;">@product.Price.ToString("C2").Substring(0, index)</label>
                    <strong style="font-size: x-large;">@product.Price.ToString("C2").Substring(index)</strong>
                    
                </div>
                <div class="mt-3 mb-3">
                    <button class="btn" style="border: unset; outline:none; background-color: transparent; color: dodgerblue; padding: 0px;">
                        @Loc["ReturnPolicy"]
                    </button>
                </div>
                
                <div class="mt-2 mb-2">
                    <label for="product.Size" class="form-label" style="color: gray;">@Loc["Size"]:</label>
                    <InputSelect id="category" @bind-Value="product.Size" class="form-select-sm">
                        @foreach (var filtr in Sizes)
                        {
                            <option value="@filtr">@filtr</option>
                        }
                    </InputSelect>
                </div>
                @if (products.Count() > 0)
                {
                    <div class="mt-3 mb-1 me-3">
                        <label for="product.Color" class="form-label" style="color: gray;">@Loc["Color"]:</label>
                        <strong>@product.Color</strong>
                    </div>
                    <div class="row">
                        @foreach (var prod in products)
                        {
                            <div class="col-sm-2">
                                <button class="btn btn-sm btn-secondary mb-2" style="background-color: transparent;
                                                               border-color: lightgray;width: fit-content; height: fit-content;"
                                        @onclick="@(() => ChangeProduct(prod))">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="@prod.Color"
                                         class="bi bi-circle-fill" viewBox="0 0 16 16">
                                        <circle cx="8" cy="8" r="8" fill="gray" />
                                        <circle cx="8" cy="8" r="7.5" fill="@prod.Color" />
                                    </svg>
                                </button>
                            </div>
                        }
                    </div>
                }
                <div class="mt-3">
                    <button class="btn" style="border: unset; outline:none; background-color: transparent;
                                            color: dodgerblue; padding: 0px;" @onclick="OnSizeChartClicked">
                        @Loc["SizeChart"]
                    </button>
                    <CascadingValue Value="productGroup">
                        <MethaWebsite.Components.SizeGuidePages.TrousersSizeGuidePages.TrouserSizeGuidePopover @ref="TrouserSizeGuidePopUp" />
                        <MethaWebsite.Components.SizeGuidePages.ShirtsSizeGuidePages.ShirtSizeGuidePopover @ref="ShirtSizeGuidePopUp" />
                        <MethaWebsite.Components.SizeGuidePages.ShoesSizeGuidePages.ShoeSizeGuidePopover @ref="ShoeSizeGuidePopUp" />
                    </CascadingValue>
                </div>
                <div class="mt-3">
                   <h5>@Loc["ProductDetails"]</h5>
                    <dl class="row mt-3 mb-2" style="color: #2f4f4f; font-size: smaller;">
                        <dt class="col-sm-5">
                            @Loc["Fabric"]
                        </dt>
                        <dd class="col-sm-5">
                            @product.Fabric
                        </dd>
                        <dt class="col-sm-5">
                            @Loc["WashInstructions"]
                        </dt>
                        <dd class="col-sm-5">
                            @product.WashInstructions
                        </dd>
                    </dl>
                    <hr />
                </div>
                <div class="mt-3">
                    <h5>@Loc["MoreInfo"]</h5>
                    @{
                        DisplayText = IsExpanded ? product.Description : product.Description.Substring(0, MaxLength) + "...";
                    }
                    <div style="font-size: medium; font-family:'Times New Roman', Times, serif;">
                        @((MarkupString)DisplayText)
                        @if (CanExpand)
                        {
                            <button class="ms-3 dropdown-toggle @(IsExpanded ? "rotate-180" : "rotate-0")" 
                                style="padding: 0px; background-color: transparent; border: none" @onclick="Toggle">
                            </button>
                            <a @onclick="Toggle" style="cursor:pointer; color:dodgerblue; text-decoration: none;">
                                @(IsExpanded ? "See Less" : "See More")
                            </a>
                        }
                    </div>
                </div>
                <div class="mt-3">
                    <button class="btn" style="border: unset; outline:none; background-color: transparent;
                                        color: dodgerblue;">
                        <img src="chat-right-text.svg"/>
                        @Loc["ProductIssue"]
                    </button>
                    <hr />
                </div>
                @if (!IsLoading)
                {
                    @if (SimilarProduct is not null)
                    {
                        using var context = DbFactory.CreateDbContext();
                        var SimilarProdImages = context.ProductImage.Where(p => p.ProductColorGroupId == SimilarProduct.ProductColorGroupID).OrderBy(p => p.Created).ToList();
                        var SimilarProdCurrentImage = SimilarProdImages[0];
                        <div class="mt-3">
                            <div class="card mb-3" style="border: none; padding: 0px;">
                                <div class="card-header" style="border: none; background-color: transparent;">
                                    <h5>@Loc["SimilarItem"]</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-sm-3" style="background-color: transparent; padding: 0px;">
                                            <a href="@($"product/details?id={SimilarProduct.Id}")" @onclick="(() => OnProductClicked(SimilarProduct))">
                                                <img src="@(string.Format("data:image/jpg;base64,{0}", Convert.ToBase64String(SimilarProdCurrentImage.Image!)))"
                                                     alt=@Loc["ProductImage"] style="width:100px; height:100px; object-fit:contain; vertical-align: central;" />
                                            </a>
                                        </div>
                                        <div class="col-sm-9">
                                            <a href="@($"product/details?id={SimilarProduct.Id}")" @onclick="(() => OnProductClicked(SimilarProduct))" style="padding: 0px; text-decoration:none;">
                                                @SimilarProduct.Name
                                            </a>
                                            <div>
                                                @{
                                                    var similar_prod_stars = ProductRatingService.GetStarImages(SimilarProduct.Rating);
                                                }
                                                @foreach (var star in similar_prod_stars)
                                                {
                                                    <img src="@star" />
                                                }
                                                @if (SimilarProduct.ProductReviewIds is not null)
                                                {
                                                    <button class="btn btn-sm" style="border: unset; outline:none; background-color: transparent; color: dodgerblue;">
                                                        (@SimilarProduct.ProductReviewIds.Count())
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-sm" style="border: unset; outline:none; background-color: transparent; color: dodgerblue;">
                                                        (0)
                                                    </button>
                                                }
                                            </div>
                                            <p style="font-size: smaller;"><strong>@SimilarProduct.Price.ToString("C2")</strong></p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="card mt-2 mb-2" style="z-index: 1400;  max-width: 70px;"><div class="card-body"><div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span> </div></div></div>
                }
                
            </div>
            <div class="col-sm" style="max-width: fit-content;">
                <div class="card">
                    <div class="card-body">
                        <label tyle="font-size: smaller; vertical-align: text-top;">@product.Price.ToString("C2").Substring(0, index)</label>
                        <strong style="font-size: x-large;">@product.Price.ToString("C2").Substring(index)</strong>
                        <div class="mt-3 mb-3">
                            <button style="border: unset; outline:none; background-color: transparent; color: dodgerblue;">
                                @Loc["ReturnPolicy"]
                            </button>
                        </div>
                        <div class="mt-3 mb-3">
                            <button style="border-bottom-left-radius: 10px; border-top-left-radius: 10px; border: unset;"
                                    @onclick="ReduceProductQuantity">
                                <img src="dash.svg"/>
                            </button>
                            <strong>@shoppingCartProduct.Quantity</strong>
                            <button style="border-bottom-right-radius: 10px; border-top-right-radius: 10px; border: unset;"
                                    @onclick="IncreaseProductQuantity">
                                <img src="plus.svg" />
                            </button>
                        </div>
                        <div class="mt-3 mb-3">
                            <div class="mb-2">
                                <button class="btn" style="border-radius: 10px; border: unset; background-color: lightgray; 
                                        min-width: 99%;" @onclick="OnAddToCart">
                                    @Loc["AddToCart"]
                                </button>
                            </div>
                            <div class="mb-2">
                                <button @onclick="OnBuyNow" class="btn" style="border-radius: 10px; background-color: #2f4f4f; color:#F5F5F5; 
                                                    border: unset; min-width: 99%;">
                                    @Loc["BuyNow"]
                                </button>
                            </div>
                        </div>
                        <div style="color: #2f4f4f;">
                            @Loc["FreeShipping"]
                            <button style="border: unset; outline:none; background-color: transparent; color: dodgerblue;">
                                @Loc["SelectLocation"]
                            </button>
                        </div>
                        <dl class="row mt-3 mb-2" style="color: #2f4f4f; font-size: x-small;">
                            <dd class="col-sm-5">
                                @Loc["ShipsFrom"]
                            </dd>
                            <dt class="col-sm-4">
                                @Loc["CompanyLogo"]
                            </dt>
                            <dd class="col-sm-5">
                                @Loc["SoldBy"]
                            </dd>
                            <dt class="col-sm-4">
                                @Loc["CompanyLogo"]
                            </dt>
                        </dl>
                        <dl class="row mt-3">
                            @if (!AddToListClicked)
                            {
                                <dd class="col-sm-9 mt-3" style="color: #2f4f4f; font-size: small;">
                                    <label class="form-label" style="text-align: left;">@Loc["AddToList"]:</label>
                                </dd>
                                <dt class="col-sm-2">
                                    <button type="button" class="btn" @onclick="OnAddToListClicked" data-bs-toggle="tooltip" title=@Loc["AddToList"]>
                                        <img src="plus-square.svg" />
                                    </button>
                                </dt>
                            }
                            @if (AddToListClicked)
                            {
                                <AuthorizeView>
                                    <Authorized>
                                        <dd class="col-md-12 mt-3" style="color: #2f4f4f; font-size: small; text-align: center;">
                                            <InputSelect id="list" @bind-Value="ListAddedTo" @bind-Value:after="OnListSelected" class="form-select-sm"
                                                         @onselect="OnListSelected" style="width: 200px;">
                                                <option selected value="" disabled hidden>@Loc["AddToList"]</option>
                                                <option value="@defaultList.Name" @onclick="OnListSelected">@defaultList.Name</option>
                                                @if (Lists is not null && Lists.Any())
                                                {
                                                    @foreach (var list in Lists)
                                                    {
                                                        <option value="@list.Name">@list.Name</option>
                                                    }
                                                }
                                                <option value="@Loc[" CreateList"]">@Loc["CreateList"]</option>
                                            </InputSelect>
                                        </dd>
                                        <MethaWebsite.Components.Account.Pages.ProductListPages.Create @ref=AddListPopUp OnAddToList="OnNewListItemCreated" OnCloseAddToList="UpdateInputSelect" />
                                    </Authorized>
                                    <NotAuthorized>
                                        @{
                                            var showClass = IsVisible ? "d-block" : "d-none";
                                        }
                                        <div class="toast-container @showClass" data-bs-autohide="true" data-bs-delay="5000"
                                             style="top: 35%; display: block; justify-content: center;">
                                            <div class="toast show" role="alert" aria-live="assertive" aria-atomic="true"
                                                 style="background-color: white;">
                                                <div class="toast-header">
                                                    <strong class="me-auto">@Loc["UserLists"]</strong>
                                                    <button type="button" class="btn-close" aria-label="Close" @onclick=" e=> IsVisible = false"></button>
                                                </div>
                                                <div class="toast-body">
                                                    <p>@Loc["SignInToUseLists"]</p>
                                                </div>
                                                <div class="toast-footer me-2 mb-3" style="text-align: right;">
                                                    <button type="button" class="btn btn-primary" @onclick="e => IsVisible = false" style="background-color: #2f4f4f">
                                                        @Loc["Ok"]
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="darker-background @showClass"></div>
                                    </NotAuthorized>
                                </AuthorizeView>
                            }
                            
                        </dl>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            @if (!IsLoading)
            {
                if (SimilarProductsGroups.Any())
                {
                    <hr id="stopPoint" />
                    <h5>@Loc["SimilarItems"]</h5>
                    <div id="multiProductCarousel" class="carousel slide">
                        <div class="carousel-inner">
                            @foreach (var group in SimilarProductsGroups)
                            {
                                <div class="ms-5 me-5 carousel-item @(group == SimilarProductsGroups.First() ? "active" : "")">
                                    <div class="ms-5 me-5 d-flex justify-content-start flex-wrap gap-2">
                                        @if (SimilarProducts is not null && SimilarProducts.Any())
                                        {
                                            foreach (var similarProd in SimilarProducts)
                                            {
                                                using var context = DbFactory.CreateDbContext();
                                                similarProd.Images = context.ProductImage.Where(p => p.ProductColorGroupId == similarProd.ProductColorGroupID).OrderBy(p => p.Created).ToList();
                                                var prodImage = similarProd.Images[0];
                                                <div class="card mb-3" style="border: none; width: 150px;">
                                                    <div class="card-body">
                                                        <div class="row" style="background-color: transparent; height: 170px;">
                                                            <a href="@($"product/details?id={product.Id}")" @onclick="(() => OnProductClicked(similarProd))">
                                                                <img src="@(string.Format("data:image/jpg;base64,{0}", Convert.ToBase64String(prodImage.Image!)))"
                                                                     alt=@Loc["ProductImage"] style="width:150px; height:150px; object-fit:contain; vertical-align: central;" />
                                                            </a>
                                                        </div>
                                                        <div class="row">
                                                            <div class="ms-3" style="display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden;
                                                                                                                                                                                                                                                    text-overflow: ellipsis; ">
                                                                <a href="@($"product/details?id={product.Id}")" @onclick="(() => OnProductClicked(similarProd))" style="padding: 0px; text-decoration:none;">
                                                                    @similarProd.Name
                                                                </a>
                                                            </div>

                                                            <div class="ms-3">
                                                                @{
                                                                    var similar_prod_stars = ProductRatingService.GetStarImages(similarProd.Rating);
                                                                }
                                                                @foreach (var star in similar_prod_stars)
                                                                {
                                                                    <img src="@star" />
                                                                }
                                                                @if (similarProd.ProductReviewIds is not null)
                                                                {
                                                                    <button class="btn btn-sm" style="border: unset; outline:none; background-color: transparent; color: dodgerblue;">
                                                                        (@similarProd.ProductReviewIds.Count())
                                                                    </button>
                                                                }
                                                                else
                                                                {
                                                                    <button class="btn btn-sm" style="border: unset; outline:none; background-color: transparent; color: dodgerblue;">
                                                                        (0)
                                                                    </button>
                                                                }
                                                            </div>
                                                            <p class="ms-3" style="font-size: smaller;"><strong>@similarProd.Price.ToString("C2")</strong></p>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <button class="carousel-control-prev" type="button" data-bs-target="#multiProductCarousel" data-bs-slide="prev">
                            <span style="background-color: dimgray; border-radius: 10px;" class="carousel-control-prev-icon"></span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#multiProductCarousel" data-bs-slide="next">
                            <span style="background-color: dimgray; border-radius: 10px;" class="carousel-control-next-icon"></span>
                        </button>
                    </div>
                }
            }
            else
            {
                <div class="card mt-2 mb-2" style="z-index: 1400;  max-width: 70px;"><div class="card-body"><div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span> </div></div></div>
            }
        </div>
        <hr id="stopPoint"/>
        <h5>@Loc["ProductDetails"]</h5>
        <div class="row mt-2" style="font-family: 'Times New Roman', Times, serif; padding: 0px;">
            <div class="col-sm-1 ms-3">
                @if (department is not null)
                {
                    <strong>@Loc["Category"] : </strong>
                }
            </div>
            <div class="col-sm-1">
                @if (department is not null)
                {
                    @department.Name
                }
            </div>
        </div>
        <div class="row" style="font-family: 'Times New Roman', Times, serif; padding: 0px;">
            <div class="col-sm-1 ms-3">
                <strong>ISPIN : </strong>
            </div>
            <div class="col-sm-3">
                @{
                    var IdNo = product.Id.Replace(" ", "");
                }
                @IdNo
            </div>
        </div>
        <div class="row mt-5 mb-5">
            <hr/>
            @if (!IsLoading)
            {
                <div class="col-sm-3 me-5">
                    <div class="card" style="border: none;">
                        <div class="card-body">
                            <h5>@Loc["CustomerReviewsSm"]</h5>
                            @if (product.ProductReviewIds is not null && product.ProductReviewIds.Any())
                            {
                                <div style="display: inline-block;">
                                    @{
                                        var rating_stars = ProductRatingService.GetStarImages(product.Rating);
                                    }
                                    @foreach (var star in rating_stars)
                                    {
                                        <img src="@star" />
                                    }
                                </div>
                            }

                            @if (product.Rating > 0)
                            {
                                <div class="ms-4" style="display: inline-block;">
                                    <h6>@product.Rating @Loc["OutOf5"]</h6>
                                </div>
                            }

                            @if (product.ProductReviewIds is not null && product.ProductReviewIds.Any())
                            {
                                @if (product.ProductReviewIds.Count == 1)
                                {
                                    <div>
                                        <h6>@product.ProductReviewIds.Count() @Loc["RatingSm"]</h6>
                                    </div>
                                }
                                else
                                {
                                    <div>
                                        <h6>@product.ProductReviewIds.Count() @Loc["Ratings"]</h6>
                                    </div>
                                }
                            }
                            <div class="mt-4">
                                @if (product.ProductReviewIds is not null)
                                {
                                    <div style="padding: 0px;">
                                        @foreach (var key in RatingPercentages)
                                        {
                                            <button class="btn btn-link mb-2" style="border: none; background-color: transparent; width: 100%; text-decoration: none; padding: 0px;">
                                                <table style="width: 100%; padding: 0px;">
                                                    <tbody>
                                                        <tr>
                                                            <td style="width: 20%; padding: 0px;">@key.Key @Loc["star"]</td>
                                                            <td style="width: 80%; padding: 0px;">
                                                                <div class="progress" role="progressbar" aria-label="Success example" aria-valuenow="@RatingPercentages[key.Key]" aria-valuemin="0" aria-valuemax="100">
                                                                    <div class="progress-bar text-bg-success" style="width: @RatingPercentages[key.Key]%">@RatingPercentages[key.Key]%</div>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>


                                            </button>

                                        }

                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    <hr />
                </div>
            }
            else
            {
                <div class="card mt-2 mb-2" style="z-index: 1400;  max-width: 70px;"><div class="card-body"><div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span> </div></div></div>
            }
            @if (!IsLoading)
            {
                <div class="col-lg-8 ms-2">
                    @if (product.ProductReviewIds is not null && product.ProductReviewIds.Any())
                    {
                        <h5>@Loc["ReviewImages"]</h5>
                        <div id="multiImageCarousel" class="carousel slide">
                            <div class="carousel-inner">
                                @foreach (var group in ReviewImageGroups)
                                {
                                    <div class="carousel-item @(group == ReviewImageGroups.First() ? "active" : "")">
                                        <div class="d-flex justify-content-center gap-2">
                                            @foreach (var img in group)
                                            {
                                                <button style="background-color: transparent; border: none; padding: 0px;">
                                                    <img src="@(string.Format("data:image/jpg;base64,{0}", Convert.ToBase64String(img.Image!)))" class="img-thumbnail" style="width: 180px; height: 200px;" />
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>

                            <button class="carousel-control-prev" type="button" data-bs-target="#multiImageCarousel" data-bs-slide="prev">
                                <span style="background-color: dimgray; border-radius: 10px;" class="carousel-control-prev-icon"></span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#multiImageCarousel" data-bs-slide="next">
                                <span style="background-color: dimgray; border-radius: 10px;" class="carousel-control-next-icon"></span>
                            </button>
                        </div>
                        <div class="carousel-indicators">
                            @for (int i = 0; i < ReviewImageGroups.Count; i++)
                            {
                                <button data-bs-target="#multiImageCarousel" data-bs-slide-to="@i"
                                        class="@(i == 0 ? "active" : "")"></button>
                            }
                        </div>
                        <hr />
                        <h5 class="mb-4">@Loc["TopReviews"]</h5>
                        @foreach (var review in Reviews)
                        {
                            <div class="card" style="border: none; font-family: 'Times New Roman', Times, serif; font-size: medium; width: 60%;">
                                <div class="card-body">
                                    @{
                                        using var context = DbFactory.CreateDbContext();
                                        var user = context.Users.FirstOrDefault(u => u.Id == review.UserId);
                                    }
                                    <div style="color: darkslategray;">
                                        <img class="me-2" src="person-circle.svg" />
                                        @user.Name
                                    </div>
                                    <div>
                                        @{
                                            var user_rating = GetRating(review);
                                            var user_rating_stars = ProductRatingService.GetStarImages(user_rating);
                                            var prod = context.Product.FirstOrDefault(p => p.Id == review.ProductId);
                                        }
                                        @foreach (var star in user_rating_stars)
                                        {
                                            <div style="display: inline-block;">
                                                <img src="@star" />
                                            </div>
                                        }
                                        <div class="ms-3" style="display: inline-block;">
                                            <strong>@review.Subject</strong>
                                        </div>
                                    </div>
                                    <div style="color: dimgray; display: inline-block;">
                                        @Loc["ReviewdOn"] @review.Created.Value.ToString("MMMM") @review.Created.Value.Day, @review.Created.Value.Year
                                    </div>
                                    <div>
                                        <div style="color: dimgray; display: inline-block;">
                                            @Loc["Size"]:  @prod.Size
                                        </div>
                                        <div class="me-2 ms-2" style="color: lightgray; display: inline-block;">
                                            |
                                        </div>
                                        <div style="color: dimgray; display: inline-block;">
                                            @Loc["Color"]:  @prod.Color
                                        </div>
                                        <div class="me-2 ms-2" style="color: lightgray; display: inline-block;">
                                            |
                                        </div>
                                        <div style="display: inline-block;">
                                            <strong style="color: #2f4f4f;">@Loc["VerifiedPurchase"]</strong>
                                        </div>
                                    </div>

                                    <div>
                                        @((MarkupString)review.Description)
                                    </div>
                                    <div>
                                        @{
                                            using var img_context = DbFactory.CreateDbContext();
                                            var images = img_context.ProductImage.Where(i => review.ImageIds.Contains(i.Id));
                                        }
                                        @if (images is not null)
                                        {
                                            foreach (var img in images)
                                            {
                                                <button style="background-color: transparent; border: none; padding: 5px;">
                                                    <img src="@(string.Format("data:image/jpg;base64,{0}", Convert.ToBase64String(img.Image!)))" class="img-thumbnail" style="width: 80px; height: 100px;" />
                                                </button>
                                            }
                                        }
                                    </div>
                                    <div class="btn-group">
                                        <button type="button" class="btn btn-secondary me-2" style="background-color: transparent; border-radius: 25px; color: black;">
                                            @Loc["Helpful"]
                                        </button>
                                        <button type="button" class="btn btn-primary" style="background-color: transparent; border: none; color: black;">
                                            <div class="me-2" style="display: inline-block;">
                                                |
                                            </div>
                                            <div style="display: inline-block;">
                                                @Loc["Report"]
                                            </div>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <strong>@Loc["NoCustomerReviews"]</strong>
                    }

                </div>
            }
            else
            {
                <div class="card ms-5 mt-2 mb-2" style="z-index: 1400;  max-width: 70px;"><div class="card-body"><div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span> </div></div></div>
            }
        </div>
    }
</div>
<CascadingValue Value="product">
    <CascadingValue Value="ListAddedTo">
        <NewItemAddedToList @ref="newItemAddedToListPopUp" />
    </CascadingValue>
</CascadingValue>

@code {
    private Product? product;
    private Product? SimilarProduct;
    public ProductGroup? productGroup;

    private List<List<ProductImage>> ReviewImageGroups { get; set; } = new ();
    private List<List<Product>> SimilarProductsGroups { get; set; } = new ();


    [Parameter] public int MaxLength { get; set; } = 500;

    private bool IsExpanded { get; set; } = false;
    private bool CanExpand;
    private bool IsLoading { get; set; } = false;
    private Dictionary<string, int> TotalRatings = new();
    private Dictionary<string, double> RatingPercentages = new();

    private string? DisplayText;

    private void Toggle() => IsExpanded = !IsExpanded;

    [Parameter]
    public ShoppingCartProduct shoppingCartProduct { get; set; } = new ();

    [Parameter]
    public List<ProductImage>? Images { get; set; }

    [Parameter]
    public ProductImage? CurrentImage { get; set; }

    [Parameter]
    public int Count { get; set; } = 1;

    [Parameter]
    public List<Product>? SimilarProducts { get; set; }

    [Parameter]
    public List<string>? Sizes { get; set; } = new List<string>();

    [Parameter]
    public List<ProductList>? Lists { get; set; } = new List<ProductList>();

    [Parameter]
    public List<ProductReview>? Reviews { get; set; } = new List<ProductReview>();

    [Parameter]
    public List<ProductImage> ReviewImages { get; set; } = new List<ProductImage>();

    [Parameter]
    public List<Category>? Categories { get; set; } = new List<Category>();

    [Parameter]
    public string? CurrentSize { get; set; }

    [Parameter]
    public string? ListAddedTo { get; set; }

    [Parameter]
    public List<Product>? products { get; set; } = new List<Product>();
    public List<Product>? Products { get; set; } = new List<Product>();
    public List<ProductColorGroup>? productColorGroups { get; set; } = new List<ProductColorGroup>();

    [Parameter]
    public bool AddToListClicked { get; set; }

    [Parameter]
    public ProductList? defaultList { get; set; }

    [Parameter]
    public bool IsVisible { get; set; } = false;

    private delegate bool TryFindSizeGuide(string id, DbContext context);
    private record SizeGuideHandler(TryFindSizeGuide TryFind, Action Action);

    [SupplyParameterFromQuery]
    private string? Id { get; set; }

    private Category? category { get; set; }
    private Category? department { get; set; }

    private SizeGuidePages.TrousersSizeGuidePages.TrouserSizeGuidePopover? TrouserSizeGuidePopUp;
    private SizeGuidePages.ShirtsSizeGuidePages.ShirtSizeGuidePopover? ShirtSizeGuidePopUp;
    private SizeGuidePages.ShoesSizeGuidePages.ShoeSizeGuidePopover? ShoeSizeGuidePopUp;
    private ProductImagesPopOver? ProductImagesPopOver;
    private Create? AddListPopUp;
    private NewItemAddedToList? newItemAddedToListPopUp;

    private ApplicationUser? ApplicationUser { get; set; }
    private ShoppingCart? ShoppingCart { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        product = await context.Product.FirstOrDefaultAsync(m => m.Id == Id);
        CanExpand = product.Description.Length > MaxLength;
        ApplicationUser ??= await ApplicationUserService.GetApplicationUser();

        if (product is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        products.Add(product);
        Sizes.Add(product.Size);
        if (Images is null)
        {
            Images = context.ProductImage.Where(i => i.ProductColorGroupId == product.ProductColorGroupID).OrderBy(i => i.Created).ToList();
            if (Images.Count > 0)
            {
                CurrentImage = Images[0];
            }
        }
        IsLoading = true;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            using var context = await DbFactory.CreateDbContextAsync();
            product = await context.Product.FirstOrDefaultAsync(m => m.Id == Id);
            productGroup = await context.ProductGroup.FirstOrDefaultAsync(p => p.Name == product.Name);

            var product_color_groups = context.ProductColorGroup.Where(p => p.ProductGroupID == productGroup.Id);

            foreach (var product_color_group in product_color_groups)
            {
                var prods = context.Product.Where(p => p.ProductColorGroupID == product_color_group.Id);
                products.AddRange(prods);
            }

            foreach (var prod in products)
            {
                if (!Sizes.Contains(prod.Size))
                {
                    Sizes.Add(prod.Size);
                }
            }
            products.Clear();
            foreach (var product_color_group in product_color_groups)
            {
                var prod = await context.Product.FirstOrDefaultAsync(p => p.ProductColorGroupID == product_color_group.Id);
                if (!products.Contains(prod))
                {
                    products.Add(prod);
                }
            }
            category = await context.Category.FirstOrDefaultAsync(c => c.Id == product.CategoryId);
            Categories.Add(category);
            var ParentCat = await context.Category.FirstOrDefaultAsync(c => c.Id == category.ParentID);
            while (ParentCat is not null)
            {
                Categories.Add(ParentCat);
                ParentCat = await context.Category.FirstOrDefaultAsync(c => c.Id == ParentCat.ParentID);
            }
            department = Categories.FirstOrDefault(c => c.ParentID == null);
            if (ApplicationUser is not null)
            {
                Lists = context.ProductList.Where(l => l.UserId == ApplicationUser.Id).ToList();
                defaultList = await context.ProductList.FirstOrDefaultAsync(l => l.Name == "Default");
                Lists.Remove(defaultList);
            }
            Products = context.Product.ToList();
            foreach (var _product in products)
            {
                Products.Remove(_product);
            }
            // Load images and collect product groups
            var productGroups = Products
                .Select(p =>
                {
                    p.Images = context.ProductImage
                        .Where(img => img.ProductColorGroupId == p.ProductColorGroupID)
                        .OrderBy(img => img.Created)
                        .ToList();

                    return context.ProductGroup.FirstOrDefault(pg => pg.Name == p.Name);
                })
                .Where(pg => pg != null)
                .Distinct()
                .ToList();

            // Load product color groups
            productColorGroups = productGroups
                .SelectMany(pg => context.ProductColorGroup.Where(pcg => pcg.ProductGroupID == pg.Id))
                .Distinct()
                .ToList();

            // Load products from color groups
            Products = productColorGroups
                .Select(pcg => context.Product.FirstOrDefault(p => p.ProductColorGroupID == pcg.Id))
                .Where(p => p != null)
                .ToList();

            Products = Products
                .GroupBy(p => p.Name)
                .Select(g => g.First())
                .ToList();

            var ProductsIds = Products.Select(p => p.Id).ToList();
            ProductsIds.Add(product.Id);

            Reviews = context.ProductReview.Where(r => product.ProductReviewIds.Contains(r.Id)).OrderByDescending(r => r.Created).ToList();
            if (Reviews is not null)
            {
                foreach (var review in Reviews)
                {
                    if (review.ImageIds is not null && review.ImageIds.Any())
                    {
                        var images = context.ProductImage.Where(i => review.ImageIds.Contains(i.Id)).ToList();
                        ReviewImages.AddRange(images);
                    }
                }
            }
            ReviewImageGroups = ReviewImages
            .Select((img, index) => new { img, index })
            .GroupBy(x => x.index / 3)
            .Select(g => g.Select(x => x.img).ToList())
            .ToList();


            Random rand = new Random();
            int randomInt;

            SimilarProducts = SearchEngineService.RecommendSimilar(product, Products);
            // Generate a random integer between 0 and SimilarProducts.Count() - 1
            randomInt = rand.Next(SimilarProducts.Count());
            if (SimilarProducts is not null && SimilarProducts.Any())
            {
                SimilarProduct = SimilarProducts[randomInt];
            }

            else
            {
                Products = productColorGroups
                .Select(pcg => context.Product.FirstOrDefault(p => p.ProductColorGroupID == pcg.Id))
                .Where(p => p != null)
                .ToList();
                SimilarProducts = SearchEngineService.RecommendSimilar(product, Products);
                if (SimilarProducts is not null && SimilarProducts.Any())
                    SimilarProduct = SimilarProducts[randomInt];

                if (SimilarProduct is not null && SimilarProduct.ProductReviewIds is null)
                {
                    SimilarProduct.ProductReviewIds = new List<string>();
                }
            }
            SimilarProductsGroups = SimilarProducts
            .Select((prod, index) => new { prod, index })
            .GroupBy(x => x.index / 7)
            .Select(g => g.Select(x => x.prod).ToList())
            .ToList();

            for (int i = 0; i < 5; i++)
            {
                TotalRatings[(i + 1).ToString()] = 0;
                RatingPercentages[(i + 1).ToString()] = 0;
            }
            if (product.ProductReviewIds is null)
            {
                product.ProductReviewIds = new List<string>();
            }
            foreach (var review in Reviews)
            {
                await GetPercentageOfRatings(review);
            }
            IsLoading = false;
            StateHasChanged();
        }
    }

    public void OnAddToListClicked()
    {
        AddToListClicked = true;
        IsVisible = true;
    }
    private async Task OnListSelected()
    {
        if (!string.IsNullOrWhiteSpace(ListAddedTo))
        {
            if (ListAddedTo == "Create a list")
            {
                AddListPopUp.Show();
            }
            else
            {
                using var context = await DbFactory.CreateDbContextAsync();
                var list = await context.ProductList.FirstOrDefaultAsync(l => l.Name == ListAddedTo);
                if (list is not null && list.ProductIds is null)
                {
                    list.ProductIds = new List<string>();
                }
                if (list is not null)
                {
                    list.ProductIds.Add(product.Id);
                    context.Attach(list).State = EntityState.Modified;
                    await context.SaveChangesAsync();
                    newItemAddedToListPopUp.Show();
                }
                else
                {
                    AddListPopUp.Show();
                }
            }
        }
    }
    private async Task OnNewListItemCreated()
    {
        AddToListClicked = false;
        using var context = await DbFactory.CreateDbContextAsync();
        if (ApplicationUser is not null)
        {
            Lists = context.ProductList.Where(l => l.UserId == ApplicationUser.Id).OrderBy(l => l.Created).ToList();
            Lists.Remove(defaultList);
        }
        ListAddedTo = Lists.Last().Name;
        await OnListSelected();
        newItemAddedToListPopUp.Show();
        StateHasChanged();
    }
    private async Task OnSizeChartClicked()
    {
        if (product.SizeGuideId is not null)
        {
            using var context = await DbFactory.CreateDbContextAsync();

            var sizeGuideHandlers = new List<SizeGuideHandler>
            {
                new SizeGuideHandler(
                    (id, ctx) => context.ShirtsSizeGuide.Any(s => s.Id == id),
                    () => ShirtSizeGuidePopUp!.Show()),
                new SizeGuideHandler(
                    (id, ctx) => context.ShoesSizeGuide.Any(s => s.Id == id),
                    () => ShoeSizeGuidePopUp!.Show()),
                new SizeGuideHandler(
                    (id, ctx) => context.TrousersSizeGuide.Any(s => s.Id == id),
                    () => TrouserSizeGuidePopUp!.Show())
            };

            foreach (var handler in sizeGuideHandlers)
            {
                if (handler.TryFind(product.SizeGuideId, context))
                {
                    handler.Action();
                    break;
                }
            }
        }
    }
    public void OnDetailsClicked(ProductImage image)
    {
        ProductImagesPopOver.Show();
    }
    public void Close()
    {
        //ProductImagesPopOver.Close();
    }
    public void OnCurrentImageClicked(ProductImage image)
    {
        CurrentImage = image;
        StateHasChanged();
    }
    private async Task ChangeProduct(Product prod)
    {
        product = prod;
        using var context = await DbFactory.CreateDbContextAsync();

        Images = context.ProductImage.Where(i => i.ProductColorGroupId == product.ProductColorGroupID).OrderBy(i => i.Created).ToList();
        if (Images.Count > 0)
        {
            CurrentImage = Images[0];
        }
        StateHasChanged();
    }
    private async Task OnAddToCart()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        var ShoppingCartProduct = new ShoppingCartProduct();
        ShoppingCartProduct.ProductId = product.Id;
        context.ShoppingCartProduct.Add(ShoppingCartProduct);
        ShoppingCartProduct.Quantity = shoppingCartProduct.Quantity;
        context.Attach(product).State = EntityState.Modified;
        if (ApplicationUser is not null)
        {
            ShoppingCart = await context.ShoppingCart.FirstOrDefaultAsync(s => s.UserId == ApplicationUser.Id);

            if (ShoppingCart is null)
            {
                ShoppingCart = ShoppingCartService.getShoppingCart();
                ShoppingCart.UserId = ApplicationUser.Id;
                context.ShoppingCart.Add(ShoppingCart);
                await context.SaveChangesAsync();
            }
        }
        else
        {
            ShoppingCart = ShoppingCartService.getShoppingCart();
            if (!context.ShoppingCart.Contains(ShoppingCart))
            {
                context.ShoppingCart.Add(ShoppingCart);
                await context.SaveChangesAsync();
            }
        }
        for (int i = shoppingCartProduct.Quantity; i > 0; i--)
        {
            ShoppingCart.ProductIds.Add(ShoppingCartProduct.Id);
            ShoppingCart.Subtotal += product.Price;
        }
        if (ApplicationUser is null)
        {
            await SaveCartAsync();
        }
        context.Attach(ShoppingCart!).State = EntityState.Modified;
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo($"/shoppingcart/confirmation?id={product.Id}", forceLoad: true);
    }
    private async Task OnBuyNow()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        var ShoppingCartProduct = new ShoppingCartProduct();
        ShoppingCartProduct.ProductId = product.Id;
        ShoppingCartProduct.Quantity = shoppingCartProduct.Quantity;
        context.ShoppingCartProduct.Add(ShoppingCartProduct);
        context.Attach(product).State = EntityState.Modified;
        if (ApplicationUser is not null)
        {
            ShoppingCart = await context.ShoppingCart.FirstOrDefaultAsync(s => s.UserId == ApplicationUser.Id);

            if (ShoppingCart is null)
            {
                ShoppingCart = ShoppingCartService.getShoppingCart();
                ShoppingCart.UserId = ApplicationUser.Id;
                context.ShoppingCart.Add(ShoppingCart);
                await context.SaveChangesAsync();
            }
        }
        else
        {
            ShoppingCart = ShoppingCartService.getShoppingCart();
            if (!context.ShoppingCart.Contains(ShoppingCart))
            {
                context.ShoppingCart.Add(ShoppingCart);
                await context.SaveChangesAsync();
            }
            await sessionStorage.SetAsync("cart", ShoppingCart);
        }

        for (int i = shoppingCartProduct.Quantity; i > 0; i--)
        {
            ShoppingCart.ProductIds.Add(ShoppingCartProduct.Id);
            ShoppingCart.Subtotal += product.Price;
        }
        if (ApplicationUser is null)
        {
            await SaveCartAsync();
        }
        context.Attach(ShoppingCart!).State = EntityState.Modified;
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo($"/Checkout?id={shoppingCartProduct.Id}");
    }
    private async Task SaveCartAsync()
    {
        var json = JsonSerializer.Serialize(ShoppingCart);
        await JSRuntime.InvokeVoidAsync("cartStorage.saveCart", "Cart", json);
    }

    private void UpdateInputSelect()
    {
        ListAddedTo = "";
        StateHasChanged();
    }
    private void ReduceProductQuantity()
    {
        shoppingCartProduct.Quantity -= 1;
    }
    private void IncreaseProductQuantity()
    {
        shoppingCartProduct.Quantity += 1;
    }
    private void OnNavButtonClicked(string crumb)
    {
        NavigationManager.NavigateTo($"searchresults?filter=All&search={crumb}");
    }
    private void OnProductClicked(Product product)
    {
        NavigationManager.NavigateTo($"product/details?id={product.Id}", true);
    }
    public double GetRating(ProductReview Review)
    {
        double rating = 0;
        using var context = DbFactory.CreateDbContext();

        if (Review is not null)
        {
            Review.Ratings = context.Rating.Where(r => r.ProductReviewID == Review.Id).ToList();
            foreach (var _rating in Review.Ratings)
            {
                if (_rating.Selected)
                    rating += 1.0;
            }
        }
        return rating;
    }
    public async Task GetPercentageOfRatings(ProductReview Review)
    {
        var Rating = GetRating(Review);
        double percentage = 0;
        using var context = await DbFactory.CreateDbContextAsync();
        TotalRatings[Rating.ToString()] += 1;
        if (Reviews == null || Reviews.Any() != true)
        {
            RatingPercentages[Rating.ToString()] = 0;
        }
        else
        {
            RatingPercentages[Rating.ToString()] = Math.Round((TotalRatings[Rating.ToString()] / (double)Reviews.Count()) * 100, 0);
        }
    }
}
