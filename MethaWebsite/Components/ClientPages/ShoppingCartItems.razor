@page "/shoppingcart"
@using MethaWebsite.Services
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using MethaWebsite.Data
@using MethaWebsite.Data.Contexts
@implements IAsyncDisposable

@inject ApplicationUserService ApplicationUserService
@inject LayoutRefreshService RefreshService
@inject ShoppingCartService ShoppingCartService
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@inject IDbContextFactory<MethaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject IStringLocalizer<SharedResource> Loc

@rendermode InteractiveServer

<PageTitle>Index</PageTitle>

<div class="container-xxl mt-5 mb-5">
    <div class="row">
        <div class="col-lg-9">
            <div class="card">
                <div class="card-body">
                    <table class="table">
                        <thead>
                            <tr>
                                <th style="padding-right: 40px;" scope="col">
                                    @Loc["ShoppingCart"]
                                </th>
                                <th style="padding-right: 40px;" scope="col">

                                </th>
                                <th style="text-align: right; color: gray;" scope="col">
                                    @Loc["Price"]
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Products is not null && Products.Any())
                            {
                                foreach (var product in Products)
                                {
                                    if (product.Images.Count > 0)
                                    {
                                        var Id = product.Id;
                                        var CurrentImage = product.Images[0];
                                        <tr>
                                            <td>
                                                <InputCheckbox @bind-Value="SelectedProducts[Id]" class="darker-border-checkbox form-check-input"
                                                               @bind-Value:after="@(() => UpdateCart(product))" />
                                                <a href="@($"product/details?id={product.Id}")" class="btn">
                                                    <img class="card-img-top" src="@(string.Format("data:image/jpg;base64,{0}", Convert.ToBase64String(CurrentImage.Image!)))"
                                                         alt=@Loc["ProductImage"] style="width:300px; height:300px; object-fit:contain;" />
                                                </a>
                                            </td>
                                            <td style="padding: 0px;">
                                                <a class="mt-3" href="@($"product/details?id={product.Id}")" style="padding: 0px; display: -webkit-box; -webkit-line-clamp: 2;
                                                                        -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis; text-decoration:none; color: black;">
                                                    <h5>@product.Name</h5>
                                                </a>
                                                <p class="mt-2" style="color: gray; font-size: smaller;">@Loc["ShipsFrom"]: @Loc["CompanyLogo"]</p>
                                                <p style="font-size: smaller;">@product.DeliveryFee.ToString("C2") @Loc["Delivery"]</p>
                                                <p>
                                                    <strong style="font-size: smaller;">@Loc["Color"]: </strong> @product.Color
                                                </p>
                                                <p>
                                                    <strong style="font-size: smaller;">@Loc["Size"]: </strong> @product.Size
                                                </p>
                                                <div class="btn-group" style="border: 2px solid #2f4f4f; border-radius: 20px;">
                                                    <button class="me-2" style="border-bottom-left-radius: 10px; border-top-left-radius: 10px; border: unset;"
                                                            @onclick="@(() => RemoveProduct(product))">
                                                        <img src="dash.svg" />
                                                    </button>
                                                    <strong>@product.Quantity</strong>
                                                    <button class="ms-2" style="border-bottom-right-radius: 10px; border-top-right-radius: 10px; border: unset;"
                                                            @onclick="@(() => AddProduct(product))">
                                                        <img src="plus.svg" />
                                                    </button>
                                                </div>
                                            </td>
                                            <td style="text-align: right; padding-left: 40px;">
                                                <div class="mt-2">
                                                    <strong style="font-size: medium;">@product.Price.ToString("C2") </strong>
                                                </div>
                                            </td>
                                        </tr>
                                    }

                                }
                            }
                        </tbody>
                    </table>
                    <div style="text-align: right;">
                        @if (ShoppingCart is not null && ShoppingCart.ProductIds.Any())
                        {
                            <div style="display: inline-block">
                                @if (ShoppingCart.ProductIds.Count() == 1)
                                {
                                    <h5 style="font-weight: 450;">@Loc["Subtotal"] (@ShoppingCart.ProductIds.Count() @Loc["Item"]):</h5>
                                }
                                else
                                {
                                    <h5 style="font-weight: 450;">@Loc["Subtotal"] (@ShoppingCart.ProductIds.Count() @Loc["Items"]):</h5>
                                }
                            </div>
                            <div style=" display: inline-block">
                                <h5> @ShoppingCart.Subtotal.ToString("C2")</h5>
                            </div>
                        }
                        else
                        {
                            <h5 style="font-weight: 450;">@Loc["Subtotal"] (0 @Loc["Items"])</h5>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-3">
            @if (ShoppingCart is not null && ShoppingCart.ProductIds.Any())
            {
                <div class="card" style="width: fit-content; text-wrap: nowrap;">
                    <div class="card-body">

                        <div style="display: inline-block">
                            @if (ShoppingCart.ProductIds.Count() == 1)
                            {
                                <h5 style="font-weight: 450;">@Loc["Subtotal"] (@ShoppingCart.ProductIds.Count() @Loc["Item"]):</h5>
                            }
                            else
                            {
                                <h5 style="font-weight: 450;">@Loc["Subtotal"] (@ShoppingCart.ProductIds.Count() @Loc["Items"]):</h5>
                            }
                        </div>
                        <div style=" display: inline-block">
                            <h5>@ShoppingCart.Subtotal.ToString("C2")</h5>
                        </div>
                        <div style="text-align: center;">
                            <button class="mt-2 mb-3" style="border-bottom-left-radius: 15px; border-top-left-radius: 15px; border-bottom-right-radius: 15px;
                                    border-top-right-radius: 15px; border: unset; background-color: #2f4f4f; color: white; padding: 5px;">
                                @Loc["ProceedToCheckout"]
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</div>

@code {
    private ApplicationDbContext context = default!;
    private ApplicationUser? ApplicationUser { get; set; }
    [Parameter]
    public List<Product>? Products { get; set; } = new List<Product>();
    private ShoppingCart? ShoppingCart { get; set; }
    [Parameter]
    public Dictionary<string, bool>? SelectedProducts { get; set; } = new ();
    [Parameter]
    public List<ProductImage>? Images { get; set; } = new List<ProductImage>();

    protected override async Task OnInitializedAsync()
    {
        context = DbFactory.CreateDbContext();
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        ApplicationUser ??= await ApplicationUserService.GetApplicationUser(authState, UserManager);

        if (ApplicationUser is not null)
        {
            ShoppingCart = await context.ShoppingCart.FirstOrDefaultAsync(s => s.UserId == ApplicationUser.Id);
            if (ShoppingCart is null)
            {
                ShoppingCart = ShoppingCartService.getShoppingCart();
            }
            foreach (var Id in ShoppingCart!.ProductIds)
            {
                var product = await context.Product.FirstOrDefaultAsync(p => p.Id == Id);
                if (!Products.Contains(product))
                {
                    Products.Add(product);
                }
            }
        }
        else
        {
            ShoppingCart = ShoppingCartService.getShoppingCart();
            foreach (var Id in ShoppingCart?.ProductIds)
            {
                var product = await context.Product.FirstOrDefaultAsync(p => p.Id == Id);
                if (!Products.Contains(product))
                {
                    Products.Add(product);
                }
            }
        }
        if (Products is not null && Products.Any())
        {
            foreach (var product in Products)
            {
                SelectedProducts[product.Id] = true;
                product.Images = context.ProductImage.Where(p => p.ProductColorGroupId == product.ProductColorGroupID).OrderBy(p => p.Created).ToList();
            }
        }
    }
    private void UpdateCart(Product product)
    {

    }
    public async Task RemoveProduct(Product product)
    {
        // using var context = await DbFactory.CreateDbContextAsync();
        // ShoppingCart!.ProductIds!.Remove(product.Id);
        // if (ShoppingCart.Subtotal > 0)
        //     ShoppingCart.Subtotal -= product.Price;
        // if (product.Quantity > 0)
        //     product.Quantity -= 1;
        // context.Attach(product!).State = EntityState.Modified;
        // await context.SaveChangesAsync();
        // if (ApplicationUser is not null)
        // {
        //     context.Attach(ShoppingCart!).State = EntityState.Modified;
        //     await context.SaveChangesAsync();
        // }
        // List<Product> products = new List<Product>();
        // foreach (var Id in ShoppingCart!.ProductIds)
        // {
        //     var prod = await context.Product.FirstOrDefaultAsync(p => p.Id == Id);
        //     if (!products.Contains(prod))
        //     {
        //         products.Add(prod);
        //     }
        // }
        var context = await DbFactory.CreateDbContextAsync();

        if (ShoppingCart is null || product is null)
            return;

        // Remove product ID and update subtotal
        ShoppingCart.ProductIds?.Remove(product.Id);

        if (ShoppingCart.Subtotal > 0)
            ShoppingCart.Subtotal -= product.Price;

        if (product.Quantity > 0)
            product.Quantity--;

        // Track changes
        context.Attach(product).State = EntityState.Modified;

        if (ApplicationUser is not null)
            context.Attach(ShoppingCart).State = EntityState.Modified;

        // Save once after tracking all changes
        await context.SaveChangesAsync();

        // Fetch related products
        var products = await context.Product
            .Where(p => ShoppingCart.ProductIds!.Contains(p.Id))
            .Distinct()
            .ToListAsync();
        Products = products;
        if (Products is not null && Products.Any())
        {
            foreach (var prod in Products)
            {
                prod.Images = context.ProductImage.Where(p => p.ProductColorGroupId == prod.ProductColorGroupID).OrderBy(p => p.Created).ToList();
            }
        }
        StateHasChanged();
        TriggerLayoutRefresh();
    }
    public async Task AddProduct(Product product)
    {
        var context = await DbFactory.CreateDbContextAsync();

        if (ShoppingCart is null || product is null)
            return;

        // Add product ID and update subtotal/quantity
        ShoppingCart.ProductIds?.Add(product.Id);
        ShoppingCart.Subtotal += product.Price;
        product.Quantity++;

        // Track changes
        context.Attach(product).State = EntityState.Modified;

        if (ApplicationUser is not null)
            context.Attach(ShoppingCart).State = EntityState.Modified;

        // Save all changes in one go
        await context.SaveChangesAsync();

        // Fetch related products without duplicates
        var products = await context.Product
            .Where(p => ShoppingCart.ProductIds!.Contains(p.Id))
            .Distinct()
            .ToListAsync();
        Products = products;
        if (Products is not null && Products.Any())
        {
            foreach (var prod in Products)
            {
                prod.Images = context.ProductImage.Where(p => p.ProductColorGroupId == prod.ProductColorGroupID).OrderBy(p => p.Created).ToList();
            }
        }
        StateHasChanged();
        TriggerLayoutRefresh();
    }
    public async ValueTask DisposeAsync() => await context.DisposeAsync();

    public void OnDetailsClicked(Product product)
    {
        NavigationManager.NavigateTo("");
    }
    private void TriggerLayoutRefresh()
    {
        RefreshService.RequestRefresh();
    }
}