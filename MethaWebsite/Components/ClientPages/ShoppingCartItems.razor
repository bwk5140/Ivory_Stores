@page "/shoppingcart"

@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using System.Text.Json

@implements IAsyncDisposable

@inject ProtectedSessionStorage sessionStorage
@inject ApplicationUserService ApplicationUserService
@inject LayoutRefreshService RefreshService
@inject ShoppingCartService ShoppingCartService
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@inject IDbContextFactory<MethaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject IStringLocalizer<SharedResource> Loc
@inject LayoutState LayoutState
@inject IJSRuntime JS

@rendermode InteractiveServer

<PageTitle>Index</PageTitle>
@if (ShoppingCart is not null)
{
    <div class="container-xxl mt-5 mb-5">
        @if (ShoppingCart.ProductIds is null || !ShoppingCart.ProductIds.Any())
        {
            <div class="card" style="max-width: 1140px;">
                <div class="card-body">
                    <h4>@Loc["EmptyCart"]</h4>
                </div>
            </div>
        }
        else
        {
            @* if (ShippingAddressProblem)
            {
                if (ClientAddresses is null || !ClientAddresses.Any())
                {
                    <div class="card mt-2 mb-2" style="border-color: red; max-width: 1200px; color: red; border-left: 3px solid red;">
                        <div class="card-body" style="display: inline-block;">
                            <img src="info-circle.svg" /> @Loc["AddShippingAddress"]
                            <a class="mt-3" href="Addresses" style="text-decoration: none;">
                                @Loc["AddNewShippingAddress"]
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card mt-2 mb-2" style="border-color: red; max-width: 1200px; color: red; border-left: 3px solid red;">
                    <div class="card-body" style="display: inline-block;">
                            <img src="info-circle.svg" /> @Loc["SelectDefaultAddress"]
                        <a class="mt-3" href="Addresses" style="text-decoration: none;">
                                @Loc["SelectADefaultAddress"]
                        </a>
                    </div>
                </div>
                }
            } *@
            <div class="row">
                <div class="col-lg-9">
                    <div class="card mb-5">
                        <div class="card-body">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th style="padding-right: 40px;" scope="col">
                                            @Loc["ShoppingCart"]
                                        </th>
                                        <th style="padding-right: 40px;" scope="col">

                                        </th>
                                        <th style="text-align: right; color: gray;" scope="col">
                                            @Loc["Price"]
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (ShoppingCartProducts is not null && ShoppingCartProducts.Any())
                                    {
                                        foreach (var ShoppingCartProduct in ShoppingCartProducts)
                                        {
                                            if (ShoppingCartProduct is not null)
                                            {
                                                using var context = DbFactory.CreateDbContext();
                                                var product = context.Product.FirstOrDefault(p => p.Id == ShoppingCartProduct.ProductId);
                                                product.Images = context.ProductImage.Where(p => p.ProductColorGroupId == product.ProductColorGroupID).OrderBy(p => p.Created).ToList();
                                                SelectedProducts[product.Id] = true;
                                                if (product.Images.Count > 0)
                                                {
                                                    var Id = product.Id;
                                                    var CurrentImage = product.Images[0];
                                                    <tr>
                                                        <td>
                                                            <InputCheckbox @bind-Value="SelectedProducts[Id]" class="darker-border-checkbox form-check-input"
                                                                           @bind-Value:after="@(() => UpdateCart(product))" />
                                                            <a href="@($"product/details?id={product.Id}")" class="btn">
                                                                <img class="card-img-top" src="@(string.Format("data:image/jpg;base64,{0}", Convert.ToBase64String(CurrentImage.Image!)))"
                                                                     alt=@Loc["ProductImage"] style="width:300px; height:300px; object-fit:contain;" />
                                                            </a>
                                                        </td>
                                                        <td style="padding: 0px;">
                                                            <a class="mt-3" href="@($"product/details?id={product.Id}")" style="padding: 0px; display: -webkit-box; -webkit-line-clamp: 2;
                                                                -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis; text-decoration:none; color: black;">
                                                                <h5>@product.Name</h5>
                                                            </a>
                                                            <p class="mt-2" style="color: gray; font-size: smaller;">@Loc["ShipsFrom"]: @Loc["CompanyLogo"]</p>
                                                            <p style="font-size: smaller;">@product.DeliveryFee.ToString("C2") @Loc["Delivery"]</p>
                                                            <p>
                                                                <strong style="font-size: smaller;">@Loc["Color"]: </strong> @product.Color
                                                            </p>
                                                            <p>
                                                                <strong style="font-size: smaller;">@Loc["Size"]: </strong> @product.Size
                                                            </p>
                                                            <div class="btn-group" style="border: 2px solid #2f4f4f; border-radius: 20px;">
                                                                <button class="me-2" style="border-bottom-left-radius: 10px; border-top-left-radius: 10px; border: unset;"
                                                                        @onclick="@(() => RemoveProduct(ShoppingCartProduct))">
                                                                    <img src="dash.svg" />
                                                                </button>
                                                                <strong>@ShoppingCartProduct.Quantity</strong>
                                                                <button class="ms-2" style="border-bottom-right-radius: 10px; border-top-right-radius: 10px; border: unset;"
                                                                        @onclick="@(() => AddProduct(ShoppingCartProduct))">
                                                                    <img src="plus.svg" />
                                                                </button>
                                                            </div>
                                                        </td>
                                                        <td style="text-align: right; padding-left: 40px;">
                                                            <div class="mt-2">
                                                                <strong style="font-size: medium;">@product.Price.ToString("C2") </strong>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }

                                            }
                                        }
                                    }
                                </tbody>
                            </table>
                            <div style="text-align: right;">
                                @if (ShoppingCart is not null && ShoppingCart.ProductIds.Any())
                                {
                                    <div style="display: inline-block">
                                        @if (ShoppingCart.ProductIds.Count() == 1)
                                        {
                                            <h5 style="font-weight: 450;">@Loc["Subtotal"] (@ShoppingCart.ProductIds.Count() @Loc["Item"]):</h5>
                                        }
                                        else
                                        {
                                            <h5 style="font-weight: 450;">@Loc["Subtotal"] (@ShoppingCart.ProductIds.Count() @Loc["Items"]):</h5>
                                        }
                                    </div>
                                    <div style=" display: inline-block">
                                        <h5> @ShoppingCart.Subtotal.ToString("C2")</h5>
                                    </div>
                                }
                                else
                                {
                                    <h5 style="font-weight: 450;">@Loc["Subtotal"] (0 @Loc["Items"])</h5>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-3">
                    @if (ShoppingCart is not null && ShoppingCart.ProductIds.Any())
                    {
                        <div class="card" style="width: fit-content; text-wrap: nowrap;">
                            <div class="card-body">

                                <div style="display: inline-block">
                                    @if (ShoppingCart.ProductIds.Count() == 1)
                                    {
                                        <h5 style="font-weight: 450;">@Loc["Subtotal"] (@ShoppingCart.ProductIds.Count() @Loc["Item"]):</h5>
                                    }
                                    else
                                    {
                                        <h5 style="font-weight: 450;">@Loc["Subtotal"] (@ShoppingCart.ProductIds.Count() @Loc["Items"]):</h5>
                                    }
                                </div>
                                <div style=" display: inline-block">
                                    <h5>@ShoppingCart.Subtotal.ToString("C2")</h5>
                                </div>
                                <div class="mt-4 mb-3" style="text-align: center;">
                                    <button style="border-bottom-left-radius: 25px; border-top-left-radius: 25px; border-bottom-right-radius: 25px;
                                                                        border-top-right-radius: 25px; border: unset; background-color: #2f4f4f; color: white; padding: 10px; text-decoration: none;"
                                                                        @onclick="GoToCart">
                                        @Loc["ProceedToCheckout"]
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>

            </div>
        }

    </div>
}


@code {
    private ApplicationDbContext context = default!;
    private ApplicationUser? ApplicationUser { get; set; }
    private Address? DefaultAddress { get; set; }
    private List<Address>? ClientAddresses { get; set; }
    private ShoppingCart? ShoppingCart { get; set; }
    private bool ShippingAddressProblem { get; set; } = false;

    [Parameter]
    public List<ShoppingCartProduct>? ShoppingCartProducts { get; set; } = new List<ShoppingCartProduct>();

    [Parameter]
    public Dictionary<string, bool>? SelectedProducts { get; set; } = new ();

    [Parameter]
    public List<ProductImage>? Images { get; set; } = new List<ProductImage>();

    protected override async Task OnInitializedAsync()
    {
        LayoutState.SetBackground("bg-cart");
        context = DbFactory.CreateDbContext();

        ApplicationUser ??= await ApplicationUserService.GetApplicationUser();

        if (ApplicationUser is not null)
        {
            DefaultAddress = await context.Address.FirstOrDefaultAsync(a => a.Id == ApplicationUser.DefaultAddressId);
            ShoppingCart = await context.ShoppingCart.FirstOrDefaultAsync(s => s.UserId == ApplicationUser.Id);
            if (ShoppingCart is null)
            {
                ShoppingCart = ShoppingCartService.getShoppingCart();
            }

            foreach (var ShoppingCartProdId in ShoppingCart!.ProductIds)
            {
                var shoppingCartProduct = await context.ShoppingCartProduct.FirstOrDefaultAsync(sp => sp.Id == ShoppingCartProdId);
                if (!ShoppingCartProducts.Contains(shoppingCartProduct))
                {
                    ShoppingCartProducts.Add(shoppingCartProduct);
                }
            }
        }
        
        // if (ShoppingCartProducts is not null && ShoppingCartProducts.Any())
        // {
        //     foreach (var shoppingCartProduct in ShoppingCartProducts)
        //     {
        //         if (shoppingCartProduct is not null)
        //         {
        //             var product = await context.Product.FirstOrDefaultAsync(p => p.Id == shoppingCartProduct.ProductId);
        //             SelectedProducts[product.Id] = true;
        //             product.Images = context.ProductImage.Where(p => p.ProductColorGroupId == product.ProductColorGroupID).OrderBy(p => p.Created).ToList();
        //         } 
        //     }
        // }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && ApplicationUser is null)
        {
            var json = await JS.InvokeAsync<string>("cartStorage.loadCart", "Cart");
            if (!string.IsNullOrEmpty(json))
            {
                ShoppingCart = JsonSerializer.Deserialize<ShoppingCart>(json);
            }

            if (ShoppingCart is null)
                ShoppingCart = ShoppingCartService.getShoppingCart();
            foreach (var ShoppingCartProdId in ShoppingCart?.ProductIds)
            {
                var shoppingCartProduct = await context.ShoppingCartProduct.FirstOrDefaultAsync(sp => sp.Id == ShoppingCartProdId);
                if (!ShoppingCartProducts.Contains(shoppingCartProduct))
                {
                    ShoppingCartProducts.Add(shoppingCartProduct);
                }
            }
        }
        StateHasChanged();
    }
    private void UpdateCart(Product product)
    {

    }
    public async Task RemoveProduct(ShoppingCartProduct ShoppingCartProduct)
    {
        var context = await DbFactory.CreateDbContextAsync();

        if (ShoppingCart is null || ShoppingCartProduct is null)
            return;

        var product = await context.Product.FirstOrDefaultAsync(p => p.Id == ShoppingCartProduct.ProductId);
        if (ShoppingCart.Subtotal > 0)
            ShoppingCart.Subtotal -= product.Price;

        if (ShoppingCartProduct.Quantity > 1)
        {
            ShoppingCartProduct.Quantity--;

            // Remove product ID and update subtotal
            ShoppingCart.ProductIds?.Remove(ShoppingCartProduct.Id);
        }
        else
        {
            ShoppingCart.ProductIds?.Remove(ShoppingCartProduct.Id);
            context.ShoppingCartProduct.Remove(ShoppingCartProduct);
        }

        // Track changes
        context.Attach(ShoppingCartProduct).State = EntityState.Modified;

        if (ApplicationUser is not null)
            context.Attach(ShoppingCart).State = EntityState.Modified;

        // Save once after tracking all changes
        await context.SaveChangesAsync();

        // Fetch related cart products
        var shoppingCartProducts = await context.ShoppingCartProduct
            .Where(p => ShoppingCart.ProductIds!.Contains(p.Id))
            .Distinct()
            .ToListAsync();
        ShoppingCartProducts = shoppingCartProducts;
        if (ShoppingCartProducts is not null && ShoppingCartProducts.Any())
        {
            foreach (var _ShoppingCartProduct in ShoppingCartProducts)
            {
                product = await context.Product.FirstOrDefaultAsync(p => p.Id == _ShoppingCartProduct.ProductId);
                product.Images = context.ProductImage.Where(p => p.ProductColorGroupId == product.ProductColorGroupID).OrderBy(p => p.Created).ToList();
            }
        }
        StateHasChanged();
        TriggerLayoutRefresh();
    }
    public async Task AddProduct(ShoppingCartProduct ShoppingCartProduct)
    {
        var context = await DbFactory.CreateDbContextAsync();

        if (ShoppingCart is null || ShoppingCartProduct is null)
            return;

        var product = await context.Product.FirstOrDefaultAsync(p => p.Id == ShoppingCartProduct.ProductId);

        // Add product ID and update subtotal/quantity
        ShoppingCart.ProductIds.Add(ShoppingCartProduct.Id);
        ShoppingCart.Subtotal += product.Price;
        ShoppingCartProduct.Quantity++;

        // Track changes
        context.Attach(ShoppingCartProduct).State = EntityState.Modified;

        if (ApplicationUser is not null)
            context.Attach(ShoppingCart).State = EntityState.Modified;

        // Save all changes in one go
        await context.SaveChangesAsync();

        // Fetch related products without duplicates
        var shoppingCartProducts = await context.ShoppingCartProduct
            .Where(p => ShoppingCart.ProductIds!.Contains(p.Id))
            .Distinct()
            .ToListAsync();
        ShoppingCartProducts = shoppingCartProducts;
        if (ShoppingCartProducts is not null && ShoppingCartProducts.Any())
        {
            foreach (var shoppingCartProduct in ShoppingCartProducts)
            {
                product = await context.Product.FirstOrDefaultAsync(p => p.Id == shoppingCartProduct.ProductId);
                product.Images = context.ProductImage.Where(p => p.ProductColorGroupId == product.ProductColorGroupID).OrderBy(p => p.Created).ToList();
            }
        }
        StateHasChanged();
        TriggerLayoutRefresh();
    }
    public async ValueTask DisposeAsync() => await context.DisposeAsync();

    public async Task GoToCart()
    {
        if (ApplicationUser is not null)
        {
            DefaultAddress = await context.Address.FirstOrDefaultAsync(a => a.Id == ApplicationUser.DefaultAddressId);
            ClientAddresses = context.Address.Where(a => a.UserId == ApplicationUser.Id).ToList();
        }
        NavigationManager.NavigateTo("/Checkout");
        // if (DefaultAddress is not null)
        // {
        //     ShippingAddressProblem = false;
        //     NavigationManager.NavigateTo("/Checkout");
        // }
        // else
        // {
        //     ShippingAddressProblem = true;
        // }
    }
    private void TriggerLayoutRefresh()
    {
        RefreshService.RequestRefresh();
    }
