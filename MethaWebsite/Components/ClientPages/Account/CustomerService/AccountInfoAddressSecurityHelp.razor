@page "/Account/CustomerService/Account"
@using MethaWebsite.Components.Account
@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@using Microsoft.Extensions.Logging

@attribute [Authorize]

@inject IStringLocalizer<SharedResource> Loc
@inject ApplicationUserService ApplicationUserService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject LayoutState LayoutStateService
@inject IDbContextFactory<MethaWebsite.Data.Contexts.ApplicationDbContext> DbFactory

@rendermode InteractiveServer


<div class="container-xxl mt-5 mb-5" style="display: block; justify-content: center;">
    <div class="center-container">
        <div style="display: inline-block;">
            <div style="display: inline-block;">
                <svg width="80" height="80">
                    <circle cx="40" cy="40" r="20" fill="#277a7a" />
                    <text x="33" y="50" font-size="24" fill="white">1</text>
                </svg>
            </div>
            <div style="display: inline-block;">
                <h6 class="ms-1">@Loc["TellUsWhatYouNeedHelpWith"]</h6>
            </div>
            <div style="display: inline-block;">
                <svg width="163">
                    <line x1="15" y1="75" x2="175" y2="75" stroke="lightgrey" stroke-width="1" />
                </svg>
            </div>
        </div>
        <div style="display: inline-block;">
            <div style="display: inline-block;">
                <svg width="80" height="80">
                    <circle cx="40" cy="40" r="20" fill="#277a7a" />
                    <text x="33" y="50" font-size="24" fill="white">2</text>
                </svg>
            </div>
            <div style="display: inline-block;">
                <h6 class="ms-1">@Loc["DescribeWhatsGoingOn"]</h6>
            </div>
            <div style="display: inline-block;">
                <svg width="163">
                    <line x1="15" y1="75" x2="175" y2="75" stroke="lightgrey" stroke-width="1" />
                </svg>
            </div>
        </div>
        @if (!HelpContent["CheckLoginInfo"] && !HelpContent["UpdateAddress"] && !HelpContent["RequestMyData"] &&
                !HelpContent["ManageMyAccount"] && !HelpContent["CloseMyAccount"])
        {
            <div style="display: inline-block;">
                <div style="display: inline-block;">
                    <svg width="80" height="80">
                        <circle cx="40" cy="40" r="20" fill="gray" />
                        <circle cx="40" cy="40" r="19" fill="white" />
                        <text x="33" y="50" font-size="24" fill="gray">3</text>
                    </svg>
                </div>
                <div style="display: inline-block; color: gray;">
                    <h6 class="ms-1">@Loc["GetAnAnswer"]</h6>
                </div>
            </div>
        }
        else
        {
            if (!CheckLoginInfoHelp["PasswordEmailLogin"] && !CheckLoginInfoHelp["Manage2StepVerification"] && !CheckLoginInfoHelp["CloseMyAccount"] &&
            !UpdateAddressHelp["UpdateShippingAddress"] && !UpdateAddressHelp["UpdateBillingAddress"] && !HelpContent["RequestMyData"] && !HelpContent["CloseMyAccount"])
            {
                <div style="display: inline-block;">
                    <div style="display: inline-block;">
                        <svg width="80" height="80">
                            <circle cx="40" cy="40" r="20" fill="gray" />
                            <circle cx="40" cy="40" r="19" fill="white" />
                            <text x="33" y="50" font-size="24" fill="gray">3</text>
                        </svg>
                    </div>
                    <div style="display: inline-block; color: gray;">
                        <h6 class="ms-1">@Loc["GetAnAnswer"]</h6>
                    </div>
                </div>
            }
            else
            {
                <div style="display: inline-block;">
                    <div style="display: inline-block;">
                        <svg width="80" height="80">
                            <circle cx="40" cy="40" r="20" fill="#277a7a" />
                            <text x="33" y="50" font-size="24" fill="white">3</text>
                        </svg>
                    </div>
                    <div style="display: inline-block; color: black;">
                        <h6 class="ms-1">@Loc["GetAnAnswer"]</h6>
                    </div>
                </div>
            }
        }
    </div>
    <div class="center-container">
        <div class="card mb-3 me-4" style="max-width: 700px; padding: 0px;">
            <div class="card-body">
                <table>
                    <tbody>
                        <tr>
                            <td class="border-end" style="width: 25%; vertical-align: text-top;">
                                <div style="position: relative; width: 50px; height: 50px;">
                                    <svg style="position: absolute; top: 0; left: 0; z-index: 0;" width="50" height="50">
                                        <circle cx="25" cy="25" r="25" fill="#277a7a" />
                                    </svg>
                                    <img src="person-lock-CS.svg" style="position: absolute; top: 20%; left: 20%; z-index: 1; width: 30px; height: 30px;" />
                                </div>
                                <div style="font-weight: 600; text-decoration: none;">
                                    @Loc["AccountInfoAddressesSecurity"]
                                </div>
                            </td>
                            <td style="width: 75%;">
                                <div class="ms-4 me-4" style="vertical-align: text-top;">
                                    @if (!HelpContent["CheckLoginInfo"] && !HelpContent["UpdateAddress"] && !HelpContent["RequestMyData"]
                                                                        && !HelpContent["ManageMyAccount"] && !HelpContent["CloseMyAccount"])
                                    {
                                        <a href="/Account/CustomerService" style="text-decoration: none; color: black;">
                                            <img class="mb-1" src="chevron-left.svg" width="12" height="12" />
                                            @Loc["Back"]
                                        </a>
                                        <div>
                                            <strong>@Loc["PickWhatYouNeedHelpWith"]</strong>
                                        </div>
                                        <div class="card mt-4" style="cursor: pointer;" @onclick="@(e => HelpContent["CheckLoginInfo"] = true)">
                                            <div class="card-body">
                                                <div class="row">
                                                    <div class="col-sm-10" style="font-size: medium;">
                                                        @Loc["CheckLoginInfo"]
                                                    </div>
                                                    <div class="col-sm-2">
                                                        <img class="mb-1" src="chevron-right.svg" width="8" height="8" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="card mt-4" style="cursor: pointer;" @onclick="@(e => HelpContent["UpdateAddress"] = true)">
                                            <div class="card-body">
                                                <div class="row">
                                                    <div class="col-sm-10" style="font-size: medium;">
                                                        @Loc["UpdateAddress"]
                                                    </div>
                                                    <div class="col-sm-2">
                                                        <img class="mb-1" src="chevron-right.svg" width="8" height="8" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="card mt-4" style="cursor: pointer;" @onclick="@(e => HelpContent["RequestMyData"] = true)">
                                            <div class="card-body">
                                                <div class="row">
                                                    <div class="col-sm-10" style="font-size: medium;">
                                                        @Loc["RequestMyData"]
                                                    </div>
                                                    <div class="col-sm-2">
                                                        <img class="mb-1" src="chevron-right.svg" width="8" height="8" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="card mt-4" style="cursor: pointer;" @onclick="OnAccountSettingsClicked">
                                            <div class="card-body">
                                                <div class="row">
                                                    <div class="col-sm-10" style="font-size: medium;">
                                                        @Loc["ManageMyAccount"]
                                                    </div>
                                                    <div class="col-sm-2">
                                                        <img class="mb-1" src="chevron-right.svg" width="8" height="8" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="card mt-4" style="cursor: pointer;" @onclick="@(e => HelpContent["CloseMyAccount"] = true)">
                                            <div class="card-body">
                                                <div class="row">
                                                    <div class="col-sm-10" style="font-size: medium;">
                                                        @Loc["CloseMyAccount"]
                                                    </div>
                                                    <div class="col-sm-2">
                                                        <img class="mb-1" src="chevron-right.svg" width="8" height="8" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                    }
                                    else
                                    {
                                        if (HelpContent["CheckLoginInfo"])
                                        {
                                            if (!CheckLoginInfoHelp["PasswordEmailLogin"] && !CheckLoginInfoHelp["Manage2StepVerification"] && !CheckLoginInfoHelp["CloseMyAccount"])
                                            {
                                                <a style="text-decoration: none; color: black; cursor: pointer;" @onclick="@(e => HelpContent["CheckLoginInfo"] = false)">
                                                    <img class="mb-1" src="chevron-left.svg" width="12" height="12" />
                                                    @Loc["Back"]
                                                </a>
                                                <div>
                                                    <strong>@Loc["PickWhatYouNeedHelpWith"]</strong>
                                                </div>
                                                <div class="card mt-4" style="cursor: pointer;" @onclick="@(e => CheckLoginInfoHelp["PasswordEmailLogin"] = true)">
                                                    <div class="card-body">
                                                        <div class="row">
                                                            <div class="col-sm-10" style="font-size: medium;">
                                                                @Loc["PasswordEmailLogin"]
                                                            </div>
                                                            <div class="col-sm-2">
                                                                <img class="mb-1" src="chevron-right.svg" width="8" height="8" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="card mt-4" style="cursor: pointer;" @onclick="@(e => CheckLoginInfoHelp["Manage2StepVerification"] = true)">
                                                    <div class="card-body">
                                                        <div class="row">
                                                            <div class="col-sm-10" style="font-size: medium;">
                                                                @Loc["Manage2StepVerification"]
                                                            </div>
                                                            <div class="col-sm-2">
                                                                <img class="mb-1" src="chevron-right.svg" width="8" height="8" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="card mt-4" style="cursor: pointer;" @onclick="@(e => CheckLoginInfoHelp["CloseMyAccount"] = true)">
                                                    <div class="card-body">
                                                        <div class="row">
                                                            <div class="col-sm-10" style="font-size: medium;">
                                                                @Loc["CloseMyAccount"]
                                                            </div>
                                                            <div class="col-sm-2">
                                                                <img class="mb-1" src="chevron-right.svg" width="8" height="8" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                if (CheckLoginInfoHelp["PasswordEmailLogin"])
                                                {
                                                    <a style="text-decoration: none; color: black; cursor: pointer;" @onclick="@(e => CheckLoginInfoHelp["PasswordEmailLogin"] = false)">
                                                        <img class="mb-1" src="chevron-left.svg" width="12" height="12" />
                                                        @Loc["Back"]
                                                    </a>
                                                    <div>
                                                        <strong>@Loc["PasswordEmailLogin"]</strong>
                                                    </div>
                                                    <div class="mb-2 mt-3">
                                                        <p>
                                                            @Loc["YouCanUpdateNameEmailOrPassword"]
                                                        </p>
                                                    </div>
                                                    <div class="mt-4" style="text-align: center;">
                                                        <button type="submit" class="btn btn-primary" style="background-color: #2f4f4f;border-color:transparent; border-radius: 5px;" @onclick="OnAccountSettingsClicked">
                                                            @Loc["YourAccountSettings"]
                                                        </button>
                                                    </div>
                                                }
                                                if (CheckLoginInfoHelp["Manage2StepVerification"])
                                                {
                                                    <a style="text-decoration: none; color: black; cursor: pointer;" @onclick="@(e => CheckLoginInfoHelp["Manage2StepVerification"] = false)">
                                                        <img class="mb-1" src="chevron-left.svg" width="12" height="12" />
                                                        @Loc["Back"]
                                                    </a>
                                                    <div>
                                                        <strong>@Loc["Manage2StepVerification"]</strong>
                                                    </div>
                                                    <div class="mb-2 mt-3">
                                                        <p>
                                                            @Loc["YouCanUpdate2StepVerification"]
                                                        </p>
                                                    </div>
                                                    <div class="mt-4" style="text-align: center;">
                                                        <button type="submit" class="btn btn-primary" style="background-color: #2f4f4f;border-color:transparent; border-radius: 5px;" @onclick="OnManage2FAClicked">
                                                            @Loc["YourAccountSettings"]
                                                        </button>
                                                    </div>
                                                }
                                                if (CheckLoginInfoHelp["CloseMyAccount"])
                                                {
                                                    <a style="text-decoration: none; color: black; cursor: pointer;" @onclick="@(e => CheckLoginInfoHelp["CloseMyAccount"] = false)">
                                                        <img class="mb-1" src="chevron-left.svg" width="12" height="12" />
                                                        @Loc["Back"]
                                                    </a>
                                                    <div>
                                                        <strong>@Loc["CloseMyAccount"]</strong>
                                                    </div>
                                                    <div class="mb-2 mt-3">
                                                        <p>
                                                            @Loc["OnceYourAccountIsClosed"]
                                                        </p>
                                                    </div>
                                                    <div style="text-align: center;">
                                                        <a href=@($"/Account/2FAVerification?ReturnUrl={"Account/Manage/DeletePersonalData"}") type="button" class="btn btn-primary" style="background-color: #2f4f4f;border-color:transparent; border-radius: 5px;">
                                                            @Loc["CloseMyAccount"]
                                                        </a>
                                                    </div>
                                                    
                                                }
                                            }
                                        }
                                        if (HelpContent["UpdateAddress"])
                                        {
                                            if (!UpdateAddressHelp["UpdateShippingAddress"] && !UpdateAddressHelp["UpdateBillingAddress"])
                                            {
                                                <a style="text-decoration: none; color: black; cursor: pointer;" @onclick="@(e => HelpContent["UpdateAddress"] = false)">
                                                    <img class="mb-1" src="chevron-left.svg" width="12" height="12" />
                                                    @Loc["Back"]
                                                </a>
                                                <div>
                                                    <strong>@Loc["PickWhatYouNeedHelpWith"]</strong>
                                                </div>
                                                <div class="card mt-4" style="cursor: pointer;" @onclick="@(e => UpdateAddressHelp["UpdateShippingAddress"] = true)">
                                                    <div class="card-body">
                                                        <div class="row">
                                                            <div class="col-sm-10" style="font-size: medium;">
                                                                @Loc["UpdateShippingAddress"]
                                                            </div>
                                                            <div class="col-sm-2">
                                                                <img class="mb-1" src="chevron-right.svg" width="8" height="8" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="card mt-4" style="cursor: pointer;" @onclick="@(e => UpdateAddressHelp["UpdateBillingAddress"] = true)">
                                                    <div class="card-body">
                                                        <div class="row">
                                                            <div class="col-sm-10" style="font-size: medium;">
                                                                @Loc["UpdateBillingAddress"]
                                                            </div>
                                                            <div class="col-sm-2">
                                                                <img class="mb-1" src="chevron-right.svg" width="8" height="8" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                if (UpdateAddressHelp["UpdateShippingAddress"])
                                                {
                                                    <a style="text-decoration: none; color: black; cursor: pointer;" @onclick="@(e => UpdateAddressHelp["UpdateShippingAddress"] = false)">
                                                        <img class="mb-1" src="chevron-left.svg" width="12" height="12" />
                                                        @Loc["Back"]
                                                    </a>
                                                    <div>
                                                        <strong>@Loc["UpdateShippingAddress"]</strong>
                                                    </div>
                                                    <div class="mb-2 mt-3">
                                                        <p>
                                                            @Loc["YouCanUpdateShippingAddresses"]
                                                        </p>
                                                    </div>
                                                    <div class="mt-4" style="text-align: center;">
                                                        <button type="submit" class="btn btn-primary" style="background-color: #2f4f4f;border-color:transparent; border-radius: 5px;" @onclick="OnManageShippingAddressesClicked">
                                                            @Loc["ManageYourAddresses"]
                                                        </button>
                                                    </div>
                                                }
                                                if (UpdateAddressHelp["UpdateBillingAddress"])
                                                {
                                                    <a style="text-decoration: none; color: black; cursor: pointer;" @onclick="@(e => UpdateAddressHelp["UpdateBillingAddress"] = false)">
                                                        <img class="mb-1" src="chevron-left.svg" width="12" height="12" />
                                                        @Loc["Back"]
                                                    </a>
                                                    <div>
                                                        <strong>@Loc["UpdateBillingAddress"]</strong>
                                                    </div>
                                                    <div class="mb-2 mt-3">
                                                        <p>
                                                            @Loc["YouCanManageBillingInfo"]
                                                        </p>
                                                    </div>
                                                    <div class="mt-4" style="text-align: center;">
                                                        <button type="submit" class="btn btn-primary" style="background-color: #2f4f4f;border-color:transparent; border-radius: 5px;" @onclick="OnManageBillingAddressesClicked">
                                                            @Loc["ManagePayments"]
                                                        </button>
                                                    </div>
                                                }
                                            }
                                        }
                                        if (HelpContent["RequestMyData"])
                                        {
                                            <a style="text-decoration: none; color: black; cursor: pointer;" @onclick="@(e => HelpContent["RequestMyData"] = false)">
                                                <img class="mb-1" src="chevron-left.svg" width="12" height="12" />
                                                @Loc["Back"]
                                            </a>
                                            <div>
                                                <strong>@Loc["DataPrivacyConcerns"]</strong>
                                            </div>
                                            <div class="mb-2 mt-3">
                                                <p>
                                                    @Loc["YouCanRequestYourData"]
                                                </p>
                                            </div>
                                            
                                            <div class="mt-4" style="text-align: center;">
                                                <form action="Account/Manage/DownloadPersonalData" method="post">
                                                    <AntiforgeryToken />
                                                    <button class="btn btn-primary" style="background-color: #2f4f4f;
                                                                        border-color:transparent; border-radius: 5px;" type="submit">
                                                        @Loc["RequestMyDataLg"]
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                        if (HelpContent["CloseMyAccount"])
                                        {
                                            <a style="text-decoration: none; color: black; cursor: pointer;" @onclick="@(e => HelpContent["CloseMyAccount"] = false)">
                                                <img class="mb-1" src="chevron-left.svg" width="12" height="12" />
                                                @Loc["Back"]
                                            </a>
                                            <div>
                                                <strong>@Loc["DeleteDataCloseAccount"]</strong>
                                            </div>
                                            <div class="mb-2 mt-3">
                                                <p>
                                                    @Loc["ToSubmitACloseAccountRequest"]
                                                </p>
                                            </div>
                                            
                                            <div class="mt-4" style="text-align: center;">
                                                <button type="submit" class="btn btn-primary" style="background-color: #2f4f4f; border-color:transparent; border-radius: 5px;" @onclick="OnAccountSettingsClicked">
                                                    @Loc["ManageMyAccount"]
                                                </button>
                                            </div>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@code {

    private ApplicationUser? ApplicationUser { get; set; }

    [Parameter]
    public Dictionary<string, bool>? HelpContent { get; set; } = new();

    [Parameter]
    public Dictionary<string, bool>? CheckLoginInfoHelp { get; set; } = new();

    [Parameter]
    public Dictionary<string, bool>? UpdateAddressHelp { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        ApplicationUser ??= await ApplicationUserService.GetApplicationUser();
        LayoutStateService.SetBackground("customer-service");
        HelpContent["CheckLoginInfo"] = false;
        HelpContent["UpdateAddress"] = false;
        HelpContent["RequestMyData"] = false;
        HelpContent["ManageMyAccount"] = false;
        HelpContent["CloseMyAccount"] = false;
        CheckLoginInfoHelp["PasswordEmailLogin"] = false;
        CheckLoginInfoHelp["Manage2StepVerification"] = false;
        CheckLoginInfoHelp["CloseMyAccount"] = false;
        UpdateAddressHelp["UpdateShippingAddress"] = false;
        UpdateAddressHelp["UpdateBillingAddress"] = false;
    }
    private void OnAccountSettingsClicked()
    {
        NavigationManager.NavigateTo("/AccountSettings");
    }
    private void OnManage2FAClicked()
    {
        NavigationManager.NavigateTo($"/Account/2FAVerification?ReturnUrl={"/Account/Manage/TwoFactorAuthentication"}");
    }
    private void OnManageShippingAddressesClicked()
    {
        NavigationManager.NavigateTo("/Addresses");
    }
    private void OnManageBillingAddressesClicked()
    {
        NavigationManager.NavigateTo("/Account/Payments");
    }
}