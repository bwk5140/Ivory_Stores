@page "/Account/CustomerService/Orders/Product/ContactUs/Email"
@using System.ComponentModel.DataAnnotations

@inject IStringLocalizer<SharedResource> Loc
@inject LayoutState LayoutStateService
@inject NavigationManager NavigationManager
@inject ApplicationUserService ApplicationUserService
@inject EmailService EmailService
@inject IDbContextFactory<MethaWebsite.Data.Contexts.ApplicationDbContext> DbFactory

@rendermode InteractiveServer

<div class="container-xxl mt-5 mb-5">
    <div class="center-container mb-5">
        @if (ApplicationUser is not null && product is not null)
        {
            <div class="card me-4 mb-5" style="display: inline-block; min-width: 400px;">
                <div class="card-body">
                    <h6 class="mb-4">
                        @Loc["EmailUs"]
                    </h6>
                    <div>
                        <strong>
                            @Loc["Item"]
                        </strong>
                    </div>
                    @{
                        using var context = DbFactory.CreateDbContext();
                        product.Images = context.ProductImage.Where(p => p.ProductColorGroupId == product.ProductColorGroupID).OrderBy(p => p.Created).ToList();
                        var CurrentImage = product.Images[0];
                    }

                    <div class="row mt-3">
                        <div class="col-sm-3" style="padding: 0px;">
                            <img class="card-img-top" src="@(string.Format("data:image/jpg;base64,{0}", Convert.ToBase64String(CurrentImage.Image!)))"
                                 alt=@Loc["ProductImage"] style="width:100px; height:100px; object-fit:contain; vertical-align: central;" />
                        </div>
                        <div class="col-sm-7">
                            <div style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;text-overflow: ellipsis; ">
                                @product.Name
                            </div>
                            <div style="font-size: smaller;">
                                @product.Brand
                            </div>
                        </div>
                    </div>
                    <div class="mt-4">
                        <strong>
                            @Loc["Issue"]
                        </strong>
                    </div>
                    <div class="mb-3">
                        @Issue
                    </div>
                    <div>
                        <strong>
                            @Loc["TypeYourMessageBelow"]
                        </strong>
                    </div>
                    <div class="mb-3" style="display: inline-block;">
                        @Loc["From"]:
                    </div>
                    <div class="mb-3" style="display: inline-block;">
                        @ApplicationUser.Email
                    </div>
                    <EditForm method="post" Model="Input" OnValidSubmit="SendEmail" FormName="create" Enhance>
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" role="alert" />
                        <div class="form mb-3">
                            <InputTextArea id="email" @bind-Value="Input.Email" class="form-control" placeholder="@Loc["NeedHelpWith"]"
                                           style="height: 150px;" />
                            <ValidationMessage For="() => Input.Email" class="text-danger" />
                        </div>
                        <div class="mt-4" style="text-align: right;">
                            <button type="submit" class="btn btn-primary me-2" style="background-color: #2f4f4f; color: white;
                                                                          border-color:transparent; border-radius: 5px;">
                                @Loc["SendEmail"]
                            </button>
                            <button type="button" class="btn btn-primary" style="background-color: whitesmoke; color: black;
                                                                                  border-color:transparent; border-radius: 5px;" @onclick="OnCancelClicked">
                                @Loc["Cancel"]
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        }
        else
        {
            <div class="card" style="z-index: 1400;  max-width: 70px;"><div class="card-body"><div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span> </div></div></div>
        }
    </div>
</div>

@code {
    [Parameter]
    public string? Username { get; set; }

    [SupplyParameterFromQuery]
    public string? Id { get; set; }

    [Parameter]
    public Product? product { get; set; }

    private ApplicationUser? ApplicationUser { get; set; }

    [SupplyParameterFromQuery]
    private string? Issue { get; set; }

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    private RequestCallNow? RequestCallNowPopUp;

    protected override async Task OnInitializedAsync()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        LayoutStateService.SetBackground("customer-service");
        ApplicationUser = await ApplicationUserService.GetApplicationUser();
        product = await context.Product.FirstOrDefaultAsync(p => p.Id == Id);
    }
    private void OnRequestCallNowClicked()
    {
        RequestCallNowPopUp.Show();
    }
    private void OnCancelClicked()
    {
        NavigationManager.NavigateTo($"/Account/CustomerService/Orders/Product/ContactUs?Issue={Issue}&Id={product.Id}");
    }
    private async Task SendEmail()
    {
        await EmailService.SendEmailAsync("support@ivorystores.com", ApplicationUser.Email, Issue, Input.Email);
        NavigationManager.NavigateTo($"/Account/CustomerService/Orders/Product/ContactUs?Issue={Issue}&Id={product.Id}&Sent={true}");
    }
    private sealed class InputModel
    {
        [Required]
        public string Email { get; set; } = "";
    }
}
