@page "/Account/CustomerService/Orders/Product/ContactUs"

@inject IStringLocalizer<SharedResource> Loc
@inject LayoutState LayoutStateService
@inject NavigationManager NavigationManager
@inject ApplicationUserService ApplicationUserService
@inject IDbContextFactory<MethaWebsite.Data.Contexts.ApplicationDbContext> DbFactory

@rendermode InteractiveServer

<div class="container-xxl mt-5 mb-5">
    @if (CallRequested)
    {
        <div class="center-container mt-4">
            <div class="card mt-2 mb-2" style="border-color: green; max-width: 1200px; border-left: 3px solid green;">
                <div class="card-body">
                    <img src="check-circle-fill.svg" /> @Loc["CallRequestReceived"]
                </div>
            </div>
        </div>
    }
    @if (Sent)
    {
        <div class="center-container mt-4">
            <div class="card mt-2 mb-2" style="border-color: green; max-width: 1200px; border-left: 3px solid green;">
                <div class="card-body">
                    <img src="check-circle-fill.svg" /> @Loc["EmailSent"]
                </div>
            </div>
        </div>
    }
    <div class="center-container mt-4">
        <h5>@Loc["HowWouldYouLikeToContactUs"]</h5>
    </div>
    <div class="center-container mt-4 mb-5">
        <h6>@Loc["OurMessaginAssistantsCanHelp"]</h6>
    </div>
    <div class="center-container mb-5">
        <div class="card me-4 mb-5" style="display: inline-block; min-width: 400px;">
            <div class="card-body">
                <h5 class="ms-5">
                    @Loc["ChatWithAgent"]
                </h5>
                <div class="mt-4" style="text-align: center;">
                    <button type="submit" class="btn btn-primary" style="background-color: whitesmoke; color: black; width: 300px;
                                                                                            border-color:transparent; border-radius: 5px;" @onclick="OnConnectToAgentClicked">
                        @Loc["ConnectToAgent"]
                    </button>
                </div>
            </div>
        </div>
        <div class="card me-4 mb-5" style="display: inline-block; min-width: 400px;">
            <div class="card-body">
                <h5 class="ms-5">
                    @Loc["RequestCall"]
                </h5>
                <div class="mt-4" style="text-align: center;">
                    <button type="submit" class="btn btn-primary" style="background-color: whitesmoke; color: black; width: 300px;
                                                                                            border-color:transparent; border-radius: 5px;" @onclick="OnRequestCallNowClicked">
                        @Loc["RequestCallNow"]
                    </button>
                </div>
            </div>
        </div>
        @if (Id is not null)
        {
            <div class="card ms-4 mb-5" style="display: inline-block; min-width: 400px;">
                <div class="card-body">
                    <h5 class="ms-5">
                        @Loc["EmailUs"]
                    </h5>
                    <div class="mt-4" style="text-align: center;">
                        <button type="submit" class="btn btn-primary" style="background-color: whitesmoke; color: black; width: 300px;
                                                                                                border-color:transparent; border-radius: 5px;" @onclick="OnEmailUsClicked">
                            @Loc["SendUsAnEmail"]
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
<CascadingValue Value="Issue">
    <RequestCallNow @ref="RequestCallNowPopUp" OnCallRequested="CallRequest" />
</CascadingValue>

@code {
    [Parameter]
    public string? Username { get; set; }

    [SupplyParameterFromQuery]
    public string? Id { get; set; }

    private ApplicationUser? ApplicationUser { get; set; }

    [SupplyParameterFromQuery]
    private string? Issue { get; set; }

    [SupplyParameterFromQuery]
    private bool Sent { get; set; }

    private bool CallRequested = false;
    private Product? product { get; set; }
    private RequestCallNow? RequestCallNowPopUp;

    protected override async Task OnInitializedAsync()
    {
        LayoutStateService.SetBackground("customer-service");
        using var context = await DbFactory.CreateDbContextAsync();
        product = await context.Product.FirstOrDefaultAsync(p => p.Id == Id);
    }
    private void OnRequestCallNowClicked()
    {
        RequestCallNowPopUp.Show();
    }
    private void OnEmailUsClicked()
    {
        CallRequested = false;
        NavigationManager.NavigateTo($"/Account/CustomerService/Orders/Product/ContactUs/Email?Issue={Issue}&Id={product.Id}");
    }
    private void OnConnectToAgentClicked()
    {
        CallRequested = false;
        Sent = false;
        NavigationManager.NavigateTo($"/Account/CustomerService/Chat");
    }
    private void CallRequest()
    {
        CallRequested = true;
        Sent = false;
        StateHasChanged();
    }
}
