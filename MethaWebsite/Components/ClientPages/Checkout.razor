                            </table>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="col-sm-4">
                    <div class="card" style="position: fixed;">
                        <div class="card-body">
                            <div style="text-align: center;">
                                <button class="btn btn-primary me-2" style="background-color: #2f4f4f;
                                                       border-color:transparent; border-radius: 25px;" @onclick="HandlePayment" disabled="@isProcessing">
                                    @(isProcessing? Loc["Processing"] + "..." : Loc["PlaceOrder"])
                                </button>
                            </div>
                            <hr />
                            <table class="table table-borderless">
                                <tbody>
                                    <tr>
                                        <td>
                                            @if (ShoppingCartProducts is not null && ShoppingCartProducts.Any() && BuyNowProduct is null)
                                            {
                                                @if (@ShoppingCart.ProductIds.Count() <= 1)
                                                {
                                                    <div style="display: inline-block;">
                                                        @Loc["Item(caps)"] (1):
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div style="display: inline-block;">
                                                        @Loc["Items(caps)"] (@ShoppingCart.ProductIds.Count()):
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                if (BuyNowProduct is not null)
                                                {
                                                    @if (BuyNowProduct.Quantity <= 1)
                                                    {
                                                        <div style="display: inline-block;">
                                                            @Loc["Item(caps)"] (1):
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div style="display: inline-block;">
                                                            @Loc["Items(caps)"] (@BuyNowProduct.Quantity):
                                                        </div>
                                                    }
                                                }
                                            }
                                            
                                        </td>
                                        <td style="text-align: right;">
                                            @if (ShoppingCartProducts is not null && ShoppingCartProducts.Any() && BuyNowProduct is null)
                                            {
                                                <div>
