}

@code {
    private ApplicationDbContext context = default!;
    private ApplicationUser? ApplicationUser { get; set; }
    private CreditDebitCard? DefaultCreditDebitCard;
    private Mpesa? DefaultMpesaPaymentMethod;
    private ShoppingCart? ShoppingCart { get; set; }
    private bool AreAddressesVisible { get; set; }
    private bool isProcessing = false;
    private string? Status;
    private double OrderTotal { get; set; }
    private HttpResponseMessage responseMessage { get; set; }
    private string result { get; set; }
    private Order? Order { get; set; }
    private Transaction? Transaction{ get; set; }
    private bool ShippingAddressProblem = false;

    [Parameter]
    public List<Product>? Products { get; set; } = new List<Product>();
    [Parameter]
    public List<ShoppingCartProduct>? ShoppingCartProducts { get; set; } = new List<ShoppingCartProduct>();

    [Parameter]
    public ShoppingCartProduct? BuyNowProduct { get; set; }

    [Parameter]
    public Address? Address { get; set; }

    [Parameter]
    public List<CreditDebitCard>? CreditDebitCards { get; set; } = new List<CreditDebitCard>();

    [Parameter]
    public List<Mpesa>? MpesaPaymentMethods { get; set; } = new List<Mpesa>();

    [Parameter]
    public List<Address>? Addresses { get; set; }

    [SupplyParameterFromQuery]
    public string? Id { get; set; }

    private Dictionary<string, bool> radiosChecked = new();
    private ChangeBillingAddressPopOver? changeBillingAddressPopOver;
    private AddNewCard? AddNewDebitCredit;
    private AddNewMpesaPaymentMethod? AddNewMpesaPaymentMethod;
    private bool PaymentMethodProblem { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {
        if (CheckoutService.ShippingDistance != 0.0)
        {
            ShippingAddressProblem = true;
        }
        LayoutState.SetBackground("bg-checkout");
        context = DbFactory.CreateDbContext();
        
        ApplicationUser ??= await ApplicationUserService.GetApplicationUser();
        BuyNowProduct = await context.ShoppingCartProduct.FirstOrDefaultAsync(p => p.Id == Id);

        if (ApplicationUser is not null)
        {
            Addresses = context.Address.Where(a => a.UserId == ApplicationUser.Id).ToList();
            Address = await context.Address.FirstOrDefaultAsync(a => a.Id == ApplicationUser.DefaultAddressId);

            if (CheckoutService.ShippingAddress is null && Address is not null)
            {
                CheckoutService.ShippingAddress = Address;
            }
            if (CheckoutService.ShipTo is null && Address is not null)
            {
                CheckoutService.ShipTo = Address.Id;
            }
            CreditDebitCards = context.CreditDebitCard.Where(c => c.UserId == ApplicationUser.Id).ToList();
            MpesaPaymentMethods = context.Mpesa.Where(c => c.UserId == ApplicationUser.Id).ToList();
            ShoppingCart = await context.ShoppingCart.FirstOrDefaultAsync(s => s.UserId == ApplicationUser.Id);
            if (ShoppingCart is null)
            {
                ShoppingCart = ShoppingCartService.getShoppingCart();
            }
            foreach (var shoppingCartProductID in ShoppingCart!.ProductIds)
            {
                var shoppingCartProduct = await context.ShoppingCartProduct.FirstOrDefaultAsync(p => p.Id == shoppingCartProductID);

                if (!ShoppingCartProducts.Contains(shoppingCartProduct))
                {
                    ShoppingCartProducts.Add(shoppingCartProduct);
                }
            }
            foreach (var creditCard in CreditDebitCards)
            {
                if (creditCard.DefaultPaymentMethod)
                {
                    radiosChecked[creditCard.Id] = true;
                    DefaultCreditDebitCard = creditCard;
                }
                else
                {
                    radiosChecked[creditCard.Id] = false;
                }
            }
            foreach (var mpesaPaymentMethod in MpesaPaymentMethods)
            {
                if (mpesaPaymentMethod.DefaultPaymentMethod)
                {
                    radiosChecked[mpesaPaymentMethod.Id] = true;
                    DefaultMpesaPaymentMethod = mpesaPaymentMethod;
                }
                else
                {
                    radiosChecked[mpesaPaymentMethod.Id] = false;
                }
            }
        }
        else
        {
            ShoppingCart = ShoppingCartService.getShoppingCart();
            foreach (var shoppingCartProductID in ShoppingCart!.ProductIds)
            {
                var shoppingCartProduct = await context.ShoppingCartProduct.FirstOrDefaultAsync(p => p.Id == shoppingCartProductID);

                if (!ShoppingCartProducts.Contains(shoppingCartProduct))
                {
                    ShoppingCartProducts.Add(shoppingCartProduct);
                }
            }
        }
        if (BuyNowProduct is not null)
        {
            await AddToCart(BuyNowProduct);
        }
    }

    private async Task HandlePayment()
    {
        if (!ShippingAddressProblem)
        {
            isProcessing = true;
            using var context = await DbFactory.CreateDbContextAsync();
            var paymentMethodService = new Stripe.PaymentMethodService();
            var paymentMethod = await paymentMethodService.GetAsync(DefaultCreditDebitCard.PaymentMethodId);
            var customerId = paymentMethod.CustomerId;
            var chargeRequest = new
            {
                CustomerId = customerId,
                PaymentMethodId = paymentMethod.Id,
                Amount = OrderTotal
            };

            responseMessage = await Http.PostAsJsonAsync("/api/stripe/charge-saved-card", chargeRequest);

            if (responseMessage.IsSuccessStatusCode)
            {
                Order = new Order();
                Order.Amount = OrderTotal;
                Order.PaymentMethodId = CheckoutService.PaymentMethod.Id;
                Order.Date = DateTime.Now;
                Order.ShippingAdressId = CheckoutService.ShipTo;
                Order.ProductIds = new List<string>();
                Order.UserId = ApplicationUser.Id;
                Order.ShippingCosts = CheckoutService.Shipping;
                Transaction = new Transaction();
                Transaction.OrderId = Order.Id;
                Transaction.Vendor = Loc["CompanyLogo"];
                Transaction.Type = "Order";
                Transaction.UserId = ApplicationUser.Id;
                Transaction.Date = DateTime.Now;
                context.Transactions.Add(Transaction);
                var paymentResult = await responseMessage.Content.ReadFromJsonAsync<PaymentResult>();
                if (BuyNowProduct is null)
                {
                    foreach (var ShoppingCartProductId in ShoppingCart.ProductIds)
                    {
                        var ShoppingCartProduct = await context.ShoppingCartProduct.FirstOrDefaultAsync(sp => sp.Id == ShoppingCartProductId);
                        Order.ProductIds.Add(ShoppingCartProduct.ProductId);
                        await RemoveFromCart(ShoppingCartProduct);
                        context.ShoppingCartProduct.Remove(ShoppingCartProduct);
                        context.Attach(ShoppingCartProduct).State = EntityState.Modified;

                    }
                }
                else
                {
                    Order.ProductIds.Add(BuyNowProduct.ProductId);
                    await RemoveFromCart(BuyNowProduct);
                    context.ShoppingCartProduct.Remove(BuyNowProduct);
                    context.Attach(BuyNowProduct).State = EntityState.Modified;
                }
                context.Attach(ShoppingCart).State = EntityState.Modified;
                ShoppingCart.ProductIds.Clear();
                context.Order.Add(Order);
                await context.SaveChangesAsync();
                CheckoutService.PaymentMethod = null;
                CheckoutService.ShipTo = null;
                StateHasChanged();
                TriggerLayoutRefresh();
                isProcessing = false;
                if (BuyNowProduct is null && !ShoppingCart.ProductIds.Any())
                    NavigationManager.NavigateTo("Account/OrderComplete", true);
                else
                {
                    if (BuyNowProduct is not null)
                        NavigationManager.NavigateTo("Account/OrderComplete", true);
                }
            }
            else
            {
                CheckoutService.PaymentMethod = null;
                CheckoutService.ShipTo = null;
                var errorContent = await responseMessage.Content.ReadAsStringAsync();
                using JsonDocument doc = JsonDocument.Parse(errorContent);
                var summary = doc.RootElement
                                 .GetProperty("detail");
                isProcessing = false;
                NavigationManager.NavigateTo($"Account/OrderAbandoned?error={summary}", true);
            }
        }
    }
    public class PaymentResult
    {
        public string Status { get; set; }
        public string Id { get; set; }
        public long Amount { get; set; }
        public string Currency { get; set; }
    }


    private void ShowChangeBillingAddressPopOver()
    {
        changeBillingAddressPopOver.Show();
    }
    private void ApplySelectedPaymentMethod(CreditDebitCard CreditDebitCard, Dictionary<string, bool> radiosChecked)
    {
        radiosChecked[CreditDebitCard.Id] = true;
        DefaultCreditDebitCard = CreditDebitCard;
    }
    private void ApplySelectedPaymentMethod(Mpesa MpesaPaymentMethod, Dictionary<string, bool> radiosChecked)
    {
        radiosChecked[MpesaPaymentMethod.Id] = true;
    }
    private async Task ApplySelectedShipping()
    {
        switch (CheckoutService.ShippingType)
        {
            case "Fast":
                CheckoutService.FastShipping = CheckoutService.CalculateShippingCosts(CheckoutService.ShippingType);
                goto default;
            case "Standard":
                CheckoutService.StandardShipping = CheckoutService.CalculateShippingCosts(CheckoutService.ShippingType);
                goto default;
            case "Free Delivery":
                CheckoutService.Shipping = 0;
                break;
            default:
                CheckoutService.Shipping = CheckoutService.CalculateShippingCosts(CheckoutService.ShippingType);
                break;
        }
    }

    public async ValueTask DisposeAsync()
    {
        await context.DisposeAsync();
    }

    public void OnDebitCreditClicked()
    {
        AddNewDebitCredit.Show();
    }
    public void OnMpesaClicked()
    {
        AddNewMpesaPaymentMethod.Show();
    }
    public async Task RemoveProduct(ShoppingCartProduct ShoppingCartProduct)
    {
        var context = await DbFactory.CreateDbContextAsync();

        if (ShoppingCart is null || ShoppingCartProduct is null)
            return;

        var product = await context.Product.FirstOrDefaultAsync(p => p.Id == ShoppingCartProduct.ProductId);
        if (ShoppingCart.Subtotal > 0)
            ShoppingCart.Subtotal -= product.Price;

        if (ShoppingCartProduct.Quantity > 1)
        {
            ShoppingCartProduct.Quantity--;

            // Remove product ID
            ShoppingCart.ProductIds?.Remove(ShoppingCartProduct.Id);
            // Track changes
            context.Attach(ShoppingCartProduct).State = EntityState.Modified;
        }
        else
        {
            ShoppingCart.ProductIds?.Remove(ShoppingCartProduct.Id);
            context.ShoppingCartProduct.Remove(ShoppingCartProduct);
        }

        if (ApplicationUser is not null)
            context.Attach(ShoppingCart).State = EntityState.Modified;

        // Save once after tracking all changes
        await context.SaveChangesAsync();

        // Fetch related cart products
        var shoppingCartProducts = await context.ShoppingCartProduct
            .Where(p => ShoppingCart.ProductIds!.Contains(p.Id))
            .Distinct()
            .ToListAsync();
        ShoppingCartProducts = shoppingCartProducts;
        if (ShoppingCartProducts is not null && ShoppingCartProducts.Any())
        {
            foreach (var _ShoppingCartProduct in ShoppingCartProducts)
            {
                product = await context.Product.FirstOrDefaultAsync(p => p.Id == _ShoppingCartProduct.ProductId);
                product.Images = context.ProductImage.Where(p => p.ProductColorGroupId == product.ProductColorGroupID).OrderBy(p => p.Created).ToList();
            }
        }
        StateHasChanged();
        TriggerLayoutRefresh();
        if (BuyNowProduct is null)
        {
            if (!ShoppingCart.ProductIds.Any())
            {
                NavigationManager.NavigateTo("shoppingcart", true);
                CheckoutService = new CheckoutService(Localizer);
            }
        }
        else
        {
            if (BuyNowProduct.Quantity == 1)
            {
                NavigationManager.NavigateTo("shoppingcart", true);
                CheckoutService = new CheckoutService(Localizer);
            }
        }
    }
    public async Task RemoveFromCart(ShoppingCartProduct ShoppingCartProduct)
    {
        var context = await DbFactory.CreateDbContextAsync();

        if (ShoppingCart is null || ShoppingCartProduct is null)
            return;

        var product = await context.Product.FirstOrDefaultAsync(p => p.Id == ShoppingCartProduct.ProductId);

        if (ShoppingCart.Subtotal > 0)
            ShoppingCart.Subtotal -= product.Price * ShoppingCartProduct.Quantity;

        ShoppingCartProduct.Quantity = 0;

    }
    public async Task AddToCart(ShoppingCartProduct ShoppingCartProduct)
    {
        using var context = await DbFactory.CreateDbContextAsync();
        if (ShoppingCart is null || ShoppingCartProduct is null)
            return;
        var product = await context.Product.FirstOrDefaultAsync(p => p.Id == ShoppingCartProduct.ProductId);

        if (!ShoppingCart.ProductIds.Contains(ShoppingCartProduct.Id))
        {
            // Add product ID and update subtotal/quantity
            ShoppingCart.Subtotal += product.Price;
            ShoppingCart.ProductIds.Add(ShoppingCartProduct.Id);

            if (ApplicationUser is not null)
            {
                context.Attach(ShoppingCart).State = EntityState.Modified;
                await context.SaveChangesAsync();
            }
            // Fetch related products without duplicates
            var shoppingCartProducts = await context.ShoppingCartProduct
                .Where(p => ShoppingCart.ProductIds!.Contains(p.Id))
                .Distinct()
                .ToListAsync();
            ShoppingCartProducts = shoppingCartProducts;
            if (ShoppingCartProducts is not null && ShoppingCartProducts.Any())
            {
                foreach (var shoppingCartProduct in ShoppingCartProducts)
                {
                    product = await context.Product.FirstOrDefaultAsync(p => p.Id == shoppingCartProduct.ProductId);
                    product.Images ??= context.ProductImage.Where(p => p.ProductColorGroupId == product.ProductColorGroupID).OrderBy(p => p.Created).ToList();
                }
            }
        }
        StateHasChanged();
        TriggerLayoutRefresh();
    }
    public async Task AddProduct(ShoppingCartProduct ShoppingCartProduct)
    {
        var context = await DbFactory.CreateDbContextAsync();

        if (ShoppingCart is null || ShoppingCartProduct is null)
            return;

        var product = await context.Product.FirstOrDefaultAsync(p => p.Id == ShoppingCartProduct.ProductId);

        // Add product ID and update subtotal/quantity
        ShoppingCart.ProductIds.Add(ShoppingCartProduct.Id);
        ShoppingCart.Subtotal += product.Price;
        ShoppingCartProduct.Quantity++;

        // Track changes
        context.Attach(ShoppingCartProduct).State = EntityState.Modified;

        if (ApplicationUser is not null)
            context.Attach(ShoppingCart).State = EntityState.Modified;

        // Save all changes in one go
        await context.SaveChangesAsync();

        // Fetch related products without duplicates
        var shoppingCartProducts = await context.ShoppingCartProduct
            .Where(p => ShoppingCart.ProductIds!.Contains(p.Id))
            .Distinct()
            .ToListAsync();
        ShoppingCartProducts = shoppingCartProducts;
        if (ShoppingCartProducts is not null && ShoppingCartProducts.Any())
        {
            foreach (var shoppingCartProduct in ShoppingCartProducts)
            {
                product = await context.Product.FirstOrDefaultAsync(p => p.Id == shoppingCartProduct.ProductId);
                product.Images = context.ProductImage.Where(p => p.ProductColorGroupId == product.ProductColorGroupID).OrderBy(p => p.Created).ToList();
            }
        }
        StateHasChanged();
        TriggerLayoutRefresh();
    }
    private void TriggerLayoutRefresh()
    {
        RefreshService.RequestRefresh();
    }
    private async Task SetPaymentMethod()
    {
        if (DefaultCreditDebitCard is not null)
        {
            if (radiosChecked[DefaultCreditDebitCard.Id])
            {
                CheckoutService.PaymentMethod = DefaultCreditDebitCard;
            }
            PaymentMethodProblem = false;
        }
        else if (DefaultMpesaPaymentMethod is not null)
        {
            if (radiosChecked[DefaultMpesaPaymentMethod.Id])
            {
                CheckoutService.PaymentMethod = DefaultMpesaPaymentMethod;
            }
            PaymentMethodProblem = false;
        }
        else
        {
            PaymentMethodProblem = true;
            return;
        }
        if (CheckoutService.ShippingDistance <= 0)
        {
            CheckoutService.ShippingDistance = await GetShippingDistance();
        }
        CheckoutService.FastShipping = CheckoutService.CalculateShippingCosts(Loc["Fast"]);
        CheckoutService.Shipping = CheckoutService.CalculateShippingCosts(CheckoutService.ShippingType);
        CheckoutService.StandardShipping = CheckoutService.CalculateShippingCosts(Loc["Standard"]);
        StateHasChanged();
    }
    private async Task<double> GetShippingDistance()
    {
        var distance = await ShippingService.GetDistance(Address);
        return distance;
    }
    private async Task OnSave()
    {
        AreAddressesVisible = false;
        using var context = await DbFactory.CreateDbContextAsync();
        Address = await context.Address.FirstOrDefaultAsync(a => a.Id == CheckoutService.ShipTo);
        CheckoutService.ShippingAddress = Address;
        CheckoutService.ShippingDistance = await GetShippingDistance();
        if (CheckoutService.ShippingDistance != 0.0)
        {
            CheckoutService.FastShipping = CheckoutService.CalculateShippingCosts(Loc["Fast"]);
            CheckoutService.Shipping = CheckoutService.CalculateShippingCosts(CheckoutService.ShippingType);
            CheckoutService.StandardShipping = CheckoutService.CalculateShippingCosts(Loc["Standard"]);
            ShippingAddressProblem = false;
        }
        else
        {
            ShippingAddressProblem = true;
        }
    }
    private void UpdateCards()
    {
        var creditDebitCards = context.CreditDebitCard.Where(c => c.UserId == ApplicationUser.Id).ToList();
        foreach (var paymentMethod in creditDebitCards)
        {
            if (!CreditDebitCards.Contains(paymentMethod))
            {
                CreditDebitCards.Add(paymentMethod);
                DefaultCreditDebitCard = paymentMethod;
                radiosChecked[DefaultCreditDebitCard.Id] = true;
                break;
            }
        }
        StateHasChanged();
    }
    private void UpdateMpesaPaymentMethods()
    {
        var mpesaPaymentMethods = context.Mpesa.Where(c => c.UserId == ApplicationUser.Id).ToList();
        foreach (var paymentMethod in mpesaPaymentMethods)
        {
            if (!MpesaPaymentMethods.Contains(paymentMethod))
            {
                MpesaPaymentMethods.Add(paymentMethod);
                DefaultMpesaPaymentMethod = paymentMethod;
                radiosChecked[DefaultMpesaPaymentMethod.Id] = true;
                break;
            }
        }
        StateHasChanged();
    }
}