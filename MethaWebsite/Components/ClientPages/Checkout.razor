@page "/Checkout"

@using MethaWebsite.Components.Account.Pages.Payments.CreditDebitCardPages
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid

@implements IAsyncDisposable

@inject IJSRuntime JS
@inject HttpClient Http
@inject LayoutState LayoutState
@inject CheckoutService CheckoutService
@inject ProtectedSessionStorage sessionStorage
@inject ApplicationUserService ApplicationUserService
@inject LayoutRefreshService RefreshService
@inject ShoppingCartService ShoppingCartService
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@inject ShippingService ShippingService
@inject IDbContextFactory<MethaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject IStringLocalizer<SharedResource> Loc
@inject IStringLocalizer<CheckoutService> Localizer

@rendermode InteractiveServer

<PageTitle>Index</PageTitle>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark top-row">
    <a class="navbar-brand ms-2" href="/">@Loc["CompanyLogo"]</a>
    <div class="container-fluid" style="display: flex; justify-content:center;">
        <h4>@Loc["Checkout"]</h4>
    </div>
</nav>
@if (Address is null || CreditDebitCards is null || MpesaPaymentMethods is null)
{
    <div class="card" style="z-index: 1400;  max-width: 70px;"><div class="card-body"><div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span> </div></div></div>
}
else
{
    <div class="container-xxl mt-5 mb-5">
        <div class="row">
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-body">
                        <table class="table table-borderless">
                            <tbody>
                                <tr>
                                    <td>
                                        <h5>@Loc["DeliveringTo"] @Address.FullName</h5>
                                    </td>
                                    <td style="text-align: right;">
                                        <button class="btn btn-link" type="button" style="border: none; background-color: transparent;
                                                       padding:0px; text-decoration: none;" @onclick="ShowChangeBillingAddressPopOver">
                                            @Loc["Change"]
                                        </button>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        @Address.AddressLine1 @Address.AddressLine2, @Address.City @Address.State, @Address.ZipCode, @Address.Country
                                    </td>
                                    <td>
                                        
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <a href="" style="text-decoration: none;">@Loc["AddDeliveryInstructions"]</a>
                                    </td>
                                    <td>
                                        
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                @if (CheckoutService.PaymentMethod is null)
                {
                    <div class="card mt-4">
                        <div class="card-header" style="border: none; background-color: transparent;">
                            <h4>@Loc["PaymentMethod"]</h4>
                        </div>
                        <div class="card-body">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th style="padding-right: 40px;" scope="col">
                                            @Loc["YourCreditDebitCards"]
                                        </th>
                                        <th style="padding-right: 40px;" scope="col">
                                            @Loc["NameOnCard"]
                                        </th>
                                        <th style="text-align: right; color: gray;" scope="col">
                                            @Loc["ExpiresOn"]
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (CreditDebitCards is not null && CreditDebitCards.Any())
                                    {
                                        foreach (var creditdebitcard in CreditDebitCards)
                                        {
                                            <tr>
                                                <td>
                                                    <div style="display: inline-block; text-wrap: nowrap;">
                                                        <div style="display: inline-block;">
                                                            <input class="form-check-input me-1 mb-1" type="radio" name="listGroupRadio" value="creditdebitcard"
                                                                   id="culture" @onclick="@(() => ApplySelectedPaymentMethod(creditdebitcard, radiosChecked))"
                                                                   checked=@radiosChecked[creditdebitcard.Id]>
                                                        </div>
                                                        <div class="mb-3" style="display: inline-block">
                                                            <svg width="75" height="32.5" xmlns="http://www.w3.org/2000/svg">
                                                                <image href="@creditdebitcard.ImageSource" width="75" height="32.5" />

                                                                <image href="@creditdebitcard.LogoSource" x="45" y="20" width="15" height="7.5" />
                                                            </svg>
                                                        </div>
                                                        <div style="display: inline-block">
                                                            <strong>@creditdebitcard.Type</strong>
                                                            <div>
                                                            </div>
                                                        </div>
                                                        <div style="display: inline-block">
                                                            @Loc["EndingIn"]
                                                        </div>
                                                        <div style="display: inline-block; width: 30px;">
                                                            @creditdebitcard.CardNumber.Substring(creditdebitcard.CardNumber.Length - 4, 4)
                                                        </div>
                                                    </div>
                                                </td>
                                                <td style="padding: 0px;">
                                                    <p class="ms-2">
                                                        @creditdebitcard.NameOnCard
                                                    </p>
                                                </td>
                                                <td style="text-align: right; padding-left: 40px;">
                                                    <div class="mt-2">
                                                        @if ((creditdebitcard.ExpirationMonth < CheckoutService.CurrentMonth && creditdebitcard.ExpirationYear < CheckoutService.CurrentYear)
                                                                                                || creditdebitcard.ExpirationYear < CheckoutService.CurrentYear)
                                                        {
                                                            <p class="text-danger">@Loc["ExpiredOn"] @creditdebitcard.ExpirationMonth/@creditdebitcard.ExpirationYear</p>
                                                            <div class="mt-4"><a href="">@Loc["Update"]</a></div>
                                                        }
                                                        else
                                                        {
                                                            <p class="text-info">@Loc["ExpiresOn"] @creditdebitcard.ExpirationMonth/@creditdebitcard.ExpirationYear</p>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    <tr>
                                        <td>
                                            <div style="display: inline-block; text-wrap: nowrap;">
                                                <div style="display: inline-block; padding: 0px;">
                                                    <image src="plus.svg" width="75" height="32.5" style="margin-left: -30px;" />
                                                </div>
                                                <div class="mb-3" style="display: inline-block; padding: 0px;">
                                                    <svg width="75" height="32.5" xmlns="http://www.w3.org/2000/svg" style="margin-left: -26px;">
                                                        <image href="generic_card_visa.svg" width="75" height="32.5" />

                                                        <image href="visa.svg" x="45" y="20" width="15" height="7.5" />
                                                    </svg>
                                                </div>
                                                <div style="display: inline-block">
                                                    <button class="btn btn-link" style="border: none; background-color: transparent;
                                                                                text-decoration: none;  padding: 0px;"
                                                            @onclick="OnDebitCreditClicked">
                                                        @Loc["AddCreditOrDebit"]
                                                    </button>
                                                    <div>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                        </td>
                                        <td>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th style="padding-right: 40px;" scope="col">
                                            Mpesa
                                        </th>
                                        <th style="padding-right: 40px;" scope="col">

                                        </th>
                                        <th style="text-align: right; color: gray;" scope="col">
                                            @Loc["RegisteredName"]
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (MpesaPaymentMethods is not null && MpesaPaymentMethods.Any())
                                    {
                                        foreach (var MpesaPaymentMethod in MpesaPaymentMethods)
                                        {
                                            <tr>
                                                <td>
                                                    <div style="display: inline-block; text-wrap: nowrap;">
                                                        <div style="display: inline-block;">
                                                            <input class="form-check-input me-1 mb-1" type="radio" name="listGroupRadio" value="MpesaPaymentMethod"
                                                                   id="culture" @onclick="@(() => ApplySelectedPaymentMethod(MpesaPaymentMethod, radiosChecked))"
                                                                   checked=@radiosChecked[MpesaPaymentMethod.Id]>
                                                        </div>
                                                        <div class="mb-3 ms-2 me-2" style="display: inline-block;">
                                                            <svg width="52" height="32.5" xmlns="http://www.w3.org/2000/svg">
                                                                <image href="@MpesaPaymentMethod.ImageSource" width="52" height="32.5" />

                                                                <image href="@MpesaPaymentMethod.LogoSource" x="5" y="4" width="40" height="25" />
                                                            </svg>
                                                        </div>
                                                        <div style="display: inline-block">
                                                            <strong>@MpesaPaymentMethod.Type</strong>
                                                        </div>
                                                        <div style="display: inline-block">
                                                            @Loc["Phone"] @Loc["EndingIn"]
                                                        </div>
                                                        <div style="display: inline-block; width: 30px;">
                                                            @MpesaPaymentMethod.PhoneNumber.Substring(MpesaPaymentMethod.PhoneNumber.Length - 4, 4)
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                </td>
                                                <td style="text-align: right; padding-left: 40px;">
                                                    <div class="mt-2">
                                                        <p>
                                                            @MpesaPaymentMethod.RegisteredName
                                                        </p>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    <tr>
                                        <td>
                                            <div style="display: inline-block; text-wrap: nowrap;">
                                                <div style="display: inline-block; padding: 0px;">
                                                    <image src="plus.svg" width="75" height="32.5" style="margin-left: -30px; padding: 0px;" />
                                                </div>
                                                <div class="mb-3 me-2" style="display: inline-block; padding: 0px;">
                                                    <svg width="52" height="32.5" xmlns="http://www.w3.org/2000/svg" style="margin-left: -18px;">
                                                        <image href="generic_mpesa_card.svg" width="52" height="32.5" />

                                                        <image href="Mpesa.svg" x="5" y="4" width="40" height="25" />
                                                    </svg>
                                                </div>
                                                <div style="display: inline-block">
                                                    <button class="btn btn-link" style="border: none; background-color: transparent;
                                                                            text-decoration: none; padding: 0px;"
                                                            @onclick="OnMpesaClicked">
                                                        @Loc["AddMpesaPayment"]
                                                    </button>
                                                    <div>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                        </td>
                                        <td>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <div style="text-align: left;">
                                @if (DefaultCreditDebitCard is not null && ((DefaultCreditDebitCard.ExpirationMonth < CheckoutService.CurrentMonth
                                                        && DefaultCreditDebitCard.ExpirationYear < CheckoutService.CurrentYear) || DefaultCreditDebitCard.ExpirationYear < CheckoutService.CurrentYear))
                                {
                                    <button class="btn btn-primary me-2" disabled style="background-color: #2f4f4f;
                                                                                                                border-color:transparent; border-radius: 25px;">
                                        @Loc["UseThisPayment"]
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-primary me-2" @onclick="SetPaymentMethod" style="background-color: #2f4f4f;
                                                                                                                border-color:transparent; border-radius: 25px;">
                                        @Loc["UseThisPayment"]
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="card mt-4 mb-5">
                        <div class="card-body">
                            @Loc["ReviewItemsAndShipping"]
                        </div>
                    </div>
                }
                else
                {
                    <div class="card mt-4 mb-4">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-5">
                                    <strong>
                                        @Loc["PayingWith"] @CheckoutService.PaymentMethod.Type
                                    </strong>
                                    <strong>
                                        @if (CheckoutService.PaymentMethod is CreditDebitCard)
                                        {
                                            @DefaultCreditDebitCard.CardNumber.Substring(DefaultCreditDebitCard.CardNumber.Length - 4, 4)
                                        }
                                    </strong>
                                </div>
                                <div class="col-lg-7" style="text-align: right;">
                                    <button class="btn btn-link" type="button" style="border: none; background-color: transparent;
                                                                               text-decoration: none;" @onclick="e => CheckoutService.PaymentMethod = null">
                                        @Loc["Change"]
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-body">
                            <table>
                                <tbody>
                                    @if (ShoppingCartProducts is not null && ShoppingCartProducts.Any() && BuyNowProduct is null)
                                    {
                                        foreach (var ShoppingCartProduct in ShoppingCartProducts)
                                        {
                                            using var context = DbFactory.CreateDbContext();
                                            var product = context.Product.FirstOrDefault(p => p.Id == ShoppingCartProduct.ProductId);
                                            product.Images = context.ProductImage.Where(p => p.ProductColorGroupId == product.ProductColorGroupID).OrderBy(p => p.Created).ToList();
                                            product.DeliveryFee = CheckoutService.Shipping;
                                            if (product.Images is not null && product.Images.Any())
                                            {
                                                var Id = product.Id;
                                                var CurrentImage = product.Images[0];
                                                <tr>
                                                    <td>
                                                        <div class="card mb-3" style="border: none; background-color: lightgray;">
                                                            <div class="card-body">
                                                                <div class="row">
                                                                    <div class="col-sm-5">
                                                                        <a href="@($"product/details?id={product.Id}")" class="btn">
                                                                            <img class="card-img-top" src="@(string.Format("data:image/jpg;base64,{0}", Convert.ToBase64String(CurrentImage.Image!)))"
                                                                                 alt=@Loc["ProductImage"] style="width:150px; height:150px; object-fit:contain;" />
                                                                        </a>
                                                                    </div>
                                                                    <div class="col-sm-7">
                                                                        <a class="mt-3" href="@($"product/details?id={product.Id}")" style="padding: 0px; text-decoration:none;
                                                                                                            color: black;">
                                                                            <p>@product.Name</p>
                                                                        </a>
                                                                        <p style="font-size: smaller;"><strong>@product.Price.ToString("C2")</strong></p>
                                                                        <p style="font-size: smaller;">
                                                                            @Loc["ShipsFrom"] @Loc["CompanyLogo"]
                                                                        </p>
                                                                        <p style="font-size: smaller;">
                                                                            @Loc["SoldBy"] @Loc["CompanyLogo"]
                                                                        </p>
                                                                        <div class="btn-group" style="border: 2px solid #2f4f4f; border-radius: 20px; background-color: white;">
                                                                            <button class="me-2" style="border-bottom-left-radius: 10px; border-top-left-radius: 10px; border: unset;"
                                                                                    @onclick="@(() => RemoveProduct(ShoppingCartProduct))">
                                                                                <img src="dash.svg" />
                                                                            </button>
                                                                            <strong style="background-color: white;">@ShoppingCartProduct.Quantity</strong>
                                                                            <button class="ms-2" style="border-bottom-right-radius: 10px; border-top-right-radius: 10px; border: unset;"
                                                                                    @onclick="@(() => AddProduct(ShoppingCartProduct))">
                                                                                <img src="plus.svg" />
                                                                            </button>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        @if (ShoppingCartProducts.IndexOf(ShoppingCartProduct) == 0)
                                                        {
                                                            <div class="card" style="border: none; text-wrap: nowrap;">
                                                                <div class="card-body">
                                                                    <InputRadioGroup Name="Shipping" @bind-Value="CheckoutService.ShippingType" @bind-Value:after="ApplySelectedShipping">
                                                                        <div class="mt-3">
                                                                            <div>
                                                                                <InputRadio Name="Shipping" class="form-check-input me-1" type="radio" Value="CheckoutService.FreeShipping"
                                                                                            id="culture" />
                                                                                <strong>@Loc["FreeDelivery"]</strong> @CheckoutService.ShippingDays["Free"], @CheckoutService.ShippingMonths["Free"] @CheckoutService.ShippingDates["Free"]
                                                                            </div>
                                                                        </div>
                                                                        <div class="mt-3">
                                                                            <div style="display: inline-block;">
                                                                                <InputRadio Name="Shipping" class="form-check-input me-1" type="radio" Value="CheckoutService.StandardShippng"
                                                                                            id="culture" />
                                                                                <strong>@Loc["Standard"]</strong> @CheckoutService.ShippingDays["Standard"], @CheckoutService.ShippingMonths["Standard"]
                                                                                @CheckoutService.ShippingDates["Standard"]
                                                                            </div>
                                                                            <div style="display: inline-block; text-align: right;">
                                                                                <p style="font-size: smaller;">@CheckoutService.StandardShipping.ToString("C2")</p>
                                                                            </div>
                                                                        </div>
                                                                        <div>
                                                                            <div style="display: inline-block;">
                                                                                <InputRadio Name="Shipping" class="form-check-input me-1" type="radio" Value="CheckoutService.FastShippng"
                                                                                            id="culture" />
                                                                                <strong>@Loc["Fast"]</strong> @CheckoutService.ShippingDays["Fast"], @CheckoutService.ShippingMonths["Fast"] @CheckoutService.ShippingDates["Fast"]
                                                                            </div>
                                                                            <div style="display: inline-block; text-align: right;">
                                                                                <p style="font-size: smaller;">@CheckoutService.FastShipping.ToString("C2")</p>
                                                                            </div>
                                                                        </div>
                                                                    </InputRadioGroup>
                                                                </div>
                                                            </div>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    }
                                    else
                                    {
                                        if (BuyNowProduct is not null)
                                        {
                                            using var context = DbFactory.CreateDbContext();
                                            var product = context.Product.FirstOrDefault(p => p.Id == BuyNowProduct.ProductId);
                                            product.Images = context.ProductImage.Where(p => p.ProductColorGroupId == product.ProductColorGroupID).OrderBy(p => p.Created).ToList();
                                            product.DeliveryFee = CheckoutService.Shipping;
                                            if (product.Images is not null && product.Images.Any())
                                            {
                                                var Id = product.Id;
                                                var CurrentImage = product.Images[0];
                                                <tr>
                                                    <td>
                                                        <div class="card mb-3" style="border: none; background-color: whitesmoke;">
                                                            <div class="card-body">
                                                                <div class="row">
                                                                    <div class="col-sm-5">
                                                                        <a href="@($"product/details?id={product.Id}")" class="btn">
                                                                            <img class="card-img-top" src="@(string.Format("data:image/jpg;base64,{0}", Convert.ToBase64String(CurrentImage.Image!)))"
                                                                                 alt=@Loc["ProductImage"] style="width:150px; height:150px; object-fit:contain;" />
                                                                        </a>
                                                                    </div>
                                                                    <div class="col-sm-7">
                                                                        <a class="mt-3" href="@($"product/details?id={product.Id}")" style="padding: 0px; text-decoration:none;
                                                                                                                                                color: black;">
                                                                            <p>@product.Name</p>
                                                                        </a>
                                                                        <p style="font-size: smaller;"><strong>@product.Price.ToString("C2")</strong></p>
                                                                        <p style="font-size: smaller;">
                                                                            @Loc["ShipsFrom"] @Loc["CompanyLogo"]
                                                                        </p>
                                                                        <p style="font-size: smaller;">
                                                                            @Loc["SoldBy"] @Loc["CompanyLogo"]
                                                                        </p>
                                                                        <div class="btn-group" style="border: 2px solid #2f4f4f; border-radius: 20px; background-color: white;">
                                                                            <button class="me-2" style="border-bottom-left-radius: 10px; border-top-left-radius: 10px; border: unset;"
                                                                                    @onclick="@(() => RemoveProduct(BuyNowProduct))">
                                                                                <img src="dash.svg" />
                                                                            </button>
                                                                            <strong style="background-color: white;">@BuyNowProduct.Quantity</strong>
                                                                            <button class="ms-2" style="border-bottom-right-radius: 10px; border-top-right-radius: 10px; border: unset;"
                                                                                    @onclick="@(() => AddProduct(BuyNowProduct))">
                                                                                <img src="plus.svg" />
                                                                            </button>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="card" style="border: none; text-wrap: nowrap;">
                                                            <div class="card-body">
                                                                <InputRadioGroup Name="Shipping" @bind-Value="CheckoutService.ShippingType" @bind-Value:after="ApplySelectedShipping">
                                                                    <div class="mt-3">
                                                                        <div>
                                                                            <InputRadio Name="Shipping" class="form-check-input me-1" type="radio" Value="CheckoutService.FreeShipping"
                                                                                        id="culture" />
                                                                            <strong>@Loc["FreeDelivery"]</strong> @CheckoutService.ShippingDays["Free"], @CheckoutService.ShippingMonths["Free"] @CheckoutService.ShippingDates["Free"]
                                                                        </div>
                                                                    </div>
                                                                    <div class="mt-3">
                                                                        <div style="display: inline-block;">
                                                                            <InputRadio Name="Shipping" class="form-check-input me-1" type="radio" Value="CheckoutService.StandardShippng"
                                                                                        id="culture" />
                                                                            <strong>@Loc["Standard"]</strong> @CheckoutService.ShippingDays["Standard"], @CheckoutService.ShippingMonths["Standard"]
                                                                            @CheckoutService.ShippingDates["Standard"]
                                                                        </div>
                                                                        <div style="display: inline-block; text-align: right;">
                                                                            <p style="font-size: smaller;">@CheckoutService.StandardShipping.ToString("C2")</p>
                                                                        </div>
                                                                    </div>
                                                                    <div>
                                                                        <div style="display: inline-block;">
                                                                            <InputRadio Name="Shipping" class="form-check-input me-1" type="radio" Value="CheckoutService.FastShippng"
                                                                                        id="culture" />
                                                                            <strong>@Loc["Fast"]</strong> @CheckoutService.ShippingDays["Fast"], @CheckoutService.ShippingMonths["Fast"] @CheckoutService.ShippingDates["Fast"]
                                                                        </div>
                                                                        <div style="display: inline-block; text-align: right;">
                                                                            <p style="font-size: smaller;">@CheckoutService.FastShipping.ToString("C2")</p>
                                                                        </div>
                                                                    </div>
                                                                </InputRadioGroup>
                                                            </div>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="card mt-4 mb-5">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-sm-3">
                                    <button class="btn btn-primary me-2" style="background-color: #2f4f4f;
                                                          border-color:transparent; border-radius: 25px;" @onclick="HandlePayment" disabled="@isProcessing">
                                        @(isProcessing ? Loc["Processing"] + "..." : Loc["PlaceOrder"])
                                    </button>
                                </div>
                                @if (ShoppingCartProducts is not null && ShoppingCartProducts.Any() && BuyNowProduct is null)
                                {
                                    <div class="col-sm-7">
                                        @{
                                            OrderTotal = ShoppingCart.Subtotal + CheckoutService.Shipping + (0.16 * ShoppingCart.Subtotal);
                                        }
                                        <h5>
                                            @Loc["OrderTotal"]: @OrderTotal.ToString("C2")
                                        </h5>
                                    </div>
                                }
                                else{
                                    if (BuyNowProduct is not null)
                                    {
                                        using var context = DbFactory.CreateDbContext();
                                        var product = context.Product.FirstOrDefault(p => p.Id == BuyNowProduct.ProductId);
                                        <div class="col-sm-7">
                                            @{
                                                OrderTotal = product.Price + CheckoutService.Shipping + (0.16 * product.Price);
                                            }
                                            <h5>
                                                @Loc["OrderTotal"]: @OrderTotal.ToString("C2")
                                            </h5>
                                        </div>
                                    }
                                }
                                
                            </div>
                        </div>
                    </div>
                }
            </div>
            @if (CheckoutService.PaymentMethod is null)
            {
                <div class="col-sm-4">
                    <div class="card" style="position: fixed;">
                        <div class="card-body">
                            <div style="text-align: center;">
                                @if (DefaultCreditDebitCard is not null && ((DefaultCreditDebitCard.ExpirationMonth < CheckoutService.CurrentMonth
                                                        && DefaultCreditDebitCard.ExpirationYear < CheckoutService.CurrentYear) || DefaultCreditDebitCard.ExpirationYear < CheckoutService.CurrentYear))
                                {
                                    <button class="btn btn-primary me-2" disabled style="background-color: #2f4f4f;
                                                           border-color:transparent; border-radius: 25px;">
