@page "/Account/productlists/create"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using MethaWebsite.Data

@inject IStringLocalizer<SharedResource> Loc
@inject ApplicationUserService ApplicationUserService
@inject AuthenticationStateProvider AuthStateProvider
@inject IDbContextFactory<MethaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject UserManager<ApplicationUser> UserManager

@rendermode InteractiveServer

@attribute [Authorize]

<div class="container-sm" style="display: block; justify-content: center;">
    @{
        var showClass = IsVisible ? "d-block" : "d-none";
    }
    <div class="toast-container p-3 @showClass" data-bs-autohide="true" data-bs-delay="5000">
        <div class="toast show" role="alert" aria-live="assertive" aria-atomic="true"
             style="background-color: white;">
            <div class="toast-header">
                <strong class="me-auto">@Loc["AddList"]</strong>
                <button type="button" class="btn-close" aria-label="Close" @onclick="Close"></button>
            </div>
            <div class="toast-body">
                @if (CreateIssue)
                {
                    <div class="card mt-2 mb-2" style="border-color: red; color:red; max-width: 1200px;">
                        <div class="card-body">
                            <img src="info-circle.svg" />
                            @Loc["CreateListIssue"]
                        </div>
                    </div>
                }
                <EditForm method="post" Model="ProductList" OnValidSubmit="AddProductList" FormName="create" Enhance>
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" role="alert" />
                    <div class="form form-floating mb-3">
                        <InputText id="name" @bind-Value="ProductList.Name" class="form-control" placeholder=""/>
                        <label for="name" class="form-label">Name:</label>
                        <ValidationMessage For="() => ProductList.Name" class="text-danger" />
                    </div>
                    <div class="mb-3">
                        <label for="private" class="form-label">@Loc["ListsArePrivateByDefault"]</label>
                    </div>
                    <div class="ms-1" style="text-align: right;">
                        <button type="submit" class="btn btn-primary" style="background-color: #2f4f4f;
                            border-color:transparent; border-radius: 5px;">
                            @Loc["Add"]
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="@showClass darker-background"></div>
</div>

@code {
    [SupplyParameterFromForm]
    private ProductList ProductList { get; set; } = new();

    private ApplicationUser? ApplicationUser { get; set; }

    [Parameter]
    public bool IsVisible { get; set; } = false;

    [Parameter]
    public bool CreateIssue { get; set; } = false;

    [Parameter]
    public EventCallback<ProductList> OnAddToList { get; set; }

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddProductList()
    {
        using var context = DbFactory.CreateDbContext();
        ApplicationUser ??= await ApplicationUserService.GetApplicationUser();
        var existingList = await context.ProductList.FirstOrDefaultAsync(l => l.Name == ProductList.Name && l.UserId == ApplicationUser.Id);
        if (existingList == null)
        {
            CreateIssue = false;
            ProductList.Private = true;
            ProductList.UserId = ApplicationUser.Id;
            context.ProductList.Add(ProductList);
            await context.SaveChangesAsync();
            await OnAddToList.InvokeAsync(ProductList);
            Close();
        }
        else
        {
            CreateIssue = true;
        }
    }
    public void Show()
    {
        IsVisible = true;
        StateHasChanged();
    }

    private async Task Close()
    {
        IsVisible = false;
        StateHasChanged();
    }
}
