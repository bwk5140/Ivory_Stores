@page "/Account/Notifications/GeneralSettings"

@inject IStringLocalizer<SharedResource> Loc
@inject ApplicationUserService ApplicationUserService

@rendermode InteractiveServer

<div class="container-sm">
    @if (applicationUser is not null)
    {
        <strong>
            @Loc["ViewContactInfoForEmailAndText"]
        </strong>
        <div class="accordion mt-3" id="accordionExample">
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed btn" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne"
                            aria-expanded="false" aria-controls="collapseOne">
                        @Loc["Email"]
                    </button>
                </h2>
                <div id="collapseOne" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
                    <div class="accordion-body">
                        @Loc["EmailsAreSentTo"] <strong>@applicationUser.Email</strong> <a href=@($"/Account/2FAVerification?ReturnUrl={"Account/Manage/Email"}") style="text-decoration: none;">@Loc["Change"]</a>
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed btn" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo"
                            aria-expanded="false" aria-controls="collapseTwo">
                        @Loc["TextMessages"]
                    </button>
                </h2>
                <div id="collapseTwo" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
                    <div class="accordion-body">
                        @Loc["TextsAreSentTo"] <strong>@applicationUser.PhoneNumber</strong> <a href=@($"/Account/2FAVerification?ReturnUrl={"Account/Manage/Mobile"}") style="text-decoration: none;">@Loc["Change"]</a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card" style="z-index: 1400;  max-width: 70px;"><div class="card-body"><div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span> </div></div></div>
    }
</div>

@code {
    private ApplicationUser? applicationUser { get; set; }

    protected override async Task OnInitializedAsync()
    {
        applicationUser ??= await ApplicationUserService.GetApplicationUser();
    }
}