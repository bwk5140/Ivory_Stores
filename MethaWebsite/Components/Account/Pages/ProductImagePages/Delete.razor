@page "/productimages/delete"
@using MethaWebsite.Data
@using MethaWebsite.Data.Contexts
@using Microsoft.EntityFrameworkCore
@using System.Globalization

@inject IStringLocalizer<SharedResource> Loc
@inject IDbContextFactory<MethaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

@rendermode InteractiveServer

<PageTitle>Delete</PageTitle>


<div class="container-sm mt-5">
    @if (productimage is null)
    {
        <div class="card" style="z-index: 1400;  max-width: 70px;"><div class="card-body"><div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span> </div></div></div>
    }
    else {
        <div class="card" style="width: 55%;">
            <div class="card-header">
                <div style="text-align: right;">
                    <button type="button" class="btn-close" aria-label="Close" @onclick="OnCancelClicked"></button>
                </div>
                <strong class="header">@Loc["DeleteImage"]</strong>
            </div>
            <EditForm method="post" Model="productimage" OnValidSubmit="DeleteProductImage" FormName="delete" Enhance>
                <div class="card-body">
                    <div style="text-align: center;">
                        <img src="@(string.Format("data:image/jpg;base64,{0}", Convert.ToBase64String(productimage.Image)))"
                             alt=@Loc["ProductImage"] style="width:70%; height:70%; object-fit:cover;" />
                    </div>
                    <div style="text-align: right;">
                        <button type="submit" class="btn btn-danger" disabled="@(productimage is null)" style="cursor: pointer; border-radius: 5px;
                                                border-color:transparent;">
                            @Loc["Delete"]
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>
    }
</div>

@code {
    private ProductImage? productimage;

    [SupplyParameterFromQuery]
    private string? Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        productimage = await context.ProductImage.FirstOrDefaultAsync(m => m.Id == Id);

        if (productimage is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
    private void OnCancelClicked()
    {
        NavigationManager.NavigateTo("/productimages");
    }
    private async Task DeleteProductImage()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        context.ProductImage.Remove(productimage!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/productimages");
    }
}
