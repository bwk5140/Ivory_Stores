@page "/transactions/delete"
@using Microsoft.EntityFrameworkCore
@using MethaWebsite.Data
@inject IDbContextFactory<MethaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Transactions</h2>
    <hr />
    @if (transactions is null)
    {
        <div class="card" style="z-index: 1400;  max-width: 70px;"><div class="card-body"><div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span> </div></div></div>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Type</dt>
            <dd class="col-sm-10">@transactions.Type</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Vendor</dt>
            <dd class="col-sm-10">@transactions.Vendor</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">OrderId</dt>
            <dd class="col-sm-10">@transactions.OrderId</dd>
        </dl>
        <EditForm method="post" Model="transactions" OnValidSubmit="DeleteTransactions" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(transactions is null)">Delete</button> |
            <a href="/transactions">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Transaction? transactions;

    [SupplyParameterFromQuery]
    private string Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        transactions = await context.Transactions.FirstOrDefaultAsync(m => m.Id == Id);

        if (transactions is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteTransactions()
    {
        using var context = DbFactory.CreateDbContext();
        context.Transactions.Remove(transactions!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/transactions");
    }
}
