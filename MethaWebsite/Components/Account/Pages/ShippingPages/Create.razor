@page "/shippings/create"
@using Microsoft.EntityFrameworkCore
@using MethaWebsite.Data
@inject IDbContextFactory<MethaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>Shipping</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Shipping" OnValidSubmit="AddShipping" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <label for="type" class="form-label">Type:</label> 
                <InputText id="type" @bind-Value="Shipping.Type" class="form-control" /> 
                <ValidationMessage For="() => Shipping.Type" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="cost" class="form-label">Cost:</label> 
                <InputNumber id="cost" @bind-Value="Shipping.Cost" class="form-control" /> 
                <ValidationMessage For="() => Shipping.Cost" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="distance" class="form-label">Distance:</label> 
                <InputNumber id="distance" @bind-Value="Shipping.Distance" class="form-control" /> 
                <ValidationMessage For="() => Shipping.Distance" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="rate" class="form-label">Rate:</label> 
                <InputNumber id="rate" @bind-Value="Shipping.Rate" class="form-control" /> 
                <ValidationMessage For="() => Shipping.Rate" class="text-danger" /> 
            </div>        
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/shippings">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private Shipping Shipping { get; set; } = new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddShipping()
    {
        using var context = DbFactory.CreateDbContext();
        context.Shipping.Add(Shipping);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/shippings");
    }
}
