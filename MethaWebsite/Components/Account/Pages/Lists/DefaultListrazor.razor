@page "/wishlist/details/default"

@inject IDbContextFactory<MethaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject IStringLocalizer<SharedResource> Loc
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationUserService ApplicationUserService
@inject ShoppingCartService ShoppingCartService
@inject ProductRatingService ProductRatingService

@rendermode InteractiveServer

@if (List is not null && Products is not null)
{
    <h4>@List.Name</h4>
    <div class="card-header" style="text-align: right; border: none; background-color: transparent">
        <button style="border-radius: 10px; border: medium;" @onclick="OnEditListClicked">
            <img src="pencil-fill.svg" data-bs-toggle="tooltip" title=@Loc["EditList"] />
        </button>
    </div>
    <hr />
    foreach (var product in Products)
    {
        using var context = DbFactory.CreateDbContext();
        product.Images = context.ProductImage.Where(p => p.ProductColorGroupId == product.ProductColorGroupID).OrderBy(p => p.Created).ToList();
        CurrentImage = product.Images[0];
        <div class="card mb-3">
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-3" style="background-color: whitesmoke; padding: 0px;">
                        <a href="@($"product/details?id={product.Id}")" class="btn">
                            <img class="card-img-top" src="@(string.Format("data:image/jpg;base64,{0}", Convert.ToBase64String(CurrentImage.Image!)))"
                                 alt=@Loc["ProductImage"] style="width:150px; height:150px; object-fit:contain; vertical-align: central;" />
                        </a>
                    </div>
                    <div class="col-sm-9">
                        <a href="@($"product/details?id={product.Id}")" style="padding: 0px; text-decoration:none;">
                            @product.Name
                        </a>
                        <p>
                            @Loc["by"] @product.Brand
                        </p>
                        <div style="display: inline-block;">
                            @{
                                var stars = ProductRatingService.GetStarImages(product.Rating);
                            }
                            @if (product.Rating > 0)
                            {
                                <div class="me-1" style="display: inline-block; font-size: medium;">
                                    @product.Rating
                                </div>
                            }

                            @foreach (var star in stars)
                            {
                                <img src="@star" />
                            }
                            @if (product.ProductReviewIds is not null && product.ProductReviewIds.Any())
                            {
                                <a href="@($"product/details?id={product.Id}")" class="btn btn-link ms-1" style="border: unset; outline:none; background-color: transparent; text-decoration: none; padding: 0px;">
                                    (@product.ProductReviewIds.Count())
                                </a>
                            }
                            else
                            {
                                <a href="@($"product/details?id={product.Id}")" class="btn btn-link ms-1" style="border: unset; outline:none; background-color: transparent; text-decoration: none; padding: 0px;">
                                    (0)
                                </a>
                            }
                        </div>
                        <p style="font-size: smaller;"><strong>@product.Price.ToString("C2")</strong></p>
                        <div style="display: inline-block;">
                            <p style="font-size: smaller;">
                                @Loc["Size"]: @product.Size
                            </p>
                        </div>
                        <div style="display: inline-block;">
                            <p style="font-size: smaller;">
                                <div class="me-2" style="display: inline-block;">|</div>
                                @Loc["Color"] @product.Color
                            </p>
                        </div>
                        <div>
                            <div class="btn-group">
                                <button class="me-2" style="border-bottom-left-radius: 10px; border-top-left-radius: 10px; border: unset;
                                                                background-color: #2f4f4f; color: white;" @onclick="@(() => OnAddToCartClicked(product))">
                                    @Loc["AddToCart"]
                                </button>
                                <div class="dropdown">
                                    <button class="btn btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="border: medium;"
                                            @onclick="e => this.show[product.Id] = !this.show[product.Id]">
                                        @Loc["Move"]
                                    </button>
                                    <ul class="dropdown-menu @(show[product.Id] ? "show" : "")" @onmouseleave="e => this.show[product.Id] = !this.show[product.Id]" style="left: -50%; top: 120%;">
                                        @foreach (var list in Lists)
                                        {
                                            if (!list.Name.Equals(List.Name))
                                            {
                                                <li class="list-group-item dropdown-item ms-2 me-2 mb-1" style="background-color: transparent;">
                                                    <label class="form-check-label stretched-link" @onclick="@(() => MoveToList(product, list))" style="cursor: pointer;">
                                                        @list.Name
                                                    </label>
                                                </li>
                                            }
                                        }
                                    </ul>
                                </div>
                                <button class="ms-2" style="border-bottom-right-radius: 10px; border-top-right-radius: 10px; border: medium;" @onclick="@(() => OnDeleteFromListClicked(product))"
                                        data-bs-toggle="tooltip" title=@Loc["DeleteFromList"]>
                                    <img src="trash.svg" />
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    }
    <CascadingValue Value="List">
        <MethaWebsite.Components.Account.Pages.Lists.EditListPopOver @ref=EditListPopUp />
    </CascadingValue>
}
else
{
    <div class="ms-5 mb-5 mt-5">
        <p class="ms-5">@Loc["NoListsCreated"]</p>
    </div>
}
<div style="display: block; justify-content:center;">
    <MethaWebsite.Components.Account.Pages.ProductListPages.Create @ref=CreateListPopUp OnAddToList="Update" />
</div>


@code {
    [Parameter]
    public List<Product>? Products { get; set; } = new();

    [Parameter]
    public ProductList? List { get; set; }

    [Parameter]
    public ProductImage? CurrentImage { get; set; }

    [SupplyParameterFromQuery]
    public string? Id { get; set; }

    [SupplyParameterFromQuery]
    public bool Create { get; set; } = false;

    [Parameter]
    public ShoppingCartProduct shoppingCartProduct { get; set; } = new();

    [Parameter]
    public List<ProductList>? Lists { get; set; }

    private Dictionary<string, bool> show = new();
    private ApplicationUser? applicationUser { get; set; }
    private ShoppingCart? ShoppingCart { get; set; }
    private MethaWebsite.Components.Account.Pages.Lists.EditListPopOver? EditListPopUp;
    private MethaWebsite.Components.Account.Pages.ProductListPages.Create? CreateListPopUp;

    protected override async Task OnInitializedAsync()
    {
        using var context = await DbFactory.CreateDbContextAsync();

        applicationUser ??= await ApplicationUserService.GetApplicationUser();
        List = await context.ProductList.FirstOrDefaultAsync(l => l.Name == Loc["Default"] && l.UserId == applicationUser.Id);
        if (List is null)
        {
            List = await context.ProductList.FirstOrDefaultAsync(l => l.UserId == applicationUser.Id);
        }
        if (List is not null && List.ProductIds is not null)
        {
            Products = await context.Product.Where(p => List.ProductIds.Contains(p.Id)).Distinct()
                        .ToListAsync();
            if (Products is not null)
            {
                foreach (var product in Products)
                {
                    show[product.Id] = false;
                }
            }
        }
        Lists = context.ProductList.Where(l => l.UserId == applicationUser.Id).ToList();
    }
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            if (Create)
            {
                ShowCreateListPopUp();
            }
        }
    }
    protected override async Task OnParametersSetAsync()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        List = await context.ProductList.FirstOrDefaultAsync(l => l.Name == Loc["Default"] && l.UserId == applicationUser.Id);
        if (List is null)
        {
            List = await context.ProductList.FirstOrDefaultAsync(l => l.UserId == applicationUser.Id);
        }
        if (List is not null && List.ProductIds is not null)
        {
            Products = await context.Product.Where(p => List.ProductIds.Contains(p.Id)).Distinct()
                        .ToListAsync();
            if (Products is not null)
            {
                foreach (var product in Products)
                {
                    show[product.Id] = false;
                }
            }
        }
    }
    public void OnEditListClicked()
    {
        EditListPopUp.Show();
    }
    public void ShowCreateListPopUp()
    {
        if (CreateListPopUp is not null)
            CreateListPopUp.Show();
    }
    private void Update()
    {
        NavigationManager.NavigateTo("/wishlist/details/default", true);
    }
    private async Task OnAddToCartClicked(Product product)
    {
        using var context = await DbFactory.CreateDbContextAsync();
        var ShoppingCartProduct = new ShoppingCartProduct();
        ShoppingCartProduct.ProductId = product.Id;
        context.ShoppingCartProduct.Add(ShoppingCartProduct);
        ShoppingCartProduct.Quantity = 1;

        if (applicationUser is not null)
        {
            ShoppingCart = await context.ShoppingCart.FirstOrDefaultAsync(s => s.UserId == applicationUser.Id);

            if (ShoppingCart is null)
            {
                ShoppingCart = ShoppingCartService.getShoppingCart();
                ShoppingCart.UserId = applicationUser.Id;
                context.ShoppingCart.Add(ShoppingCart);
                await context.SaveChangesAsync();
            }
        }
        else
        {
            ShoppingCart = ShoppingCartService.getShoppingCart();
            if (!context.ShoppingCart.Contains(ShoppingCart))
            {
                context.ShoppingCart.Add(ShoppingCart);
                await context.SaveChangesAsync();
            }
        }
        for (int i = shoppingCartProduct.Quantity; i > 0; i--)
        {
            ShoppingCart.ProductIds.Add(ShoppingCartProduct.Id);
            ShoppingCart.Subtotal += product.Price;
        }
        context.Attach(ShoppingCart!).State = EntityState.Modified;
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo($"/shoppingcart/confirmation?id={product.Id}", forceLoad: true);
    }
    private async Task OnDeleteFromListClicked(Product product)
    {
        using var context = await DbFactory.CreateDbContextAsync();
        List.ProductIds.Remove(product.Id);
        context.Attach(List!).State = EntityState.Modified;
        await context.SaveChangesAsync();
        Products = await context.Product.Where(p => List.ProductIds.Contains(p.Id)).Distinct()
                        .ToListAsync();
        StateHasChanged();
    }
    private async Task MoveToList(Product product, ProductList list)
    {
        if (!list.ProductIds.Contains(product.Id))
        {
            await OnDeleteFromListClicked(product);
            list.ProductIds.Add(product.Id);
            using var context = await DbFactory.CreateDbContextAsync();
            context.Attach(list!).State = EntityState.Modified;
            await context.SaveChangesAsync();
            Lists = context.ProductList.Where(l => l.UserId == applicationUser.Id).ToList();
            StateHasChanged();
        }
    }
}

