    private async Task OnCreateSizeChartClicked()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        var parent = await context.Category.FirstOrDefaultAsync(m => m.Id == category!.ParentID);

        // Define keyword-action mapping
        var keywordActions = new Dictionary<string, Action>(StringComparer.OrdinalIgnoreCase)
        {
            { "trouser", () => AddNewTrouserSizeGuidePopUp!.Show() },
            { "jeans", () => AddNewTrouserSizeGuidePopUp!.Show() },
            { "shirt", () => AddNewShirtSizeGuidePopUp!.Show() },
            { "top", () => AddNewShirtSizeGuidePopUp!.Show() },
            { "jacket", () => AddNewShirtSizeGuidePopUp!.Show() },
            { "shoe", () => AddNewShoesSizeGuidePopUp!.Show() },
            { "dress", () => AddNewShirtSizeGuidePopUp!.Show() }
        };

        // Try matching against CategoryName
        bool found = TryShowSizeGuide(CategoryName!, keywordActions);

        while (!found && parent is not null)
        {
            found = TryShowSizeGuide(parent.Name!, keywordActions);
            parent = await context.Category.FirstOrDefaultAsync(m => m.Id == parent.ParentID);
        }
    }
    private bool TryShowSizeGuide(string name, Dictionary<string, Action> keywordActions)
    {
        foreach (var kvp in keywordActions)
        {
            if (name.Contains(kvp.Key, StringComparison.OrdinalIgnoreCase))
            {
                kvp.Value.Invoke();
                return true;
            }
        }
        return false;
    }
    private async Task OnSizeChartClicked()
    {
        if (Product.SizeGuideId is not null)
        {
            using var shirts_context = await DbFactory.CreateDbContextAsync();
            using var shoes_context = await DbFactory.CreateDbContextAsync();
            using var trousers_context = await DbFactory.CreateDbContextAsync();

            var sizeGuideHandlers = new List<SizeGuideHandler>
        {
            new SizeGuideHandler(
                (id, ctx) => shirts_context.ShirtsSizeGuide.Any(s => s.Id == id),
                () => ShirtSizeGuidePopUp!.Show()
            ),
            new SizeGuideHandler(
                (id, ctx) => shoes_context.ShoesSizeGuide.Any(s => s.Id == id),
                () => ShoeSizeGuidePopUp!.Show()
            ),
            new SizeGuideHandler(
                (id, ctx) => trousers_context.TrousersSizeGuide.Any(s => s.Id == id),
                () => TrouserSizeGuidePopUp!.Show()
            )
        };

            foreach (var handler in sizeGuideHandlers)
            {
                if (handler.TryFind(Product.SizeGuideId, trousers_context))
                {
                    handler.Action();
                    break;
                }
            }
        }
    }
    private async Task OnNextClicked()
    {
        var htmlDescription = await QuillHtml.GetHTML();

        if (productGroup?.ProductColorGroups is not null)
        {
            foreach (var colorGroup in productGroup.ProductColorGroups)
            {
                foreach (var product in colorGroup.Products)
                {
                    product.Description = htmlDescription;
                    product.Price = Product.Price;
                }
            }

            Product.Description = htmlDescription;
        }
        else
        {
            productGroup ??= new ProductGroup
            {
                Name = Product.Name,
                ProductColorGroups = new List<ProductColorGroup>()
            };

            var newProduct = new Product
            {
                Color = Product.Color,
                Size = Product.Size,
                Price = Product.Price,
                Description = htmlDescription
            };

            showColoredImage[newProduct.Id] = false;

            var colorGroup = productGroup.ProductColorGroups
                .FirstOrDefault(cg => cg.Color == newProduct.Color);

            if (colorGroup is null)
            {
                colorGroup = new ProductColorGroup
                {
                    Name = newProduct.Name,
                    Color = newProduct.Color,
                    Products = new List<Product> { newProduct }
                };

                productGroup.ProductColorGroups.Add(colorGroup);
            }
            else
            {
                colorGroup.Products.Add(newProduct);
            }

            newProduct.ProductColorGroupID = colorGroup.Id;
            Product.Description = htmlDescription;
        }

        NextClicked = true;
    }
