    private void CopyProductMetadata(Product target, Product source)
    {
        target.Brand = source.Brand;
        target.Name = source.Name;
        target.Description = source.Description;
        target.CategoryId = source.CategoryId;
        target.Fabric = source.Fabric;
        target.Lifestyle = source.Lifestyle;
        target.WashInstructions = source.WashInstructions;
        target.SizeGuideId = source.SizeGuideId;
        target.Color = source.Color;
        target.Price = source.Price;
        target.Size = source.Size;
        target.Gender = source.Gender;
        target.Stock = source.Stock;
        target.Quantity = source.Quantity;
    }
    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateProduct()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        var products = context.Product;
        var color_groups = context.ProductColorGroup;
        if (productGroup is not null)
        {
            if (productGroup.ProductColorGroups is not null)
            {
                foreach (var productColorGroup in productGroup.ProductColorGroups)
                {
                    foreach (var product in productColorGroup.Products)
                    {
                        if (!products.Contains(product))
                        {
                            product.ProductColorGroupID = productColorGroup.Id;
                            CopyProductMetadata(product, Product);
                            context.Product.Add(product);
                        }
                        else
                        {
                            foreach (var img in product.Images)
                            {
                                if (!context.ProductImage.Contains(img))
                                {
                                    context.ProductImage.Add(img);
                                    await context.SaveChangesAsync();
                                }
                            }

                            context.Attach(product!).State = EntityState.Modified;
                        }
                    }
                    if (!color_groups.Contains(productColorGroup))
                    {
                        productColorGroup.Name = Product.Name;
                        productColorGroup.ProductGroupID = productGroup.Id;
                        context.ProductColorGroup.Add(productColorGroup);
                    }
                    else
                    {
                        context.Attach(productColorGroup!).State = EntityState.Modified;
                    }
                }
            }
            context.Attach(productGroup!).State = EntityState.Modified;
        }
        else
        {
            context.Attach(Product!).State = EntityState.Modified;
        }
        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!ProductExists(Product!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }
        NavigationManager.NavigateTo("Account/products");
    }
