    public async Task UpdateSizeGuides()
    {
        if (productGroup?.ProductColorGroups is not null)
        {
            var products = productGroup.ProductColorGroups
                .SelectMany(cg => cg.Products)
                .ToList();

            var lastWithSizeGuide = products
                .LastOrDefault(p => p.SizeGuideId is not null);

            if (lastWithSizeGuide is not null)
            {
                Product.SizeGuideId = lastWithSizeGuide.SizeGuideId;
            }
        }

        if (Product.SizeGuideId is not null)
        {
            using var context = await DbFactory.CreateDbContextAsync();

            var sizeGuideHandlers = new List<SizeGuideHandler>
        {
            new SizeGuideHandler(
                (id, ctx) => context.ShirtsSizeGuide.Any(s => s.Id == id),
                () => ShirtSizeGuidePopUp!.Update()
            ),
            new SizeGuideHandler(
                (id, ctx) => context.ShoesSizeGuide.Any(s => s.Id == id),
                () => ShoeSizeGuidePopUp!.Update()
            ),
            new SizeGuideHandler(
                (id, ctx) => context.TrousersSizeGuide.Any(s => s.Id == id),
                () => TrouserSizeGuidePopUp!.Update()
            )
        };

            foreach (var handler in sizeGuideHandlers)
            {
                if (handler.TryFind(Product.SizeGuideId, context))
                {
                    handler.Action();
                    break;
                }
            }
        }
    }
