    private ProductGroup EnsureProductGroup(ProductGroup? current, string productName)
    {
        return current ?? new ProductGroup
        {
            Name = productName,
            ProductColorGroups = new List<ProductColorGroup>()
        };
    }
    private Product CreateProductFrom(Product source)
    {
        return new Product
        {
            Color = source.Color,
            Size = source.Size,
            Price = source.Price
        };
    }
    private ProductColorGroup AssignToColorGroup(ProductGroup group, Product product)
    {
        var colorGroup = group.ProductColorGroups
            .FirstOrDefault(cg => cg.Color == product.Color);

        if (colorGroup is null)
        {
            colorGroup = new ProductColorGroup
            {
                Name = product.Name,
                Color = product.Color,
                Products = new List<Product> { product }
            };

            group.ProductColorGroups.Add(colorGroup);
        }
        else
        {
            colorGroup.Products.Add(product);
        }

        product.ProductColorGroupID = colorGroup.Id;
        return colorGroup;
    }
    public void OnAddNewSizeClicked()
    {

        if (MultiColoredProducts.Count > 0)
        {
            selectColorPopover.Show();
            return;
        }

        if (Product.Size is null)
        {
            if (MultiSizedProducts?.Count > 0)
                Product.Size = MultiSizedProducts.Last().Size;

            return;
        }

        productGroup = EnsureProductGroup(productGroup, Product.Name);

        var newProduct = CreateProductFrom(Product);
        showColoredImage[newProduct.Id] = false;
        MultiSizedProducts!.Add(newProduct);
        MultiSizedPopovers[newProduct.Id] = true;

        AssignToColorGroup(productGroup, newProduct);

    }
    public void OnAddNewColorClicked()
    {
        if (!string.IsNullOrWhiteSpace(Product.Color))
        {
            var product = new Product
            {
                Price = Product.Price,
                Size = Product.Size,
                Color = Product.Color
            };

            MultiColoredProducts.Add(product);
            MultiColoredPopovers[product.Id] = true;
            showDeleteProd[product.Id] = false;
        }
    }
    private async Task CloseSize(Product product)
    {
        if (productGroup is not null && MultiSizedProducts!.Count > 0)
        {
            using var context = await DbFactory.CreateDbContextAsync();
            var colorGroup = await context.ProductColorGroup.SingleAsync(m => m.Id == product.ProductColorGroupID);
            var images = context.ProductImage.Where(i => i.ProductColorGroupId == colorGroup.Id);
            MultiSizedProducts!.Remove(product);
            MultiSizedPopovers[product.Id] = false;
            MultiSizedPopovers.Remove(product.Id);
            var prod = await context.Product.FirstOrDefaultAsync(p => p.Id == product.Id);
            context.Product.Remove(prod);
            foreach (var image in images)
            {
                context.ProductImage.Remove(image);
            }
            await context.SaveChangesAsync();

            foreach (var color_group in productGroup.ProductColorGroups)
            {
                prod = color_group.Products.FirstOrDefault(p => p.Id == product.Id);
                if (color_group.Products.Contains(prod))
                {
                    color_group.Products.Remove(prod);
                    break;
                }
            }
        }
        StateHasChanged();
    }
    private async Task CloseColor(Product product)
    {
        MultiColoredProducts!.Remove(product);
        MultiColoredPopovers[product.Id] = false;

        //Remove colored products of various sizes
        using var context = await DbFactory.CreateDbContextAsync();
        var colorGroup = await context.ProductColorGroup.SingleAsync(m => m.Id == product.ProductColorGroupID);
        if (colorGroup is not null)
        {
            var products = MultiSizedProducts.Where(p => p.ProductColorGroupID == colorGroup.Id).ToList();
            foreach (var prod in products)
            {
                MultiSizedProducts!.Remove(prod);
                MultiSizedPopovers[prod.Id] = false;
                MultiSizedPopovers.Remove(prod.Id);
            }
            var dbProducts = context.Product.Where(p => p.ProductColorGroupID == colorGroup.Id);
            foreach (var prod in dbProducts)
            {
                var images = context.ProductImage.Where(m => m.ProductColorGroupId == colorGroup.Id).ToList();
                foreach (var image in images)
                {
                    context.ProductImage.Remove(image);
                }
                context.Product.Remove(prod);
            }
            context.ProductColorGroup.Remove(colorGroup);
            colorGroup = productGroup.ProductColorGroups.FirstOrDefault(m => m.Id == product.ProductColorGroupID);
            productGroup.ProductColorGroups.Remove(colorGroup);

            try
            {
                await context.SaveChangesAsync();
            }
            catch (DbUpdateConcurrencyException ex)
            {
                Logger.LogInformation(ex.Message);
            }
        }

        StateHasChanged();
    }
    private void CloseProductImages(Product product)
    {
        showColoredImage[product.Id] = false;
        StateHasChanged();
    }
    private async Task DeleteImageFromProduct(Product product, ProductImage img)
    {
        product.Images!.Remove(img);
        var prod_group = productGroup.ProductColorGroups.FirstOrDefault(p => p.Color == product.Color);
        foreach (var prod in prod_group.Products)
        {
            if (prod.Images.Contains(img))
            {
                prod.Images.Remove(img);
            }
        }

        if (product.Images.Count == 0)
        {
            CloseProductImages(product);
        }
        StateHasChanged();
        using var context = await DbFactory.CreateDbContextAsync();
        if (context.ProductImage.Contains(img))
        {
            context.ProductImage.Remove(img);
            context.SaveChanges();
        }
    }
    private void AddNewSize()
    {
        if (!string.IsNullOrWhiteSpace(Product.Size))
        {
            productGroup ??= new ProductGroup
            {
                Name = Product.Name,
                ProductColorGroups = new List<ProductColorGroup>()
            };

            var colors = selectColorPopover.CurrentProductSizeColor.Equals(Loc["All"])
                ? MultiColoredProducts.Select(p => p.Color)
                : new[] { selectColorPopover.CurrentProductSizeColor };

            foreach (var color in colors)
            {
                var product = CreateSizedProduct(color);

                showColoredImage[product.Id] = false;
                MultiSizedProducts!.Add(product);
                MultiSizedPopovers[product.Id] = true;

                AssignToColorGroup(productGroup, product);
            }

            selectColorPopover.Close();
            StateHasChanged();
        }
    }
    private Product CreateSizedProduct(string color)
    {
        return new Product
        {
            Size = Product.Size,
            Price = Product.Price,
            Color = color
        };
    }
    private bool ProductExists(string id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Product.Any(e => e.Id == id);
    }
