@page "/shoppingcartproducts/edit"
@using Microsoft.EntityFrameworkCore
@using MethaWebsite.Data
@inject IDbContextFactory<MethaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>ShoppingCartProduct</h2>
<hr />
@if (ShoppingCartProduct is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="ShoppingCartProduct" OnValidSubmit="UpdateShoppingCartProduct" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="ShoppingCartProduct.Id" value="@ShoppingCartProduct.Id" />
                <div class="mb-3">
                    <label for="productid" class="form-label">ProductId:</label>
                    <InputText id="productid" @bind-Value="ShoppingCartProduct.ProductId" class="form-control" />
                    <ValidationMessage For="() => ShoppingCartProduct.ProductId" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="quantity" class="form-label">Quantity:</label>
                    <InputNumber id="quantity" @bind-Value="ShoppingCartProduct.Quantity" class="form-control" />
                    <ValidationMessage For="() => ShoppingCartProduct.Quantity" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/shoppingcartproducts">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private string Id { get; set; }

    [SupplyParameterFromForm]
    private ShoppingCartProduct? ShoppingCartProduct { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        ShoppingCartProduct ??= await context.ShoppingCartProduct.FirstOrDefaultAsync(m => m.Id == Id);

        if (ShoppingCartProduct is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateShoppingCartProduct()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(ShoppingCartProduct!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!ShoppingCartProductExists(ShoppingCartProduct!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/shoppingcartproducts");
    }

    private bool ShoppingCartProductExists(string id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.ShoppingCartProduct.Any(e => e.Id == id);
    }
}
