@page "/shoppingcartproducts/delete"
@using Microsoft.EntityFrameworkCore
@using MethaWebsite.Data
@inject IDbContextFactory<MethaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>ShoppingCartProduct</h2>
    <hr />
    @if (shoppingcartproduct is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">ProductId</dt>
            <dd class="col-sm-10">@shoppingcartproduct.ProductId</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Quantity</dt>
            <dd class="col-sm-10">@shoppingcartproduct.Quantity</dd>
        </dl>
        <EditForm method="post" Model="shoppingcartproduct" OnValidSubmit="DeleteShoppingCartProduct" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(shoppingcartproduct is null)">Delete</button> |
            <a href="/shoppingcartproducts">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private ShoppingCartProduct? shoppingcartproduct;

    [SupplyParameterFromQuery]
    private string Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        shoppingcartproduct = await context.ShoppingCartProduct.FirstOrDefaultAsync(m => m.Id == Id);

        if (shoppingcartproduct is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteShoppingCartProduct()
    {
        using var context = DbFactory.CreateDbContext();
        context.ShoppingCartProduct.Remove(shoppingcartproduct!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/shoppingcartproducts");
    }
}
