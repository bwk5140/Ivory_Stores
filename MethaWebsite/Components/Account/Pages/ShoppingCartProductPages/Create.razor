@page "/shoppingcartproducts/create"
@using Microsoft.EntityFrameworkCore
@using MethaWebsite.Data
@inject IDbContextFactory<MethaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>ShoppingCartProduct</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="ShoppingCartProduct" OnValidSubmit="AddShoppingCartProduct" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <label for="productid" class="form-label">ProductId:</label> 
                <InputText id="productid" @bind-Value="ShoppingCartProduct.ProductId" class="form-control" /> 
                <ValidationMessage For="() => ShoppingCartProduct.ProductId" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="quantity" class="form-label">Quantity:</label> 
                <InputNumber id="quantity" @bind-Value="ShoppingCartProduct.Quantity" class="form-control" /> 
                <ValidationMessage For="() => ShoppingCartProduct.Quantity" class="text-danger" /> 
            </div>        
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/shoppingcartproducts">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private ShoppingCartProduct ShoppingCartProduct { get; set; } = new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddShoppingCartProduct()
    {
        using var context = DbFactory.CreateDbContext();
        context.ShoppingCartProduct.Add(ShoppingCartProduct);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/shoppingcartproducts");
    }
}
