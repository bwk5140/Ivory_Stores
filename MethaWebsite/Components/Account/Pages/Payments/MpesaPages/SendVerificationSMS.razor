@inject IStringLocalizer<SharedResource> Loc
@inject SMS_Service SMS_Service

@if (MpesaPaymentMethod!.Number is not null)
{
    <div class="container-sm">
        @{
            var showClass = IsVisible ? "d-block" : "d-none";
        }
        <div class="toast-container p-3 @showClass" data-bs-autohide="true" data-bs-delay="5000"
             style="z-index: 1450;">
            <div class="toast show" role="alert" aria-live="assertive" aria-atomic="true"
                 style="background-color: white; width: max-content;">
                <div class="toast-header">
                    <strong class="me-auto">@Loc["UpdateAccount"]</strong>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="Close"></button>
                </div>
                <div class="toast-body">
                    <div class="ms-1" style="display: inline-block;">
                        <strong>Mpesa @Loc["PhoneNumber"]</strong>
                    </div>
                    <div style="display: inline-block;">
                        @Loc["EndingIn"] @MpesaPaymentMethod.Number.Substring(MpesaPaymentMethod.Number.Length - 4, 4)
                    </div>
                    <div style="display: inline-block; padding-left: 100px;">
                        @MpesaPaymentMethod.RegisteredName
                    </div>
                    @if (!Verified)
                    {
                        if (!VerificationIssue)
                        {
                            <div class="card mt-2 mb-2" style="border-color: blue; max-width: 1200px;">
                                <div class="card-body">
                                    <img src="info-circle.svg" />
                                    @Loc["VerifyMpesaInfo"] @Loc["EndingIn"] @MpesaPaymentMethod.Number.Substring(MpesaPaymentMethod.Number.Length - 4, 4)
                                </div>
                            </div>
                        }
                        else
                        {
                            if (!string.IsNullOrEmpty(code))
                            {
                                <div class="card mt-2 mb-2" style="border-color: red; color:red; max-width: 1200px;">
                                    <div class="card-body">
                                        <img src="info-circle.svg" />
                                        @Loc["PhoneVerificationIssue"]
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="card mt-2 mb-2" style="border-color: red; max-width: 1200px;">
                                    <div class="card-body">
                                        <img src="info-circle.svg" />
                                        @Loc["VerifyPhoneNUmberError"]
                                    </div>
                                </div>
                            }
                        }
                    }
                    else
                    {
                        <div class="card mt-2 mb-2" style="border-color: green; max-width: 1200px;">
                            <div class="card-body">
                                <img src="check-circle-fill.svg" />
                                @Loc["PhoneNumberVerified"]
                            </div>
                        </div>
                    }
                    <div class="mt-2" style="display: inline-block;">
                        <div style="display: inline-block;">
                            <InputText id="code" @bind-Value="code" class="form-control"
                                       placeholder="@placeholder" style="height: 43px;" />
                        </div>
                        <div class="form form-floating" style="display: inline-block;">
                            <button @onclick="OnVerifyPhoneClicked" class="btn btn-primary me-2" style="background-color: #2f4f4f;
                                                                            border-color:transparent; border-radius: 15px;">
                                @Loc["VerifyPhone"]
                            </button>
                        </div>

                    </div>
                    <div class="mt-3" style="text-align: right">
                        <button type="reset" class="btn btn-secondary me-2" style="border: none; font-size: medium;" @onclick="Close">
                            @Loc["Cancel"]
                        </button>
                        <button type="button" class="btn btn-primary me-2" style="background-color: #2f4f4f; border: none;
                                                                            font-size: medium;" @onclick="OnUpdate">
                            @Loc["Update"]
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="@showClass darker-background-lev-2"></div>
    </div>
}


@code {

    [Parameter]
    public bool IsVisible { get; set; } = false;

    [CascadingParameter]
    public Mpesa? MpesaPaymentMethod { get; set; }

    private string? MessageCode { get; set; }

    [Parameter]
    public string? code { get; set; } = "";

    [Parameter]
    public bool Verified { get; set; } = false;

    [Parameter]
    public bool VerificationIssue { get; set; } = false;

    [Parameter]
    public string? placeholder { get; set; }

    [Parameter]
    public EventCallback<SaveChangesEventArgs> OnUpdateClicked { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (MpesaPaymentMethod!.Number is not null)
        {
            placeholder = $"{Loc["EndingIn"]} {MpesaPaymentMethod.Number.Substring(MpesaPaymentMethod.Number.Length - 4, 4)}";
            MessageCode = Guid.NewGuid().ToString().Substring(0, 6);
        }
    }
    protected override async Task OnParametersSetAsync()
    {
        if (MpesaPaymentMethod!.Number is not null)
        {
            placeholder = $"{Loc["EndingIn"]} {MpesaPaymentMethod.Number.Substring(MpesaPaymentMethod.Number.Length - 4, 4)}";
        }
    }
    public void Show()
    {
        IsVisible = true;
        StateHasChanged();
    }

    private void Close()
    {
        IsVisible = false;
        VerificationIssue = false;
        code = "";
        StateHasChanged();
    }
    public async Task SendCode()
    {
        if (string.IsNullOrWhiteSpace(MessageCode))
        {
            MessageCode = Guid.NewGuid().ToString().Substring(0, 6);
        }
        string msg = "Your Ivory Stores verification code is: " + MessageCode;
        await SMS_Service.SendSmsAsync(msg, MpesaPaymentMethod.Number);
    }
    private void OnVerifyPhoneClicked()
    {
        if (code == MessageCode)
        {
            Verified = true;
        }
        else
        {
            VerificationIssue = true;
        }
    }
    private async Task OnUpdate()
    {
        if (Verified)
        {
            await OnUpdateClicked.InvokeAsync();
            Close();
        }
        else
        {
            VerificationIssue = true;
        }
    }
}
