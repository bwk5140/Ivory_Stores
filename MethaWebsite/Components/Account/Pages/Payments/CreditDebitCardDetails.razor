@page "/Account/Payments/CreditDebit/details"

@inject IStringLocalizer<SharedResource> Loc
@inject IDbContextFactory<MethaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

@rendermode InteractiveServer

<PageTitle>Details</PageTitle>

<div class="container-sm" style="max-width: 700px;">
    @if (creditdebitcard is null)
    {
        <div class="card" style="z-index: 1400;  max-width: 70px;"><div class="card-body"><div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span> </div></div></div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-7 mt-3">
                <svg width="400" height="200" viewBox="0 0 400 200" xmlns="http://www.w3.org/2000/svg">

                    <image id="card_img" href="@creditdebitcard.ImageSource" width="400" height="200" />
                    @if (creditdebitcard.DefaultPaymentMethod)
                    {
                        <rect x="255" y="40" width="100" height="50" fill="yellowgreen" rx="10" ry="10" />
                    }
                    <text x="270" y="72" font-size="24" fill="black">@DefaultPayment</text>
                    <text x="79" y="120"
                          font-size="24" fill="white">••••</text>
                    <text x="130" y="120"
                          font-size="24" fill="white">@creditdebitcard.CardNumber.Substring(creditdebitcard.CardNumber.Length - 4, 4)</text>
                    <text x="79" y="170"
                          font-size="24" fill="white">@creditdebitcard.NameOnCard</text>
                    <image href="@creditdebitcard.LogoSource" x="290" y="150" width="60" height="30" />
                </svg>
            </div>
            <div class="col-sm-3 mt-5">
                <div style="display: inline-block; text-wrap: nowrap; width: max-content;">
                    <div>
                        <h4>@creditdebitcard.Type</h4>
                    </div>
                    <div style="display: inline-block">
                        @Loc["CardEnding"]
                    </div>
                    <div style="display: inline-block; width: 30px;">
                        ••••
                    </div>
                    <div style="display: inline-block">
                        @creditdebitcard.CardNumber.Substring(creditdebitcard.CardNumber.Length - 4, 4)
                    </div>
                    <div>
                        @if ((creditdebitcard.ExpirationMonth < CurrentMonth && creditdebitcard.ExpirationYear < CurrentYear) || creditdebitcard.ExpirationYear < CurrentYear)
                        {
                            <p class="text-danger">@Loc["ExpiredOn"] @creditdebitcard.ExpirationMonth/@creditdebitcard.ExpirationYear</p>
                        }
                        else
                        {
                            <p class="text-info">@Loc["ExpiresOn"] @creditdebitcard.ExpirationMonth/@creditdebitcard.ExpirationYear</p>
                        }
                    </div>
                    <div>
                        <button class="btn btn-link" style="text-decoration: none; border: none; background-color: transparent" type="button" @onclick="OnEditClicked">
                            @Loc["Edit"]
                        </button>
                        |
                        <button class="btn btn-link text-danger" style="text-decoration: none; border: none; background-color: transparent" type="button" @onclick="OnDeleteClicked">
                            @Loc["Remove"]
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
<CascadingValue Value="HasStateChanged">
    <MethaWebsite.Components.Account.Pages.Payments.CreditDebitCardPages.Edit @ref="EditDebitCreditCard" OnStateChanged="OnEditStateFinished" />
    <MethaWebsite.Components.Account.Pages.Payments.CreditDebitCardPages.Delete @ref="DeleteDebitCreditCard" />
</CascadingValue>

@code {
    private CreditDebitCard? creditdebitcard;
    private CreditDebitCardPages.Edit? EditDebitCreditCard;
    private CreditDebitCardPages.Delete? DeleteDebitCreditCard;

    [Parameter]
    public string DefaultPayment { get; set; } = "";

    [SupplyParameterFromQuery]
    private string? Id { get; set; }

    [SupplyParameterFromQuery]
    private bool HasStateChanged { get; set; }

    private int CurrentMonth;
    private int CurrentYear;

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        creditdebitcard = await context.CreditDebitCard.FirstOrDefaultAsync(m => m.Id == Id);

        CurrentMonth = DateTime.Now.Month;
        CurrentYear = DateTime.Now.Year;

        if (creditdebitcard is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        if (creditdebitcard.DefaultPaymentMethod)
        {
            DefaultPayment = Loc["Default"];
        }
        else
        {
            DefaultPayment = "";
        }
    }
    protected override async Task OnParametersSetAsync()
    {
        // Reload the data based on new Id
        await LoadCardDetails(Id!);
    }
    private async Task LoadCardDetails(string Id)
    {
        using var context = DbFactory.CreateDbContext();
        creditdebitcard = await context.CreditDebitCard.FirstOrDefaultAsync(m => m.Id == Id);

        CurrentMonth = DateTime.Now.Month;
        CurrentYear = DateTime.Now.Year;
        if (creditdebitcard is not null && creditdebitcard.DefaultPaymentMethod)
        {
            DefaultPayment = Loc["Default"];
        }
        else
        {
            DefaultPayment = "";
        }
    }
    public void OnEditClicked()
    {
        EditDebitCreditCard.Show();
    }
    public void OnDeleteClicked()
    {
        DeleteDebitCreditCard.Show();
    }
    private void OnEditStateFinished()
    {
        HasStateChanged = true;
    }
}
