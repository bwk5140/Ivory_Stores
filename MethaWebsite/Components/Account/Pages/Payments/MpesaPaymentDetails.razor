@page "/Account/Payments/Mpesa/details"
@using Microsoft.EntityFrameworkCore
@using MethaWebsite.Data

@inject IStringLocalizer<SharedResource> Loc
@inject IDbContextFactory<MethaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

@rendermode InteractiveServer

<PageTitle>Details</PageTitle>

<div class="container-sm" style="max-width: 700px;">
    @if (MpesaPaymentInfo is null)
    {
        <div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span> </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-7 mt-3">
                <svg width="400" height="200" viewBox="0 0 400 200" xmlns="http://www.w3.org/2000/svg">
                    <image id="card_img" href="@MpesaPaymentInfo.ImageSource" width="330" height="200"/>
                    @if (MpesaPaymentInfo.DefaultPaymentMethod)
                    {
                        <rect x="255" y="40" width="100" height="50" fill="yellowgreen" rx="10" ry="10" sty/>
                    }
                    <image href="@MpesaPaymentInfo.LogoSource" x="-5" y="8" width="330" height="200"/>
                    
                    <text x="270" y="77" font-size="24" fill="black">@DefaultPayment</text>
                    <text x="200" y="150"
                          font-size="24" fill="white">••••</text>
                    <text x="250" y="157"
                          font-size="24" fill="white">@MpesaPaymentInfo.PhoneNumber.Substring(MpesaPaymentInfo.PhoneNumber.Length - 4, 4)</text>
                    <text x="175" y="180"
                          font-size="24" fill="white">@MpesaPaymentInfo.RegisteredName</text>
                </svg>
            </div>
            <div class="col-sm-3 mt-5">
                <div style="display: inline-block; text-wrap: nowrap; width: max-content;">
                    <div>
                        <h4>Mpesa</h4>
                    </div>
                    <div style="display: inline-block">
                        @Loc["PhoneNumber"] @Loc["EndingIn"]
                    </div>
                    <div style="display: inline-block; width: 30px;">
                        ••••
                    </div>
                    <div style="display: inline-block">
                        @MpesaPaymentInfo.PhoneNumber.Substring(MpesaPaymentInfo.PhoneNumber.Length - 4, 4)
                    </div>
                    <div>
                        <button class="btn btn-link" style="text-decoration: none; border: none; background-color: transparent" type="button" @onclick="OnEditClicked">
                            @Loc["Edit"]
                        </button>
                        |
                        <button class="btn btn-link text-danger" style="text-decoration: none; border: none; background-color: transparent" type="button" @onclick="OnDeleteClicked">
                            @Loc["Remove"]
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
<MethaWebsite.Components.Account.Pages.Payments.MpesaPages.Edit @ref="EditMpesaPaymentInfo" />
<MethaWebsite.Components.Account.Pages.Payments.MpesaPages.Delete @ref="DeleteMpesaPaymentInfo" />
@code {
    private Mpesa? MpesaPaymentInfo;
    private MpesaPages.Edit? EditMpesaPaymentInfo;
    private MpesaPages.Delete? DeleteMpesaPaymentInfo;

    [Parameter]
    public string DefaultPayment { get; set; } = "";

    [SupplyParameterFromQuery]
    private string? Id { get; set; }

    private int CurrentMonth;
    private int CurrentYear;

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        MpesaPaymentInfo = await context.Mpesa.FirstOrDefaultAsync(m => m.Id == Id);

        CurrentMonth = DateTime.Now.Month;
        CurrentYear = DateTime.Now.Year;

        if (MpesaPaymentInfo is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        if (MpesaPaymentInfo.DefaultPaymentMethod)
        {
            DefaultPayment = Loc["Default"];
        }
        else
        {
            DefaultPayment = "";
        }
    }
    protected override async Task OnParametersSetAsync()
    {
        // Reload the data based on new Id
        await LoadCardDetails(Id!);
    }
    private async Task LoadCardDetails(string Id)
    {
        using var context = DbFactory.CreateDbContext();
        MpesaPaymentInfo = await context.Mpesa.FirstOrDefaultAsync(m => m.Id == Id);

        CurrentMonth = DateTime.Now.Month;
        CurrentYear = DateTime.Now.Year;
        if (MpesaPaymentInfo is not null && MpesaPaymentInfo.DefaultPaymentMethod)
        {
            DefaultPayment = Loc["Default"];
        }
        else
        {
            DefaultPayment = "";
        }
    }
    public void OnEditClicked()
    {
        EditMpesaPaymentInfo.Show();
    }
    public void OnDeleteClicked()
    {
        DeleteMpesaPaymentInfo.Show();
    }
}
