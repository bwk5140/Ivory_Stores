@using Stripe

@inject IConfiguration Configuration
@inject IStringLocalizer<SharedResource> Loc
@inject IJSRuntime JS
@inject HttpClient Http

<div class="container-sm">
    @{
        var showClass = IsVisible ? "d-block" : "d-none";
    }
    <div class="toast-container p-3 @showClass" data-bs-autohide="true" data-bs-delay="5000"
         style="z-index: 1450;">
        <div class="toast show" role="alert" aria-live="assertive" aria-atomic="true"
             style="background-color: white; width: max-content;">
            <div class="toast-header">
                <strong class="me-auto">@Loc["UpdateAccount"]</strong>
                <button type="button" class="btn-close" aria-label="Close" @onclick="Close"></button>
            </div>
            <div class="toast-body">
                <div style="display: inline-block;">
                    <img src="@creditDebitCard.LogoSource" width="30" height="15" />
                </div>
                <div class="ms-4" style="display: inline-block;">
                    <strong>@creditDebitCard.Type</strong>
                </div>
                <div style="display: inline-block;">
                    @Loc["EndingIn"] @creditDebitCard.Number
                </div>
                <div style="display: inline-block; padding-left: 100px;">
                    @creditDebitCard.NameOnCard
                </div>
                <div style="display: inline-block; padding-left: 100px;">
                    @creditDebitCard.ExpirationMonth/@creditDebitCard.ExpirationYear
                </div>
                @if (!Verified)
                {
                    if (!VerificationIssue)
                    {
                        <div class="card mt-2 mb-2" style="border-color: blue; max-width: 1200px;">
                            <div class="card-body">
                                <img src="info-circle.svg" />
                                @Loc["VerifyCardInfo"]
                            </div>
                        </div>
                    }
                    else
                    {
                        if (!string.IsNullOrEmpty(cardNumber))
                        {
                            <div class="card mt-2 mb-2" style="border-color: red; color:red; max-width: 1200px;">
                                <div class="card-body">
                                    <img src="info-circle.svg" />
                                    @Loc["VerificationIssue"]
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="card mt-2 mb-2" style="border-color: red; max-width: 1200px;">
                                <div class="card-body">
                                    <img src="info-circle.svg" />
                                    @Loc["VerifyCardError"]
                                </div>
                            </div>
                        }
                    }
                }
                else
                {
                    <div class="card mt-2 mb-2" style="border-color: green; max-width: 1200px;">
                        <div class="card-body">
                            <img src="check-circle-fill.svg" />
                            @Loc["CardVerified"]
                        </div>
                    </div>
                }
                <div class="mt-2">
                    <div class="card" style="border: none;">
                        <div class="card-body">
                            <div id="card-element"></div>
                        </div>
                    </div>
                    <div class="form form-floating">
                        <button @onclick="VerifyCard" class="btn btn-primary me-2" style="background-color: #2f4f4f;
                                    border-color:transparent; border-radius: 15px;" disabled="@isProcessing">
                            @(isProcessing ? Loc["Verifying"] + "..." : Loc["VerifyCard"])
                        </button>
                    </div>

                </div>
                <div style="text-align: right">
                    <button type="reset" class="btn btn-secondary me-2" style="border: none; font-size: medium;" @onclick="Close">
                        @Loc["Cancel"]
                    </button>
                    <button type="button" class="btn btn-primary me-2" style="background-color: #2f4f4f; border: none;
                                                                        font-size: medium;" @onclick="OnUpdate">
                        @Loc["Update"]
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="@showClass darker-background-lev-2"></div>
</div>


@code {

    [Parameter]
    public bool IsVisible { get; set; } = false;

    [CascadingParameter]
    public CreditDebitCard? creditDebitCard { get; set; }

    [Parameter]
    public string? cardNumber { get; set; }

    [Parameter]
    public bool Verified { get; set; } = false;
    [Parameter]
    public bool VerificationIssue { get; set; } = false;

    [Parameter]
    public string? placeholder { get; set; }

    [Parameter]
    public EventCallback<SaveChangesEventArgs> OnUpdateClicked { get; set; }

    private bool _cardMounted = false;
    private bool isProcessing = false;

    protected override void OnInitialized()
    {
        placeholder = $"{Loc["EndingIn"]} {creditDebitCard.Number}";
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initializeCardElement", "pk_test_51RdfvCR5Q65HyKGxDrFmdKdCtElG1UXSkaUMQy1lqSuoOBIUSYYwrjxd3xJ6gCxoOLMz9E2iiaVkvN84OaB1Zpw500WUtqL6wk");
            _cardMounted = true;
        }
    }
    public void Show()
    {
        IsVisible = true;
        StateHasChanged();
    }

    private void Close()
    {
        IsVisible = false;
        VerificationIssue = false;
        cardNumber = "";
        StateHasChanged();
    }
    private async Task VerifyCard()
    {
        isProcessing = true;
        if (!_cardMounted) return;

        var result = await JS.InvokeAsync<StripeResult>("tokenizeCard");
        if (!string.IsNullOrEmpty(result?.Error))
        {
            VerificationIssue = true;
            Verified = false;
            return;
        }
        var Secretkey = Configuration["Stripe:SecretKey"];
        var Client = new StripeClient(Secretkey);
        var service = new PaymentMethodService(Client);
        var paymentMethod = await service.GetAsync(result.PaymentMethodId);
        var fingerprint = paymentMethod.Card.Fingerprint;

        string savedFingerPrint = creditDebitCard.Fingerprint;
        if (savedFingerPrint == fingerprint)
        {
            Verified = true;
        }
        else
        {
            VerificationIssue = true;
        }
        isProcessing = false;
    }
    private class StripeResult
    {
        public string PaymentMethodId { get; set; }
        public string Fingerprint { get; set; }
        public string Error { get; set; }
    }


    public class VerificationResponse
    {
        public bool Valid { get; set; }
    }

    private void OnVerifyCardClicked()
    {
        if (cardNumber == creditDebitCard.Number)
        {
            Verified = true;
        }
        else
        {
            VerificationIssue = true;
        }
    }
    private async Task OnUpdate()
    {
        if (Verified)
        {
            await OnUpdateClicked.InvokeAsync();
            Close();
        }
        else
        {
            VerificationIssue = true;
        }
    }
}
