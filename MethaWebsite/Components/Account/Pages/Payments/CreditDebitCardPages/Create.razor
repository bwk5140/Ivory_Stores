@page "/Account/Payments/creditdebitcards/create"
@using MethaWebsite.Services
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using MethaWebsite.Data
@using System.Text

@inject IStringLocalizer<SharedResource> Loc
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationUserService ApplicationUserService
@inject IDbContextFactory<MethaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

@rendermode InteractiveServer

<PageTitle>Create</PageTitle>

<div class="container-sm" style="display: block; justify-content: center;">
    @{
        var showClass = IsVisible ? "d-block" : "d-none";
    }
    <div class="toast-container p-3 @showClass" data-bs-autohide="true" data-bs-delay="5000"
         style="top: 35%;">
        <div class="toast show" role="alert" aria-live="assertive" aria-atomic="true"
             style="background-color: white;">
            <div class="toast-header">
                <strong class="me-auto">@Loc["AddCreditOrDebit"]</strong>
                <button type="button" class="btn-close" aria-label="Close" @onclick="Close"></button>
            </div>
            <div class="toast-body">
                <EditForm method="post" Model="CreditDebitCard" OnValidSubmit="AddCreditDebitCard" FormName="create" Enhance>
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" role="alert" />
                    <InputText id="Id" @bind-Value="CreditDebitCard.Id" class="form-control" placeholder="" hidden/>
                    <div class="form form-floating mb-3">
                        <InputText id="cardnumber" @bind-Value="CreditDebitCard.CardNumber" class="form-control" placeholder="" />
                        <label for="cardnumber" class="form-label">@Loc["CardNumber"]:</label>
                        <ValidationMessage For="() => CreditDebitCard.CardNumber" class="text-danger" />
                    </div>
                    <div class="form form-floating mb-3">
                        <InputText id="nameoncard" @bind-Value="CreditDebitCard.NameOnCard" class="form-control" placeholder="" />
                        <label for="nameoncard" class="form-label">@Loc["NameOnCard"]:</label>
                        <ValidationMessage For="() => CreditDebitCard.NameOnCard" class="text-danger" />
                    </div>
                    <label for="expirationmonth" class="form-label">@Loc["ExpirationDate"]:</label>
                    <div class="input-no-focus form form-floating mb-3">
                        <InputSelect id="category" @bind-Value="CreditDebitCard.ExpirationMonth" class="form-select-sm ms-1"
                                     style="border-color: lightgray;">
                            @if (Months!.Any())
                            {
                                @foreach (var month in Months!)
                                {
                                    <option value="@month" style="color: black;">@month</option>
                                }
                            }

                        </InputSelect>
                        <InputSelect id="category" @bind-Value="CreditDebitCard.ExpirationYear" class="form-select-sm ms-1"
                                     style="border-color: lightgray;">
                            @if (Years!.Any())
                            {
                                @foreach (var year in Years!)
                                {
                                    <option value="@year" style="color: black;">@year</option>
                                }
                            }

                        </InputSelect>
                    </div>
                    <div style="text-align: right;">
                        <button type="submit" class="btn btn-primary" style="background-color: #2f4f4f;
                            border-color:transparent; border-radius: 5px;">
                            @Loc["Add"]
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="@showClass darker-background"></div>
</div>

@code {
    private string? errorMessage;

    [SupplyParameterFromForm]
    private CreditDebitCard CreditDebitCard { get; set; } = new();

    [Parameter]
    public bool IsVisible { get; set; } = false;

    [Parameter]
    public List<int>? Months { get; set; } = new List<int>();

    [Parameter]
    public List<int>? Years { get; set; } = new List<int>();

    private ApplicationUser? applicationUser { get; set; }
    public Address? Address { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Months!.Add(CreditDebitCard.ExpirationMonth);
        for (int i = CreditDebitCard.ExpirationMonth + 1; i <= 12; i++)
        {
            Months!.Add(i);
        }
        Years!.Add(CreditDebitCard.ExpirationYear);
        for (int i = CreditDebitCard.ExpirationYear + 1; i <= CreditDebitCard.ExpirationYear + 20; i++)
        {
            Years.Add(i);
        }
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        applicationUser ??= await ApplicationUserService.GetApplicationUser(authState, UserManager);
    }

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddCreditDebitCard()
    {
        using var context = DbFactory.CreateDbContext();
        CreditDebitCard.CardNumber = CreditDebitCard.CardNumber.Replace(" ", "");
        if (!CheckCardValidity(CreditDebitCard.CardNumber))
        {
            errorMessage = "Invalid card number";
            return;
        }
        CreditDebitCard.Type = GetCardType(CreditDebitCard.CardNumber);
        if (!CreditDebitCard.Type.Equals("Invalid"))
        {
            CreditDebitCard.Id = Guid.NewGuid().ToString();
            CreditDebitCard.BillingAddress = applicationUser.DefaultAddressId;
            CreditDebitCard.UserId = applicationUser.Id;
            context.CreditDebitCard.Add(CreditDebitCard);
            await context.SaveChangesAsync();
            NavigationManager.NavigateTo("/Account/Payments", true);
        }
    }
    public bool CheckCardValidity(string number)
    {
        int num, sum = 0, length = number.Length;
        string modified_number = "";
        modified_number.Append(number[0]);
        for (int i = 0; i < length; i++)
        {
            if (i % 2 == 0)
            {
                num = number[i] - '0';
                num = num * 2;
                if (num > 9)
                    num -= 9;
                modified_number += num.ToString();
                sum += num;
            }
            else
            {
                modified_number += number[i];
                sum += number[i] - '0';
            }
        }
        if (sum % 10 == 0)
            return true;
        return false;
    }
    public string GetCardType(string cardNumber)
    {
        if (string.IsNullOrWhiteSpace(cardNumber))
            return "Invalid";

        cardNumber = cardNumber.Replace(" ", "");

        if (cardNumber.StartsWith("4"))
        {
            CreditDebitCard.ImageSource = "generic_card_visa.svg";
            CreditDebitCard.LogoSource = "visa.svg";
            return "Visa";
        }


        if (cardNumber.StartsWith("34") || cardNumber.StartsWith("37"))
        {
            CreditDebitCard.ImageSource = "generic_card_amex.svg";
            CreditDebitCard.LogoSource = "amex.svg";
            return "American Express";
        }

        if (cardNumber.StartsWith("5") && int.TryParse(cardNumber.Substring(0, 2), out int prefix) && prefix >= 51 && prefix <= 55)
        {
            CreditDebitCard.ImageSource = "generic_card_mastercard.svg";
            CreditDebitCard.LogoSource = "mastercard.svg";
            return "Mastercard";
        }

        if (int.TryParse(cardNumber.Substring(0, 4), out int range4) && range4 >= 2221 && range4 <= 2720)
        {
            CreditDebitCard.ImageSource = "generic_card_mastercard.svg";
            CreditDebitCard.LogoSource = "mastercard.svg";
            return "Mastercard";
        }

        if (cardNumber.StartsWith("6011") || cardNumber.StartsWith("65"))
        {
            CreditDebitCard.ImageSource = "generic_card_discover.svg";
            CreditDebitCard.LogoSource = "discover.svg";
            return "Discover";
        }


        if (cardNumber.StartsWith("62"))
        {
            CreditDebitCard.ImageSource = "generic_card_mastercard.svg";
            CreditDebitCard.LogoSource = "unionpay.svg";
            return "UnionPay";
        }

        if (int.TryParse(cardNumber.Substring(0, 4), out int jcbPrefix) && jcbPrefix >= 3528 && jcbPrefix <= 3589)
        {
            CreditDebitCard.ImageSource = "generic_card_visa.svg";
            CreditDebitCard.LogoSource = "jcb.svg";
            return "JCB";
        }

        return "Unknown";
    }
    public void Show()
    {
        IsVisible = true;
        StateHasChanged();
    }

    private void Close()
    {
        IsVisible = false;
        StateHasChanged();
    }
}