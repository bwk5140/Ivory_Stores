@page "/Account/Payments/creditdebitcards/details"
@using Microsoft.EntityFrameworkCore
@using MethaWebsite.Data
@inject IDbContextFactory<MethaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>CreditDebitCard</h2>
    <hr />
    @if (creditdebitcard is null)
    {
        <div class="spinner-border" role="status">   <span class="visually-hidden">Loading...</span> </div>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">NameOnCard</dt>
            <dd class="col-sm-10">@creditdebitcard.NameOnCard</dd>
            <dt class="col-sm-2">CardNumber</dt>
            <dd class="col-sm-10">@creditdebitcard.CardNumber</dd>
            <dt class="col-sm-2">ExpirationMonth</dt>
            <dd class="col-sm-10">@creditdebitcard.ExpirationMonth</dd>
            <dt class="col-sm-2">ExpirationYear</dt>
            <dd class="col-sm-10">@creditdebitcard.ExpirationYear</dd>
            <dt class="col-sm-2">Image</dt>
            <dd class="col-sm-10">@creditdebitcard.ImageSource</dd>
            <dt class="col-sm-2">UserId</dt>
            <dd class="col-sm-10">@creditdebitcard.UserId</dd>
            <dt class="col-sm-2">BillingAddress</dt>
            <dd class="col-sm-10">@creditdebitcard.BillingAddress</dd>
            <dt class="col-sm-2">Type</dt>
            <dd class="col-sm-10">@creditdebitcard.Type</dd>
        </dl>
        <div>
            <a href="@($"/creditdebitcards/edit?id={creditdebitcard.Id}")">Edit</a> |
            <a href="@($"/creditdebitcards")">Back to List</a>
        </div>
    }
</div>

@code {
    private CreditDebitCard? creditdebitcard;

    [SupplyParameterFromQuery]
    private string Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        creditdebitcard = await context.CreditDebitCard.FirstOrDefaultAsync(m => m.Id == Id);

        if (creditdebitcard is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
