@page "/shoppingcarts/details"
@using Microsoft.EntityFrameworkCore
@using MethaWebsite.Data
@inject IDbContextFactory<MethaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>ShoppingCart</h2>
    <hr />
    @if (shoppingcart is null)
    {
        <div class="card" style="z-index: 1400;  max-width: 70px;"><div class="card-body"><div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span> </div></div></div>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Subtotal</dt>
            <dd class="col-sm-10">@shoppingcart.Subtotal</dd>
            <dt class="col-sm-2">IsSelected</dt>
            <dd class="col-sm-10">@shoppingcart.IsSelected</dd>
        </dl>
        <div>
            <a href="@($"/shoppingcarts/edit?id={shoppingcart.Id}")">Edit</a> |
            <a href="@($"/shoppingcarts")">Back to List</a>
        </div>
    }
</div>

@code {
    private ShoppingCart? shoppingcart;

    [SupplyParameterFromQuery]
    private string Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        shoppingcart = await context.ShoppingCart.FirstOrDefaultAsync(m => m.Id == Id);

        if (shoppingcart is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
