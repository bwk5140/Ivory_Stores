@page "/shoppingcarts/create"
@using Microsoft.EntityFrameworkCore
@using MethaWebsite.Data
@inject IDbContextFactory<MethaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>ShoppingCart</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="ShoppingCart" OnValidSubmit="AddShoppingCart" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <label for="subtotal" class="form-label">Subtotal:</label> 
                <InputNumber id="subtotal" @bind-Value="ShoppingCart.Subtotal" class="form-control" /> 
                <ValidationMessage For="() => ShoppingCart.Subtotal" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="isselected" class="form-label">IsSelected:</label> 
                <InputCheckbox id="isselected" @bind-Value="ShoppingCart.IsSelected" class="form-check-input" /> 
                <ValidationMessage For="() => ShoppingCart.IsSelected" class="text-danger" /> 
            </div>        
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/shoppingcarts">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private ShoppingCart ShoppingCart { get; set; } = new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddShoppingCart()
    {
        using var context = DbFactory.CreateDbContext();
        context.ShoppingCart.Add(ShoppingCart);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/shoppingcarts");
    }
}
