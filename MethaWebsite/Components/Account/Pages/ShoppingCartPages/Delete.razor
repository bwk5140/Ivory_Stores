@page "/shoppingcarts/delete"

@inject IDbContextFactory<MethaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>ShoppingCart</h2>
    <hr />
    @if (shoppingcart is null)
    {
        <div class="card" style="z-index: 1400;  max-width: 70px;"><div class="card-body"><div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span> </div></div></div>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Subtotal</dt>
            <dd class="col-sm-10">@shoppingcart.Subtotal</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">IsSelected</dt>
            <dd class="col-sm-10">@shoppingcart.IsSelected</dd>
        </dl>
        <EditForm method="post" Model="shoppingcart" OnValidSubmit="DeleteShoppingCart" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(shoppingcart is null)">Delete</button> |
            <a href="/shoppingcarts">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private ShoppingCart? shoppingcart;

    [SupplyParameterFromQuery]
    private string Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        shoppingcart = await context.ShoppingCart.FirstOrDefaultAsync(m => m.Id == Id);

        if (shoppingcart is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteShoppingCart()
    {
        using var context = DbFactory.CreateDbContext();
        context.ShoppingCart.Remove(shoppingcart!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/shoppingcarts");
    }
}
