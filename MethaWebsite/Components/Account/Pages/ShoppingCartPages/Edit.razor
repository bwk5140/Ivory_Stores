@page "/shoppingcarts/edit"
@using Microsoft.EntityFrameworkCore
@using MethaWebsite.Data
@inject IDbContextFactory<MethaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>ShoppingCart</h2>
<hr />
@if (ShoppingCart is null)
{
    <div class="spinner-border" role="status">   <span class="visually-hidden">Loading...</span> </div>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="ShoppingCart" OnValidSubmit="UpdateShoppingCart" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="ShoppingCart.Id" value="@ShoppingCart.Id" />
                <div class="mb-3">
                    <label for="subtotal" class="form-label">Subtotal:</label>
                    <InputNumber id="subtotal" @bind-Value="ShoppingCart.Subtotal" class="form-control" />
                    <ValidationMessage For="() => ShoppingCart.Subtotal" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="isselected" class="form-label">IsSelected:</label>
                    <InputCheckbox id="isselected" @bind-Value="ShoppingCart.IsSelected" class="form-check-input" />
                    <ValidationMessage For="() => ShoppingCart.IsSelected" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/shoppingcarts">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private string Id { get; set; }

    [SupplyParameterFromForm]
    private ShoppingCart? ShoppingCart { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        ShoppingCart ??= await context.ShoppingCart.FirstOrDefaultAsync(m => m.Id == Id);

        if (ShoppingCart is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateShoppingCart()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(ShoppingCart!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!ShoppingCartExists(ShoppingCart!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/shoppingcarts");
    }

    private bool ShoppingCartExists(string id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.ShoppingCart.Any(e => e.Id == id);
    }
}
