@page "/clicks/delete"
@using Microsoft.EntityFrameworkCore
@using MethaWebsite.Data
@inject IDbContextFactory<MethaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Click</h2>
    <hr />
    @if (click is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">position</dt>
            <dd class="col-sm-10">@click.position</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">ProductId</dt>
            <dd class="col-sm-10">@click.ProductId</dd>
        </dl>
        <EditForm method="post" Model="click" OnValidSubmit="DeleteClick" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(click is null)">Delete</button> |
            <a href="/clicks">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Click? click;

    [SupplyParameterFromQuery]
    private string Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        click = await context.Click.FirstOrDefaultAsync(m => m.Id == Id);

        if (click is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteClick()
    {
        using var context = DbFactory.CreateDbContext();
        context.Click.Remove(click!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/clicks");
    }
}
