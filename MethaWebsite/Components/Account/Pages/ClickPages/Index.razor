@page "/clicks"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using MethaWebsite.Data
@using MethaWebsite.Data.Contexts
@implements IAsyncDisposable
@inject IDbContextFactory<MethaWebsite.Data.Contexts.ApplicationDbContext> DbFactory

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
    <a href="clicks/create">Create New</a>
</p>

<QuickGrid Class="table" Items="context.Click">
    <PropertyColumn Property="click => click.position" />
    <PropertyColumn Property="click => click.ProductId" />

    <TemplateColumn Context="click">
        <a href="@($"clicks/edit?id={click.Id}")">Edit</a> |
        <a href="@($"clicks/details?id={click.Id}")">Details</a> |
        <a href="@($"clicks/delete?id={click.Id}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private ApplicationDbContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
