@page "/clicks/edit"
@using Microsoft.EntityFrameworkCore
@using MethaWebsite.Data
@inject IDbContextFactory<MethaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>Click</h2>
<hr />
@if (Click is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Click" OnValidSubmit="UpdateClick" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="Click.Id" value="@Click.Id" />
                <div class="mb-3">
                    <label for="position" class="form-label">position:</label>
                    <InputNumber id="position" @bind-Value="Click.position" class="form-control" />
                    <ValidationMessage For="() => Click.position" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="productid" class="form-label">ProductId:</label>
                    <InputText id="productid" @bind-Value="Click.ProductId" class="form-control" />
                    <ValidationMessage For="() => Click.ProductId" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/clicks">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private string Id { get; set; }

    [SupplyParameterFromForm]
    private Click? Click { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Click ??= await context.Click.FirstOrDefaultAsync(m => m.Id == Id);

        if (Click is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateClick()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Click!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!ClickExists(Click!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/clicks");
    }

    private bool ClickExists(string id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Click.Any(e => e.Id == id);
    }
}
