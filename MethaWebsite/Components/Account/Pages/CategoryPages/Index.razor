@page "/Account/categories"
@using MethaWebsite.Data
@using MethaWebsite.Data.Contexts
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore

@inject IStringLocalizer<SharedResource> Loc
@implements IAsyncDisposable
@inject IDbContextFactory<MethaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

@rendermode InteractiveServer

<PageTitle>Index</PageTitle>
<div class="container-sm mt-5">
    <h3 class="header mt-3">@Loc["Categories"]</h3>
    <QuickGrid Class="table" Items="context.Category">
        <TemplateColumn Context="category">
            <div class="mt-3">
                <a style="text-decoration:none;"
                   href="@($"Account/categories/details?id={category.Id}")">@category.Name</a>
            </div>
            <div style="text-align: right;">
                <div class="btn-group">
                    <button type="button" class="btn" data-bs-toggle="tooltip" title="@Loc["Edit"] @category.Name"
                            @onclick="@(() => OnEditClicked(category))">
                        <img src="pencil-fill.svg" />
                    </button>
                    <button type="button" class="btn" data-bs-toggle="tooltip" title="@Loc["Delete"] @category.Name"
                            @onclick="@(() => OnDeleteClicked(category))">
                        <img src="trash.svg" />
                    </button>
                </div>
            </div>
        </TemplateColumn>
    </QuickGrid>
</div>

@code {
    private ApplicationDbContext context = default!;

    protected override async Task OnInitializedAsync()
    {
        context = await DbFactory.CreateDbContextAsync();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();

    public void OnCreateClicked()
    {
        NavigationManager.NavigateTo("Account/categories/create");
    }
    public void OnEditClicked(Category category)
    {
        NavigationManager.NavigateTo($"Account/categories/edit?id={category.Id}");
    }
    public void OnDeleteClicked(Category category)
    {
        NavigationManager.NavigateTo($"Account/categories/delete?id={category.Id}");
    }
}
