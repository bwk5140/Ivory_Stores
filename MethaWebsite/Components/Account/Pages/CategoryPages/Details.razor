@page "/Account/categories/details"
@using MethaWebsite.Data
@using MethaWebsite.Data.Contexts
@using Microsoft.EntityFrameworkCore

@inject IStringLocalizer<SharedResource> Loc
@inject IDbContextFactory<MethaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

@rendermode InteractiveServer

<PageTitle>Details</PageTitle>

<div class="container-sm mt-5">
    @if (category is null)
    {
        <div class="card" style="z-index: 1400;  max-width: 70px;"><div class="card-body"><div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span> </div></div></div>
    }
    else {
        
        <div class="toast-container p-3" data-bs-autohide="true" data-bs-delay="5000">
            <div class="toast show" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="toast-header">
                    <strong class="me-auto">@Loc["Category"] (@category.Name)</strong>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="Close"></button>
                </div>
                <div class="toast-body">
                    <dl class="row">
                        <dt class="col">Name</dt>
                        <dd class="col">@category.Name</dd>
                    </dl>
                    <dl class="row">
                        <dt class="col">Parent Category</dt>
                        @if (parentCategory is not null)
                        {
                            <dd class="col">@parentCategory.Name</dd>
                        }
                        else
                        {
                            <dd class="col">None</dd>
                        }
                    </dl>
                    <div style="text-align: right;">
                        <button type="button" class="btn" @onclick="OnEditClicked" data-bs-toggle="tooltip" title="@Loc["Edit"] @category.Name">
                            <img src="pencil-fill.svg" />
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private Category? category;

    [SupplyParameterFromQuery]
    private string? Id { get; set; }

    [Parameter]
    public Category? parentCategory { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        category = await context.Category.FirstOrDefaultAsync(m => m.Id == Id);

        if (category is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        else
        {
            parentCategory = await context.Category.FirstOrDefaultAsync(m => m.Id == category.ParentID);
        }
    }
    private void Close()
    {
        NavigationManager.NavigateTo("Account/categories");
    }
    private void OnEditClicked()
    {
        NavigationManager.NavigateTo($"/Account/categories/edit?id={category.Id}");
    }
}
