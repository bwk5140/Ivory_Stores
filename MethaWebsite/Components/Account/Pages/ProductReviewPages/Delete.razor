@page "/product/review/delete"
@using Microsoft.EntityFrameworkCore
@using MethaWebsite.Data
@inject IDbContextFactory<MethaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>ProductReview</h2>
    <hr />
    @if (productreview is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Subject</dt>
            <dd class="col-sm-10">@productreview.Subject</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Created</dt>
            <dd class="col-sm-10">@productreview.Created</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@productreview.Description</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">ProductId</dt>
            <dd class="col-sm-10">@productreview.ProductId</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">UserId</dt>
            <dd class="col-sm-10">@productreview.UserId</dd>
        </dl>
        <EditForm method="post" Model="productreview" OnValidSubmit="DeleteProductReview" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(productreview is null)">Delete</button> |
            <a href="/product/review">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private ProductReview? productreview;

    [SupplyParameterFromQuery]
    private string Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        productreview = await context.ProductReview.FirstOrDefaultAsync(m => m.Id == Id);

        if (productreview is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteProductReview()
    {
        using var context = DbFactory.CreateDbContext();
        context.ProductReview.Remove(productreview!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/product/review");
    }
}
