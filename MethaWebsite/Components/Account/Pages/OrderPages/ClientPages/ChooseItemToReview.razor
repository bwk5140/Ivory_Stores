@page "/product/review/choose"

@inject IStringLocalizer<SharedResource> Loc
@inject IDbContextFactory<MethaWebsite.Data.Contexts.ApplicationDbContext> DbFactory

<div class="container-sm mt-5 mb-5">
    <div class="card">
        <div class="card-body">
            <h3 class="mb-4">@Loc["ChooseItemToReview"]</h3>
            <table class="table">
                <tbody>
                    @if (Products is not null)
                    {
                        foreach (var product in Products)
                        {
                            <tr>
                                <td>
                                    <div class="row mt-3">
                                        @{
                                            using var context = DbFactory.CreateDbContext();
                                            product.Images = context.ProductImage.Where(p => p.ProductColorGroupId == product.ProductColorGroupID).OrderBy(p => p.Created).ToList();
                                            var CurrentImage = product.Images[0];
                                        }
                                        <div class="col-sm-2" style="padding: 0px;">
                                            <a href="@($"product/details?id={product.Id}")" class="btn">
                                                <img class="card-img-top" src="@(string.Format("data:image/jpg;base64,{0}", Convert.ToBase64String(CurrentImage.Image!)))"
                                                     alt=@Loc["ProductImage"] style="width:100px; height:100px; object-fit:contain; vertical-align: central;" />
                                            </a>
                                        </div>
                                        <div class="col-sm-7">
                                            <div style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;text-overflow: ellipsis; ">
                                                @product.Name
                                            </div>
                                        </div>
                                        <div class="col-sm-3">
                                            <div>
                                                <a href="@($"product/review/create?id={product.Id}")" class="btn btn-primary mt-1 me-2" style="background-color: #2f4f4f; border-radius: 25px; color: white; width: 200px;">
                                                    @Loc["WriteReview"]
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@code {
    [Parameter]
    public List<Product>? Products { get; set; }

    [Parameter]
    public Order? order { get; set; }

    [SupplyParameterFromQuery]
    public string? Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        order = await context.Order.FirstOrDefaultAsync(o => o.Id == Id);
        if (order is not null)
        {
            Products = context.Product.AsEnumerable().Where(p => order.ProductIds.Contains(p.Id)).ToList();
        }
    }
}
