@page "/Account/Orders/pwo"
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

@inject IStringLocalizer<SharedResource> Loc
@inject ApplicationUserService ApplicationUserService
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@inject IDbContextFactory<MethaWebsite.Data.Contexts.ApplicationDbContext> DbFactory

@rendermode InteractiveServer


<div class="container-sm mt-5 mb-5">
    <nav style="--bs-breadcrumb-divider: '>';" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="AccountSettings" style="text-decoration: none;">
                    @Loc["YourAccount"]
                </a>
            </li>
            <li class="breadcrumb-item">
                <a href="/Account/Orders" style="text-decoration: none;">
                    @Loc["YourOrders"]
                </a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">@Loc["ProblemWithOrder"]</li>
        </ol>
    </nav>
    <h3>@Loc["ProblemWithOrder"]</h3>

    @if (order is not null)
    {
        using var context = DbFactory.CreateDbContext();
        if (ApplicationUser is not null)
        {
            if (order is not null && order.ProductIds is not null && Products is not null)
            {
                <div class="card mb-3" style="max-width: 1000px; padding: 0px;">
                    <div class="card-body">
                        @foreach (var product in Products)
                        {
                            product.Images = context.ProductImage.Where(p => p.ProductColorGroupId == product.ProductColorGroupID).OrderBy(p => p.Created).ToList();
                            var CurrentImage = product.Images[0];

                            <div class="row mt-3">
                                <div class="col-sm-2" style="padding: 0px;">
                                    <a href="@($"product/details?id={product.Id}")" class="btn">
                                        <img class="card-img-top" src="@(string.Format("data:image/jpg;base64,{0}", Convert.ToBase64String(CurrentImage.Image!)))"
                                             alt=@Loc["ProductImage"] style="width:100px; height:100px; object-fit:contain; vertical-align: central;" />
                                    </a>
                                </div>
                                <div class="col-sm-6">
                                    <a href="@($"product/details?id={product.Id}")" style="padding: 0px; text-decoration:none;">
                                        <p>@product.Name</p>
                                    </a>
                                </div>
                                @if (Products.IndexOf(product) == 0)
                                {
                                    <div class="col-sm-4">
                                        <div style="text-wrap: nowrap; color: gray;">
                                            @Loc["OrderPlacedSmall"]
                                        </div>
                                        <div style="text-wrap: nowrap;">
                                            @order.Date.ToString("MMMM") @order.Date.Day, @order.Date.Year
                                        </div>
                                        <div style="text-wrap: nowrap; color: gray;">
                                            @Loc["Order"]
                                        </div>
                                        <div style="text-wrap: nowrap;">
                                            <a href="@($"Account/Order/details?id={order.Id}")" style="text-decoration: none;">
                                                @order.Id
                                            </a>
                                        </div>
                                        <div style="text-wrap: nowrap; color: gray;">
                                            @Loc["ExpectedBy"]
                                        </div>
                                        <div style="text-wrap: nowrap;">
                                            @ExpectedBy.ToString("MMMM") @ExpectedBy.Day, @ExpectedBy.Year
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
                @if (!IssueClicked["PackageDidntArrive"] && !IssueClicked["MissingItems"] && !IssueClicked["DamagedOrDefective"]
                    && !IssueClicked["DifferentFromOrder"] && !IssueClicked["OtherIssue"])
                {
                    <h5>@Loc["WhatWentWrong"]</h5>
                }
                <div class="card mb-3" style="max-width: 1000px; padding: 0px;">
                    <div class="card-body">
                        <table class="table">
                            <tbody>
                                <tr>
                                    @if (!IssueClicked["PackageDidntArrive"] && !IssueClicked["MissingItems"] && !IssueClicked["DamagedOrDefective"]
                                                            && !IssueClicked["DifferentFromOrder"] && !IssueClicked["OtherIssue"])
                                    {
                                        <td>
                                            <button type="button" class="btn btn-link" style="text-decoration: none; padding: 0px;"
                                                    @onclick="@(() => OnIssueClicked("PackageDidntArrive"))">
                                                @Loc["PackageDidntArrive"]
                                            </button>
                                        </td>
                                    }
                                </tr>
                                <tr>
                                    @if (!IssueClicked["PackageDidntArrive"] && !IssueClicked["MissingItems"] && !IssueClicked["DamagedOrDefective"]
                                                            && !IssueClicked["DifferentFromOrder"] && !IssueClicked["OtherIssue"])
                                    {
                                        <td>
                                            <button type="button" class="btn btn-link" style="text-decoration: none; padding: 0px;"
                                                    @onclick="@(() => OnIssueClicked("MissingItems"))">
                                                @Loc["MissingItems"]
                                            </button>
                                        </td>
                                    }
                                </tr>
                                <tr>
                                    @if (!IssueClicked["PackageDidntArrive"] && !IssueClicked["MissingItems"] && !IssueClicked["DamagedOrDefective"]
                                                            && !IssueClicked["DifferentFromOrder"] && !IssueClicked["OtherIssue"])
                                    {
                                        <td>
                                            <button type="button" class="btn btn-link" style="text-decoration: none; padding: 0px;"
                                                    @onclick="@(() => OnIssueClicked("DamagedOrDefective"))">
                                                @Loc["DamagedOrDefective"]
                                            </button>
                                        </td>
                                    }
                                </tr>
                                <tr>
                                    @if (!IssueClicked["PackageDidntArrive"] && !IssueClicked["MissingItems"] && !IssueClicked["DamagedOrDefective"]
                                                            && !IssueClicked["DifferentFromOrder"] && !IssueClicked["OtherIssue"])
                                    {
                                        <td>
                                            <button type="button" class="btn btn-link" style="text-decoration: none; padding: 0px;"
                                                    @onclick="@(() => OnIssueClicked("DifferentFromOrder"))">
                                                @Loc["DifferentFromOrder"]
                                            </button>
                                        </td>
                                    }
                                </tr>
                                <tr>
                                    @if (!IssueClicked["PackageDidntArrive"] && !IssueClicked["MissingItems"] && !IssueClicked["DamagedOrDefective"]
                                                            && !IssueClicked["DifferentFromOrder"] && !IssueClicked["OtherIssue"])
                                    {
                                        <td>
                                            <button type="button" class="btn btn-link" style="text-decoration: none; padding: 0px;"
                                                    @onclick="@(() => OnIssueClicked("OtherIssue"))">
                                                @Loc["OtherIssue"]
                                            </button>
                                        </td>
                                    }
                                </tr>
                            </tbody>
                        </table>
                        @if (IssueClicked["PackageDidntArrive"])
                        {
                            <div class="row">
                                <div class="col-sm-10">
                                    <h5>@Loc["PackageDidntArrive"]</h5>
                                </div>
                                <div class="col-sm-2" style="text-align: right;">
                                    <button class="btn btn-link" type="button" style="border: none; background-color: transparent; padding:0px; text-decoration: none;"
                                            @onclick="@(() => OnChange("PackageDidntArrive"))">
                                        @Loc["Change"]
                                    </button>
                                </div>
                            </div>
                        }
                        @if (IssueClicked["MissingItems"])
                        {
                            <div class="row">
                                <div class="col-sm-10">
                                    <h5>@Loc["MissingItems"]</h5>
                                </div>
                                <div class="col-sm-2" style="text-align: right;">
                                    <button class="btn btn-link" type="button" style="border: none; background-color: transparent; padding:0px; text-decoration: none;"
                                            @onclick="@(() => OnChange("MissingItems"))">
                                        @Loc["Change"]
                                    </button>
                                </div>
                            </div>
                        }
                        @if (IssueClicked["DamagedOrDefective"])
                        {
                            <div class="row">
                                <div class="col-sm-10">
                                    <h5>@Loc["DamagedOrDefective"]</h5>
                                </div>
                                <div class="col-sm-2" style="text-align: right;">
                                    <button class="btn btn-link" type="button" style="border: none; background-color: transparent; padding:0px; text-decoration: none;"
                                            @onclick="@(() => OnChange("DamagedOrDefective"))">
                                        @Loc["Change"]
                                    </button>
                                </div>
                            </div>
                        }
                        @if (IssueClicked["DifferentFromOrder"])
                        {
                            <div class="row">
                                <div class="col-sm-10">
                                    <h5>@Loc["DifferentFromOrder"]</h5>
                                </div>
                                <div class="col-sm-2" style="text-align: right;">
                                    <button class="btn btn-link" type="button" style="border: none; background-color: transparent; padding:0px; text-decoration: none;"
                                            @onclick="@(() => OnChange("DifferentFromOrder"))">
                                        @Loc["Change"]
                                    </button>
                                </div>
                            </div>
                        }
                        @if (IssueClicked["OtherIssue"])
                        {
                            <div class="row">
                                <div class="col-sm-10">
                                    <h5>@Loc["OtherIssue"]</h5>
                                </div>
                                <div class="col-sm-2" style="text-align: right;">
                                    <button class="btn btn-link" type="button" style="border: none; background-color: transparent; padding:0px; text-decoration: none;"
                                            @onclick="@(() => OnChange("OtherIssue"))">
                                        @Loc["Change"]
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                var problem = context.OrderProblem.FirstOrDefault(o => o.Name == CurrentIssue);
                if (!string.IsNullOrWhiteSpace(CurrentIssue))
                {
                    <div class="card" style="max-width: 1000px;">
                        <div class="card-body">
                            <h5 class="mb-3">@Loc["ContactUs"]</h5>
                            @if (problem is not null && problem.Subjects.Any())
                            {
                                <InputSelect id="category" @bind-Value="Subject" class="form-select-sm ms-1 mb-3"
                                             style="border-color: lightgray;">
                                    <option selected disabled value="" style="color: gray;">@Loc["SelectReason"]</option>
                                    @foreach (var subject in problem.Subjects)
                                    {
                                        <option value="@subject" style="color: black;">@subject</option>
                                    }
                                </InputSelect>

                            }
                            <CascadingValue Value="Subject">
                                <MethaWebsite.Components.Account.Pages.MessagePages.Create @ref="CreateMessage" />
                            </CascadingValue>
                        </div>
                    </div>
                }
            }
        }
    }
</div>
@code {

    private ApplicationUser? ApplicationUser { get; set; }
    private Dictionary<string, bool> show = new();
    private MethaWebsite.Components.Account.Pages.MessagePages.Create? CreateMessage;

    [Parameter]
    public List<Product>? Products { get; set; }

    [Parameter]
    public Order? order { get; set; }

    [SupplyParameterFromQuery]
    public string? OrderId { get; set; }

    [SupplyParameterFromQuery]
    public string? ProductId { get; set; }

    [Parameter]
    public DateTime ExpectedBy { get; set; }

    [Parameter]
    public string? CurrentIssue { get; set; }

    [Parameter]
    public string? Subject { get; set; }

    private Dictionary<string, bool> IssueClicked { get; set; } = new();
    private Dictionary<string, Action> keywordActions;
    private List<OrderProblem> orderProblems { get; set; } = new List<OrderProblem>();

    protected override async Task OnInitializedAsync()
    {
        using var context = await DbFactory.CreateDbContextAsync();

        ApplicationUser ??= await ApplicationUserService.GetApplicationUser();
        order = await context.Order.FirstOrDefaultAsync(o => o.Id == OrderId);
        if (order is not null)
        {
            Products = context.Product.AsEnumerable().Where(p => order.ProductIds.Contains(p.Id))
            .GroupBy(p => p.Id)
            .Select(p => p.First()).ToList();
            ExpectedBy = order.Date.AddDays(order.ShippingTime);
        }
        IssueClicked["PackageDidntArrive"] = false;
        IssueClicked["MissingItems"] = false;
        IssueClicked["DamagedOrDefective"] = false;
        IssueClicked["DifferentFromOrder"] = false;
        IssueClicked["OtherIssue"] = false;

        keywordActions = new Dictionary<string, Action>()
        {
            {"PackageDidntArrive", ()=> AddPackageDidntArriveSubjects() },
            {"MissingItems", ()=> AddMissingItemsSubjects() },
            {"DamagedOrDefective", ()=> AddDamagedOrDefectiveSubjects() },
            {"DifferentFromOrder", ()=> AddDifferentFromOrderSubjects() },
            {"OtherIssue", ()=> AddOtherIssueSubjects() },
        };

        foreach (var item in IssueClicked){
            var problem = await context.OrderProblem.FirstOrDefaultAsync(o => o.Name == item.Key);
            if (problem is null)
            {
                problem = new OrderProblem();
                problem.Name = item.Key;
                problem.Subjects = new List<string>();
                context.OrderProblem.Add(problem);
            }
        }
        await context.SaveChangesAsync();
    }
    private bool TrySetOrderProblemMessageSubject(string name, Dictionary<string, Action> keywordActions)
    {
        foreach (var kvp in keywordActions)
        {
            if (name.Contains(kvp.Key, StringComparison.OrdinalIgnoreCase))
            {
                kvp.Value.Invoke();
                return true;
            }
        }
        return false;
    }
    private async Task AddPackageDidntArriveSubjects()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        var problem = await context.OrderProblem.FirstOrDefaultAsync(o => o.Name == "PackageDidntArrive");
        if (problem is not null && !problem.Subjects.Any())
        {
            problem.Subjects.Add(Loc["RefundWanted"]);
            problem.Subjects.Add(Loc["ReplacementWanted"]);
            problem.Subjects.Add(Loc["WhereIsMyStuff"]);
            context.OrderProblem.Attach(problem).State = EntityState.Modified;
            await context.SaveChangesAsync();
        }
    }
    private void AddMissingItemsSubjects()
    {
        Subject = Loc["MissingItems"];
    }
    private void AddDamagedOrDefectiveSubjects()
    {
        Subject = Loc["DamagedOrDefective"];
    }
    private void AddDifferentFromOrderSubjects()
    {
        Subject = Loc["DifferentFromOrder"];
    }
    private async Task AddOtherIssueSubjects()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        var problem = await context.OrderProblem.FirstOrDefaultAsync(o => o.Name == "OtherIssue");
        if (problem is not null && !problem.Subjects.Any())
        {
            problem.Subjects.Add(Loc["ShippingQuestion"]);
            problem.Subjects.Add(Loc["ReturnsAndRefundQuestion"]);
            problem.Subjects.Add(Loc["RequestCancellation"]);
            problem.Subjects.Add(Loc["ProductQuestion"]);
            problem.Subjects.Add(Loc["ProductCustomization"]);
            problem.Subjects.Add(Loc["RequestInvoice"]);
            problem.Subjects.Add(Loc["OtherIssue"]);
            context.OrderProblem.Attach(problem).State = EntityState.Modified;
            await context.SaveChangesAsync();
        }

    }
    private void OnChange(string issue)
    {
        CurrentIssue = "";
        Subject = "";
        IssueClicked[issue] = false;
    }
    private void OnIssueClicked(string issue)
    {
        bool SubjectsAdded = TrySetOrderProblemMessageSubject(issue, keywordActions);
        IssueClicked[issue] = true;
        CurrentIssue = issue;
    }
}
