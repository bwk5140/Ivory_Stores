@page "/Account/Manage"

@using System.ComponentModel.DataAnnotations
@using MethaWebsite.Services
@using Microsoft.AspNetCore.Identity
@using MethaWebsite.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager
@inject ApplicationUserService ApplicationUserService

@inject IStringLocalizer<SharedResource> Loc

<PageTitle>Profile</PageTitle>
<div class="container-lg" style="max-width: 700px;">
    <h3>@Loc["Username"]</h3>
    <StatusMessage />
    <div class="row">
        <div class="col-xl-6">
            <EditForm Model="Input" FormName="profile" OnValidSubmit="OnValidSubmitAsync" method="post">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" role="alert" />
                <div class="form-floating mb-3">
                    <input type="text" value="@username" id="username" class="form-control" placeholder="Choose your username" disabled />
                    <label for="username" class="form-label">Current Username</label>
                </div>
                <div class="form-floating mb-3">
                    <InputText @bind-Value="Input.Username" id="Input.Username" class="form-control" placeholder="Change username" />
                    <label for="Input.Username" class="form-label">New Username</label>
                    <ValidationMessage For="() => Input.Username" class="text-danger" />
                </div>
                <button type="submit" class="w-100 btn btn-lg btn-primary" style="background-color: #2f4f4f;
                        border-color:transparent; border-radius: 5px;">
                    Save
                </button>
            </EditForm>
        </div>
    </div>
</div>


@code {
    private ApplicationUser user = default!;
    private string? username;
    private string? newUsername;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        username = await UserManager.GetUserNameAsync(user);
    }

    private async Task OnValidSubmitAsync()
    {
        if (Input.Username != username)
        {
            var setUsernameResult = await UserManager.SetUserNameAsync(user, Input.Username);
            if (!setUsernameResult.Succeeded)
            {
                RedirectManager.RedirectToCurrentPageWithStatus("Error: Username is already taken.", HttpContext);
            }
        }

        await SignInManager.RefreshSignInAsync(user);
        ApplicationUserService.UpdateUser(user);
        RedirectManager.RedirectToCurrentPageWithStatus("Your profile has been updated", HttpContext);
    }

    private sealed class InputModel
    {
        [Required]
        [Display(Name = "New username")]
        public string? Username { get; set; }
    }
}

