@page "/Account/ForgotPasswordConfirmation"

<PageTitle>Forgot password confirmation</PageTitle>

<div class="container">
    <div class="row box" style="border-radius: 25px; max-width: 400px;">
        <div class="col mb-3">
            <h2>Forgot password confirmation</h2>
            <p role="alert">
                Please check your email to reset your password.
            </p>
        </div>
    </div>
</div>
