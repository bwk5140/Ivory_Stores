@page "/countries/edit"
@using Microsoft.EntityFrameworkCore
@using MethaWebsite.Data

@inject IStringLocalizer<SharedResource> Loc
@inject IDbContextFactory<MethaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

@if (Country is null)
{
    <div class="card" style="z-index: 1400;  max-width: 70px;"><div class="card-body"><div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span> </div></div></div>
}
else
{

    <div class="container-sm mt-5" style="display: flex; justify-content: center;">
        @{
            var showClass = IsVisible ? "d-block" : "d-none";
        }
        <div class="toast-container p-3 @showClass" data-bs-autohide="true" data-bs-delay="5000">
            <div class="toast show" role="alert" aria-live="assertive" aria-atomic="true"
                 style="width: fit-content; max-width: 550px; max-height: 600px; overflow-y: auto;
                        background-color: white;">
                <div class="toast-header">
                    <strong class="me-auto">@Loc["EditCountry"]</strong>
                    <button type="button" class="btn-close" data-bs-toggle="tooltip" title=@Loc["Cancel"]
                            aria-label="Close" @onclick="Close"></button>
                </div>
                <div class="toast-body">

                    <EditForm method="post" Model="Country" OnValidSubmit="UpdateCountry" FormName="edit" Enhance>
                        <DataAnnotationsValidator />
                        <ValidationSummary role="alert" />
                        <input type="hidden" name="Country.Id" value="@Country.Id" />
                        <div class="mb-3 form form-floating">
                            <InputText id="name" @bind-Value="Country.Name" class="form-control" />
                            <label for="name" class="form-label">Name:</label>
                            <ValidationMessage For="() => Country.Name" class="text-danger" />
                        </div>
                        <div class="mb-3 form form-floating">
                            <InputText id="code" @bind-Value="Country.Code" class="form-control" />
                            <label for="code" class="form-label">Code:</label>
                            <ValidationMessage For="() => Country.Code" class="text-danger" />
                        </div>
                        <div class="ms-1" style="text-align: right;">
                            <button type="submit" class="btn btn-primary" style="background-color: #2f4f4f;
                                    border-color:transparent; border-radius: 5px;">
                                @Loc["Save"]
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery]
    private string? Id { get; set; }

    [SupplyParameterFromForm]
    private Country? Country { get; set; }

    [Parameter]
    public bool IsVisible { get; set; } = true;

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Country ??= await context.Country.FirstOrDefaultAsync(m => m.Id == Id);

        if (Country is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateCountry()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Country!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!CountryExists(Country!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/countries");
    }

    private bool CountryExists(string id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Country.Any(e => e.Id == id);
    }
    public void Show()
    {
        IsVisible = true;
        StateHasChanged();
    }
    private void Close()
    {
        IsVisible = false;
        StateHasChanged();
        NavigationManager.NavigateTo("/countries");
    }
}
