@page "/productissues/details"
@using Microsoft.EntityFrameworkCore
@using MethaWebsite.Data
@inject IDbContextFactory<MethaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>ProductIssue</h2>
    <hr />
    @if (productissue is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Type</dt>
            <dd class="col-sm-10">@productissue.Type</dd>
            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@productissue.Description</dd>
            <dt class="col-sm-2">Comments</dt>
            <dd class="col-sm-10">@productissue.Comments</dd>
        </dl>
        <div>
            <a href="@($"/productissues/edit?id={productissue.Id}")">Edit</a> |
            <a href="@($"/productissues")">Back to List</a>
        </div>
    }
</div>

@code {
    private ProductIssue? productissue;

    [SupplyParameterFromQuery]
    private string Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        productissue = await context.ProductIssue.FirstOrDefaultAsync(m => m.Id == Id);

        if (productissue is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
