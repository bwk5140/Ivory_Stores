@page "/productissues/delete"
@using Microsoft.EntityFrameworkCore
@using MethaWebsite.Data
@inject IDbContextFactory<MethaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>ProductIssue</h2>
    <hr />
    @if (productissue is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Type</dt>
            <dd class="col-sm-10">@productissue.Type</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@productissue.Description</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Comments</dt>
            <dd class="col-sm-10">@productissue.Comments</dd>
        </dl>
        <EditForm method="post" Model="productissue" OnValidSubmit="DeleteProductIssue" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(productissue is null)">Delete</button> |
            <a href="/productissues">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private ProductIssue? productissue;

    [SupplyParameterFromQuery]
    private string Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        productissue = await context.ProductIssue.FirstOrDefaultAsync(m => m.Id == Id);

        if (productissue is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteProductIssue()
    {
        using var context = DbFactory.CreateDbContext();
        context.ProductIssue.Remove(productissue!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/productissues");
    }
}
