@code {
    
}

<nav aria-label="Page navigation">
    <ul class="pagination justify-content-center">
        <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
            <a class="page-link" @onclick="() => ChangePage(CurrentPage - 1)" style="cursor: pointer; width: fit-content;">Previous</a>
        </li>
        @if (pageNumbers is not null)
        {
            @foreach (var i in pageNumbers)
            {
                <li class="page-item @(CurrentPage == i ? "active" : "")">
                    <a class="page-link" @onclick="() => ChangePage(pageNumbers.IndexOf(i) + 1)" style="cursor: pointer;">
                        @i
                    </a>
                </li>
            }
        }
        

        <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
            <a class="page-link" @onclick="() => ChangePage(CurrentPage + 1)" style="cursor: pointer; width: fit-content;">Next</a>
        </li>
    </ul>
</nav>

@code {
    [Parameter] public EventCallback<int> OnPageChanged { get; set; }
    [Parameter] public int CurrentPage { get; set; }
    [Parameter] public int TotalPages { get; set; }
    [Parameter]
    public List<int>? pageNumbers { get; set; }

    protected override void OnInitialized()
    {
        pageNumbers = Enumerable.Range(1, TotalPages).ToList();
    }

    private async Task ChangePage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
            await OnPageChanged.InvokeAsync(page);
        }
    }
}