@using MethaWebsite.Services
@using MethaWebsite.Components.Account.Pages.ProductListPages

@inherits LayoutComponentBase
@layout MethaWebsite.Components.Layout.MainLayout

@inject LayoutState LayoutState
@inject StateChangeService StateChangeService
@inject IStringLocalizer<SharedResource> Loc
@inject LayoutRefreshService LayoutRefreshService

<div class="container-sm mt-5">
    <nav style="--bs-breadcrumb-divider: '>';" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="AccountSettings" style="text-decoration: none;">
                    @Loc["YourAccount"]
                </a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">@Loc["MessageCenter"]</li>
        </ol>
    </nav>
    <div class="row">
        <div class="col-lg-2">
            <MessagesNavMenu />
        </div>
        <div class="col-lg-10">
            @Body
        </div>
    </div>
</div>