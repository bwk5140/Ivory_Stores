@using MethaWebsite.Services
@inherits LayoutComponentBase
@layout MethaWebsite.Components.Layout.MainLayout

@inject StateChangeService StateChangeService
@inject IStringLocalizer<SharedResource> Loc

<div class="container-sm mt-5">
    <nav style="--bs-breadcrumb-divider: '>';" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="AccountSettings" style="text-decoration: none;">
                    @Loc["YourAccount"]
                </a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">@Loc["PaymentMethods"]</li>
        </ol>
    </nav>
    @if (HasStateChanged)
    {
        <div class="card mt-2 mb-2" style="border-color: green; max-width: 1200px;">
            <div class="card-body">
                <img src="check-circle-fill.svg" />
                @Loc["DefaultPaymentChanged"]
            </div>
        </div>
    }
    <h3>@Loc["PaymentMethods"]</h3>
    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-lg-3">
                    <PaymentsNavMenu />
                </div>
                <div class="col-lg-9">
                    @Body
                </div>
            </div>
        </div>
    </div>
</div>
@code{
    [Parameter]
    public bool HasStateChanged { get; set; } = false;
}