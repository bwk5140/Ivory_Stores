                                    <div class="col-sm-6" style="padding-bottom: 30px;">
                                        <a href="@($"product/details?id={product.Id}")">
                                            <img class="me-5 card-overlay-img" src="@(string.Format("data:image/jpg;base64,{0}", Convert.ToBase64String(imageSrc)))"
