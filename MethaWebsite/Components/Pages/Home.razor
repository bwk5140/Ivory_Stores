    [Parameter]
    public ApplicationUser? applicationUser { get; set; }

    [Parameter]
    public List<Product>? RecentlyViewed { get; set; } = new();

    [Parameter]
    public Dictionary<string, string> CarouselBackgroundColors { get; set; } = new();

    [Parameter]
    public Dictionary<string, string> CarouselBackgroundFadeColors { get; set; } = new();

    [Parameter]
    public Dictionary<string, string> CarouselItems { get; set; } = new();

    private List<string> CarouselImageSources { get; set; } = new();
    private string? activeCarouselItem { get; set; }

    protected override async Task OnInitializedAsync()
    {  
        LayoutState.SetBackground("bg-home");
        // CarouselBackgroundColors["WebsiteBanner.png"] = "#A66624";
        // CarouselBackgroundColors["WebsiteBanner2.png"] = "#7A4316";
        // CarouselBackgroundFadeColors["WebsiteBanner.png"] = "#d79c60";
        // CarouselBackgroundFadeColors["WebsiteBanner2.png"] = "#b7865e";
        // CarouselImageSources.Add("WebsiteBanner.png");
        // CarouselImageSources.Add("WebsiteBanner2.png");
        // CarouselItems["WebsiteBanner.png"] = "active";
        // CarouselItems["WebsiteBanner2.png"] = "inactive";
        // activeCarouselItem = "WebsiteBanner.png";
        applicationUser = await ApplicationUserService.GetApplicationUser();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        using var context = await DbFactory.CreateDbContextAsync();
        List<Click> clicks = new List<Click>();

        if (applicationUser is not null)
        {
            clicks = context.Click.Where(c => c.UserId == applicationUser.Id).OrderByDescending(c => c.Date).Take(4).ToList();
        }
        else
        {
            var consent = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "consent_analytics");
            if (consent == "true")
            {
                var Id = TrackingService.GetDeviceId();
                clicks = context.Click.Where(c => c.UserId == Id).OrderByDescending(c => c.Date).Take(4).ToList();
            }
        }
        var productIds = clicks.Select(c => c.ProductId).ToList();
        RecentlyViewed = context.Product.Where(p => productIds.Contains(p.Id)).ToList();
        StateHasChanged();
    }
    private void OnSignInClicked()
    {
        NavigationManager.NavigateTo("Account/Login", true);
    }
